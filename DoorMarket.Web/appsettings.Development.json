{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Components.Server": "Debug"
    }
  },
  "Api": {
    "BaseUrl": "http://api.door-market.com/"
  },
  "ApiBaseUrl": "http://api.door-market.com/"
  ,
  "EnableMediaProxy": true,
  "MediaProxy": {
    "Enabled": true,
    "TimeoutSeconds": 15,
    "RetryCount": 2,
    "MaxBytes": 8388608
  }
}
