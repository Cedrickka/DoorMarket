@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-1">Creer un utilisateur</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Admin, Shop ou Client.</MudText>

        <MudTextField T="string" Label="Email" Variant="Variant.Outlined" @bind-Value="_model.Email" />
        <MudTextField T="string" Label="Mot de passe" Variant="Variant.Outlined" InputType="InputType.Password" Class="mt-2" @bind-Value="_model.Password" />
        <MudTextField T="string" Label="Telephone" Variant="Variant.Outlined" Class="mt-2" @bind-Value="_model.Phone" />
        <MudSelect T="string" Label="Role" Variant="Variant.Outlined" Class="mt-2" @bind-Value="_model.Role">
            <MudSelectItem Value="@("Shop")">Shop</MudSelectItem>
            <MudSelectItem Value="@("Admin")">Admin</MudSelectItem>
            <MudSelectItem Value="@("Client")">Client</MudSelectItem>
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">Annuler</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Creer</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private CreateUserModel _model = new();

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(_model.Email) || string.IsNullOrWhiteSpace(_model.Password))
        {
            return;
        }

        if (_model.Password.Trim().Length < 6)
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(_model));
    }

    private void Cancel() => MudDialog.Cancel();

    public sealed class CreateUserModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string? Phone { get; set; }
        public string Role { get; set; } = "Shop";
    }
}

