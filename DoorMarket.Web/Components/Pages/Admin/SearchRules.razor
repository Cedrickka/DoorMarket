    private Color EffectivenessColor(string performance)
    {
        if (string.Equals(performance, "Good", StringComparison.OrdinalIgnoreCase))
        {
            return Color.Success;
        }

        if (string.Equals(performance, "Watch", StringComparison.OrdinalIgnoreCase))
        {
            return Color.Warning;
        }

        if (string.Equals(performance, "NeedsAttention", StringComparison.OrdinalIgnoreCase))
        {
            return Color.Error;
        }

        if (string.Equals(performance, "Critical", StringComparison.OrdinalIgnoreCase))
        {
            return Color.Error;
        }

        return Color.Default;
    }

    private string T(string fr, string en)
        => IsEn ? en : fr;

    private bool IsEn
        => string.Equals(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, "en", StringComparison.OrdinalIgnoreCase);

    private sealed class SearchRuleForm
    {
        public string TriggerQuery { get; set; } = string.Empty;
        public string CanonicalQuery { get; set; } = string.Empty;
        public string TargetType { get; set; } = string.Empty;
        public string TargetIdRaw { get; set; } = string.Empty;
        public bool IsActive { get; set; } = true;
        public string Note { get; set; } = string.Empty;

        public UpsertSearchRuleRequest ToRequest()
        {
            Guid? targetId = null;
            if (Guid.TryParse(TargetIdRaw?.Trim(), out var parsed) && parsed != Guid.Empty)
            {
                targetId = parsed;
            }

            return new UpsertSearchRuleRequest(
                TriggerQuery.Trim(),
                string.IsNullOrWhiteSpace(CanonicalQuery) ? null : CanonicalQuery.Trim(),
                string.IsNullOrWhiteSpace(TargetType) ? null : TargetType.Trim(),
                targetId,
                IsActive,
                string.IsNullOrWhiteSpace(Note) ? null : Note.Trim());
        }
    }

