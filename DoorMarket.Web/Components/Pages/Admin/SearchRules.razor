    private async Task ExportEffectivenessCsvAsync()
    {
        _exportingEffectiveness = true;
        try
        {
            var query = BuildEffectivenessQuery();
            var url = $"api/admin/search-rules/effectiveness/export.csv{query}&_={DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}";
            var response = await Http.GetAsync(url);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add(string.IsNullOrWhiteSpace(body) ? T("Export impossible.", "Export failed.") : body, Severity.Error);
                return;
            }

            var csv = await response.Content.ReadAsStringAsync();
            var fileName = $"search-rules-effectiveness-{DateTime.UtcNow:yyyyMMdd-HHmmss}.csv";
            await JS.InvokeVoidAsync("doorMarket.downloadText", fileName, "text/csv; charset=utf-8", csv);
            Snackbar.Add(T("Export CSV genere.", "CSV export generated."), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _exportingEffectiveness = false;
        }
    }

    private string BuildEffectivenessQuery()
    {
        var parts = new List<string>();
        if (_effectivenessFrom.HasValue)
        {
            parts.Add($"from={Uri.EscapeDataString(_effectivenessFrom.Value.ToString("yyyy-MM-dd"))}");
        }

        if (_effectivenessTo.HasValue)
        {
            parts.Add($"to={Uri.EscapeDataString(_effectivenessTo.Value.ToString("yyyy-MM-dd"))}");
        }

        if (!string.IsNullOrWhiteSpace(_effectivenessSource))
        {
            parts.Add($"source={Uri.EscapeDataString(_effectivenessSource.Trim())}");
        }

        if (!string.IsNullOrWhiteSpace(_q))
        {
            parts.Add($"q={Uri.EscapeDataString(_q.Trim())}");
        }

        if (string.Equals(_activeFilter, "active", StringComparison.OrdinalIgnoreCase))
        {
            parts.Add("active=true");
        }
        else if (string.Equals(_activeFilter, "inactive", StringComparison.OrdinalIgnoreCase))
        {
            parts.Add("active=false");
        }

        parts.Add($"take={Math.Clamp(_effectivenessTake, 1, 300)}");
        parts.Add($"problemOnly={_effectivenessProblemOnly.ToString().ToLowerInvariant()}");
        parts.Add($"minQueries={Math.Clamp(_effectivenessMinQueries, 1, 5000)}");
        return "?" + string.Join("&", parts);
    }

