    private string BuildSuggestionsQuery()
    {
        var parts = new List<string>();
        if (_suggestionsFrom.HasValue)
        {
            parts.Add($"from={Uri.EscapeDataString(_suggestionsFrom.Value.ToString("yyyy-MM-dd"))}");
        }

        if (_suggestionsTo.HasValue)
        {
            parts.Add($"to={Uri.EscapeDataString(_suggestionsTo.Value.ToString("yyyy-MM-dd"))}");
        }

        if (!string.IsNullOrWhiteSpace(_suggestionsSource))
        {
            parts.Add($"source={Uri.EscapeDataString(_suggestionsSource.Trim())}");
        }

        var boundedTake = Math.Clamp(_suggestionsTake, 1, 100);
        parts.Add($"take={boundedTake}");

        return "?" + string.Join("&", parts);
    }

    private async Task ApplySuggestionAsync(SearchRuleSuggestionDto suggestion)
    {
        _applyingSuggestion = true;
        try
        {
            var request = new UpsertSearchRuleRequest(
                suggestion.TriggerQuery,
                suggestion.SuggestedCanonicalQuery,
                suggestion.TargetType,
                suggestion.TargetId,
                true,
                $"Auto-suggestion ({suggestion.Confidence}, score={suggestion.Score})");

            var response = await Http.PostAsJsonAsync("api/admin/search-rules", request);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add(string.IsNullOrWhiteSpace(body) ? T("Application impossible.", "Apply failed.") : body, Severity.Error);
                return;
            }

            Snackbar.Add(T("Suggestion appliquee.", "Suggestion applied."), Severity.Success);
            await LoadAsync();
            await LoadSuggestionsAsync();
            await LoadEffectivenessAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _applyingSuggestion = false;
        }
    }

    private async Task ApplyFilteredSuggestionsAsync()
