            var payload = await res.Content.ReadFromJsonAsync<MarketingAutomationResultRow>();
            var disabled = payload?.DisabledExpired ?? 0;
            var reprio = payload?.ReprioritizedLive ?? 0;
            Snackbar.Add(
                Tr($"Automatisation terminee: {disabled} expires desactives, {reprio} actifs repriorises.", $"Automation done: {disabled} expired disabled, {reprio} live reprioritized."),
                Severity.Success);

