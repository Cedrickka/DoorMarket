    private string BuildCampaignRangeQuery(bool includeGranularity = false)
    {
        var list = new List<string>();
        if (_campaignFrom.HasValue) list.Add($"from={Uri.EscapeDataString(_campaignFrom.Value.ToString("yyyy-MM-dd"))}");
        if (_campaignTo.HasValue) list.Add($"to={Uri.EscapeDataString(_campaignTo.Value.ToString("yyyy-MM-dd"))}");
        if (!string.IsNullOrWhiteSpace(_campaignQ)) list.Add($"q={Uri.EscapeDataString(_campaignQ.Trim())}");
        if (!string.IsNullOrWhiteSpace(_campaignStatusFilter)) list.Add($"status={Uri.EscapeDataString(_campaignStatusFilter.Trim())}");
        if (_campaignSegmentId.HasValue && _campaignSegmentId.Value != Guid.Empty) list.Add($"segmentId={_campaignSegmentId.Value}");
        if (!string.IsNullOrWhiteSpace(_campaignChannelFilter)) list.Add($"channel={Uri.EscapeDataString(_campaignChannelFilter.Trim())}");
        if (_campaignMinSent.HasValue && _campaignMinSent.Value > 0) list.Add($"minSent={_campaignMinSent.Value}");
        if (_campaignMinRoi.HasValue) list.Add($"minRoi={Uri.EscapeDataString(_campaignMinRoi.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))}");
        if (includeGranularity && !string.IsNullOrWhiteSpace(_campaignTimeSeriesGranularity))
        {
            list.Add($"granularity={Uri.EscapeDataString(_campaignTimeSeriesGranularity.Trim())}");
        }
        return list.Count == 0 ? string.Empty : string.Join("&", list);
    }

    private async Task LoadCampaignAnalyticsAsync(bool inlineRefresh = false)
    {
        _campaignError = null;
        if (!inlineRefresh)
        {
            _campaignBusy = true;
        }

        try
        {
            var query = BuildCampaignRangeQuery();
            var timeseriesQuery = BuildCampaignRangeQuery(includeGranularity: true);
            var campaignsUrl = string.IsNullOrWhiteSpace(query)
                ? "api/admin/marketing/campaigns?page=1&pageSize=100"
                : $"api/admin/marketing/campaigns?page=1&pageSize=100&{query}";
            var summaryUrl = string.IsNullOrWhiteSpace(query)
                ? "api/admin/marketing/campaigns/summary"
                : $"api/admin/marketing/campaigns/summary?{query}";
            var roiUrl = string.IsNullOrWhiteSpace(query)
                ? "api/admin/marketing/campaigns/roi?page=1&pageSize=100"
                : $"api/admin/marketing/campaigns/roi?page=1&pageSize=100&{query}";
            var cohortsUrl = string.IsNullOrWhiteSpace(query)
                ? "api/admin/marketing/campaigns/cohorts"
                : $"api/admin/marketing/campaigns/cohorts?{query}";
            var timeseriesUrl = string.IsNullOrWhiteSpace(timeseriesQuery)
                ? "api/admin/marketing/campaigns/timeseries?granularity=day"
                : $"api/admin/marketing/campaigns/timeseries?{timeseriesQuery}";
            var experimentsUrl = string.IsNullOrWhiteSpace(query)
                ? "api/admin/marketing/campaigns/experiments"
                : $"api/admin/marketing/campaigns/experiments?{query}";
            var insightsUrl = string.IsNullOrWhiteSpace(query)
                ? "api/admin/marketing/campaigns/experiments/insights"
                : $"api/admin/marketing/campaigns/experiments/insights?{query}";

            var campaigns = await Http.GetFromJsonAsync<CampaignPaged>(campaignsUrl);
            _campaigns = campaigns?.Items ?? new();

            _campaignSummary = await Http.GetFromJsonAsync<CampaignSummaryRow>(summaryUrl);

            var roi = await Http.GetFromJsonAsync<CampaignRoiPaged>(roiUrl);
            _campaignRoiRows = roi?.Items ?? new();

            _campaignCohorts = await Http.GetFromJsonAsync<List<CampaignCohortRow>>(cohortsUrl) ?? new();

            var timeseries = await Http.GetFromJsonAsync<CampaignTimeSeriesRow>(timeseriesUrl);
            _campaignTimeSeries = timeseries?.Points ?? new();

            _campaignExperiments = await Http.GetFromJsonAsync<List<CampaignExperimentRow>>(experimentsUrl) ?? new();
            _campaignExperimentInsights = await Http.GetFromJsonAsync<CampaignExperimentInsightsRow>(insightsUrl);
        }
        catch (Exception ex)
        {
            _campaignError = ex.Message;
            _campaigns = new();
            _campaignRoiRows = new();
            _campaignCohorts = new();
            _campaignTimeSeries = new();
            _campaignExperiments = new();
            _campaignExperimentInsights = null;
            _campaignSummary = null;
        }
        finally
        {
            if (!inlineRefresh)
            {
                _campaignBusy = false;
            }
        }
    }

