    private decimal CampaignDeliverySuccessRate
    {
        get
        {
            if (_campaignSummary is null)
            {
                return 0m;
            }

            var totalAttempts = _campaignSummary.SentCount + _campaignSummary.FailedCount;
            if (totalAttempts <= 0)
            {
                return 0m;
            }

            return decimal.Round((decimal)_campaignSummary.SentCount * 100m / totalAttempts, 2, MidpointRounding.AwayFromZero);
        }
    }

    private decimal CampaignAverageRevenuePerSent
        => _campaignSummary is not { SentCount: > 0 }
            ? 0m
            : decimal.Round(_campaignSummary.RevenueAttributed / _campaignSummary.SentCount, 4, MidpointRounding.AwayFromZero);

    private decimal CampaignAverageCostPerSent
        => _campaignSummary is not { SentCount: > 0 }
            ? 0m
            : decimal.Round(_campaignSummary.DiscountCost / _campaignSummary.SentCount, 4, MidpointRounding.AwayFromZero);

    private List<CampaignRoiRow> TopRoiCampaigns
        => _campaignRoiRows
            .Where(x => x.SentCount > 0)
            .OrderByDescending(x => x.RoiPercent)
            .ThenByDescending(x => x.RevenueAttributed)
            .ThenBy(x => x.CampaignName)
            .Take(5)
            .ToList();

    private List<CampaignRoiRow> LowRoiCampaigns
        => _campaignRoiRows
            .Where(x => x.SentCount > 0)
            .OrderBy(x => x.RoiPercent)
            .ThenByDescending(x => x.SentCount)
            .ThenBy(x => x.CampaignName)
            .Take(5)
            .ToList();

    private string CampaignRoiTrendLabel
    {
        get
        {
            var ordered = _campaignTimeSeries
                .OrderBy(x => x.PeriodStartUtc)
                .ToList();
            if (ordered.Count < 2)
            {
                return Tr("N/D", "N/A");
            }

            var delta = decimal.Round(
                ordered[^1].RoiPercent - ordered[^2].RoiPercent,
                2,
                MidpointRounding.AwayFromZero);

            if (delta > 0m)
            {
                return $"+{Fmt(delta)} {Tr("pts", "pts")}";
            }

            if (delta < 0m)
            {
                return $"{Fmt(delta)} {Tr("pts", "pts")}";
            }

            return Tr("Stable", "Flat");
        }
    }

