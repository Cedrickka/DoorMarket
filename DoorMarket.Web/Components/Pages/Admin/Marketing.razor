    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        while (!Auth.IsReady)
        {
            await Task.Delay(30);
        }

        _ready = true;
        if (!Auth.IsAuthenticated || !Auth.IsAdmin)
        {
            StateHasChanged();
            return;
        }

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        var query = BuildAdminMarketingQuery();
        try
        {
            try
            {
                var listUrl = string.IsNullOrWhiteSpace(query)
                    ? "api/admin/marketing/banners?page=1&pageSize=100"
                    : $"api/admin/marketing/banners?page=1&pageSize=100&{query}";
                var summaryUrl = string.IsNullOrWhiteSpace(query)
                    ? "api/admin/marketing/banners/summary"
                    : $"api/admin/marketing/banners/summary?{query}";

                var res = await Http.GetFromJsonAsync<AdminMarketingPaged>(listUrl);
                _items = res?.Items ?? new();
                _summary = await Http.GetFromJsonAsync<MarketingSummaryRow>(summaryUrl);
            }
            catch (Exception ex)
            {
                _error = ex.Message;
                _items = new();
                _summary = null;
            }

            try
            {
                var cats = await Http.GetFromJsonAsync<List<CategoryDto>>("api/categories") ?? new();
                _categories = cats.OrderBy(c => c.Name).ToList();
            }
            catch (Exception ex)
            {
                _error = AppendError(_error, $"{Tr("Categories", "Categories")}: {ex.Message}");
                _categories = new();
            }

            try
            {
                var shops = await Http.GetFromJsonAsync<PublicShopPaged>(
                    "api/shops?page=1&pageSize=100")
                    ?? new PublicShopPaged(new List<ShopLookupDto>(), 0, 1, 100);
                _shops = (shops.Items ?? new()).OrderBy(s => s.Name).ToList();
            }
            catch (Exception ex)
            {
                _error = AppendError(_error, $"{Tr("Boutiques", "Shops")}: {ex.Message}");
                _shops = new();
            }

            try
            {
                _campaignSegments = await Http.GetFromJsonAsync<List<CampaignSegmentRow>>("api/admin/marketing/segments")
                    ?? new();
            }
            catch (Exception ex)
            {
                _error = AppendError(_error, $"{Tr("Segments campagne", "Campaign segments")}: {ex.Message}");
                _campaignSegments = new();
            }

            await LoadCampaignAnalyticsAsync(inlineRefresh: true);
            await LoadRfmInsightsAsync(inlineRefresh: true);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string AppendError(string? current, string next)
        => string.IsNullOrWhiteSpace(current) ? next : $"{current} | {next}";

    private string BuildAdminMarketingQuery()
    {
        var list = new List<string>();
        if (!string.IsNullOrWhiteSpace(_q)) list.Add($"q={Uri.EscapeDataString(_q.Trim())}");
        if (!string.IsNullOrWhiteSpace(_statusFilter)) list.Add($"status={Uri.EscapeDataString(_statusFilter.Trim())}");
        return list.Count == 0 ? string.Empty : string.Join("&", list);
    }

