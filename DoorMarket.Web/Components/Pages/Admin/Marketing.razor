    private async Task RunAutomationAsync()
    {
        _saving = true;
        try
        {
            var res = await Http.PostAsJsonAsync(
                "api/admin/marketing/automation/run",
                new
                {
                    disableExpired = true,
                    autoPrioritizeLiveByCtr = true,
                    minImpressionsForCtr = 100
