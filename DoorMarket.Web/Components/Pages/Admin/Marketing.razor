    private string BuildPeriod(MarketingBannerRow row)
    {
        var start = row.StartAtUtc?.ToString("yyyy-MM-dd") ?? "-";
        var end = row.EndAtUtc?.ToString("yyyy-MM-dd") ?? "-";
        return $"{start} -> {end}";
    }

    private string BuildTargeting(MarketingBannerRow row)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(row.Language)) parts.Add(row.Language!.ToUpperInvariant());
        if (!string.IsNullOrWhiteSpace(row.City)) parts.Add(row.City!);
        if (!string.IsNullOrWhiteSpace(row.Zone)) parts.Add(row.Zone!);
        if (row.CategoryId.HasValue)
        {
            var cat = _categories.FirstOrDefault(c => c.Id == row.CategoryId.Value);
            parts.Add(cat is null ? $"{Tr("Categorie", "Category")}:{row.CategoryId}" : $"{Tr("Categorie", "Category")}:{cat.Name}");
        }
        if (row.ShopId.HasValue)
        {
            var shop = _shops.FirstOrDefault(s => s.Id == row.ShopId.Value);
            parts.Add(shop is null ? $"{Tr("Boutique", "Shop")}:{row.ShopId}" : $"{Tr("Boutique", "Shop")}:{shop.Name}");
        }
        return parts.Count == 0 ? "-" : string.Join(" - ", parts);
    }

    private string ResolveStatus(MarketingBannerRow row)
    {
        var now = DateTime.UtcNow;
        if (!row.IsActive)
        {
            return "Inactive";
        }

        if (row.StartAtUtc.HasValue && row.StartAtUtc.Value > now)
        {
            return "Planned";
        }

        if (row.EndAtUtc.HasValue && row.EndAtUtc.Value <= now)
        {
            return "Expired";
        }

        return "Live";
    }

    private string ResolveStatusLabel(MarketingBannerRow row)
    {
        return ResolveStatus(row) switch
        {
            "Live" => Tr("Actif", "Live"),
            "Planned" => Tr("Planifie", "Planned"),
            "Expired" => Tr("Expire", "Expired"),
            _ => Tr("Inactif", "Inactive")
        };
    }

    private string GetStatusBadgeCss(MarketingBannerRow row)
    {
        return ResolveStatus(row) switch
        {
            "Live" => "dm-status-badge dm-status-badge-live",
            "Planned" => "dm-status-badge dm-status-badge-planned",
            "Expired" => "dm-status-badge dm-status-badge-expired",
            _ => "dm-status-badge dm-status-badge-inactive"
        };
    }

    private static decimal Ctr(MarketingBannerRow row)
    {
        if (row.Impressions <= 0)
        {
            return 0m;
        }

        return decimal.Round((decimal)row.Clicks * 100m / row.Impressions, 2, MidpointRounding.AwayFromZero);
    }

    private async Task<Exception> BuildApiError(HttpResponseMessage res)
    {
        var body = await res.Content.ReadAsStringAsync();
        return res.StatusCode switch
        {
            HttpStatusCode.Unauthorized => new InvalidOperationException(SL["Non autorise (401)."]),
            HttpStatusCode.Forbidden => new InvalidOperationException(SL["Acces refuse (403). Admin requis."]),
            HttpStatusCode.NotFound => new InvalidOperationException(SL["Route introuvable (404)."]),
            HttpStatusCode.Conflict => new InvalidOperationException(string.IsNullOrWhiteSpace(body) ? SL["Conflit (409)."] : body),
            _ => new InvalidOperationException($"{SL["Erreur API"]} ({(int)res.StatusCode}) : {body}")
        };
    }

    private sealed class BannerFormModel
    {
        public string Title { get; set; } = "";
        public string? Subtitle { get; set; }
        public string? ImageUrl { get; set; }
        public string? TargetUrl { get; set; }
        public string? Language { get; set; }
        public string? City { get; set; }
        public string? Zone { get; set; }
        public Guid? CategoryId { get; set; }
        public Guid? ShopId { get; set; }
        public DateTime? StartAtUtc { get; set; }
        public DateTime? EndAtUtc { get; set; }
        public int SortOrder { get; set; }
        public bool IsActive { get; set; } = true;

        public BannerWrite ToRequest()
        {
            return new BannerWrite(
                Title.Trim(),
                string.IsNullOrWhiteSpace(Subtitle) ? null : Subtitle.Trim(),
                string.IsNullOrWhiteSpace(ImageUrl) ? null : ImageUrl.Trim(),
                string.IsNullOrWhiteSpace(TargetUrl) ? null : TargetUrl.Trim(),
                IsActive,
                StartAtUtc,
                EndAtUtc,
                string.IsNullOrWhiteSpace(Language) ? null : Language.Trim(),
                string.IsNullOrWhiteSpace(City) ? null : City.Trim(),
                string.IsNullOrWhiteSpace(Zone) ? null : Zone.Trim(),
                CategoryId,
                ShopId,
                SortOrder
            );
        }

        public static BannerFormModel From(MarketingBannerRow row)
        {
            return new BannerFormModel
            {
                Title = row.Title,
                Subtitle = row.Subtitle,
                ImageUrl = row.ImageUrl,
                TargetUrl = row.TargetUrl,
                Language = row.Language,
                City = row.City,
                Zone = row.Zone,
                CategoryId = row.CategoryId,
                ShopId = row.ShopId,
                StartAtUtc = row.StartAtUtc,
                EndAtUtc = row.EndAtUtc,
                SortOrder = row.SortOrder,
                IsActive = row.IsActive
            };
        }
    }

