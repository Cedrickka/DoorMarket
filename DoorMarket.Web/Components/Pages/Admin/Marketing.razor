    private async Task SaveAsync()
    {
        if (_model.StartAtUtc.HasValue && _model.EndAtUtc.HasValue && _model.StartAtUtc > _model.EndAtUtc)
        {
            Snackbar.Add(Tr("La date de debut doit etre inferieure ou egale a la date de fin.", "Start date must be before or equal to end date."), Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var request = _model.ToRequest();
            HttpResponseMessage res;
            if (_editingId is null)
            {
                res = await Http.PostAsJsonAsync("api/admin/marketing/banners", request);
            }
            else
            {
                res = await Http.PutAsJsonAsync($"api/admin/marketing/banners/{_editingId.Value}", request);
            }

            if (!res.IsSuccessStatusCode)
            {
                throw await BuildApiError(res);
            }

            ResetForm();
            Snackbar.Add(SL["Saved"], Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

