@page "/admin/users"
@using System.Net
@using System.Net.Http.Json
@using MudBlazor
@inject HttpClient Http
@inject DoorMarket.Web.Auth.AuthState Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject IJSRuntime JS

<h1 class="dm-page-h1">@SL["Users"]</h1>
<div class="dm-page-sub">@SL["UsersSubtitle"]</div>

<AuthGuard>
    @if (!_ready)
    {
        <MudPaper Class="pa-4 mt-3">
            <MudSkeleton Height="32px" Width="220px" Class="mb-2" />
            <MudSkeleton Height="18px" Width="380px" />
        </MudPaper>
    }
    else if (!Auth.IsAdmin)
    {
        <MudPaper Class="pa-4 mt-3">
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@SL["AdminOnlyAccess"]</MudAlert>
            <MudButton Variant="Variant.Outlined" Class="mt-3" OnClick="@(() => Nav.NavigateTo("/shop/dashboard"))">@SL["Back"]</MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4 mt-3 dm-content-card">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <MudText Typo="Typo.h6" Class="mb-1">@SL["UsersList"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@SL["TotalLabel"] @_total</MudText>
                </div>

                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <MudTextField T="string"
                                  Variant="Variant.Outlined"
                                  Placeholder="@SL["EmailPhonePlaceholder"]"
                                  Dense="true"
                                  Immediate="true"
                                  DebounceInterval="350"
                                  Value="@_q"
                                  ValueChanged="@(async (string v) => await OnSearchChanged(v))" />

                    <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OpenCreateDialog">
                        @SL["CreateUser"]
                    </MudButton>

                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Default"
                                   OnClick="Reload"
                                   Disabled="_loading" />

                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ExportCsv">
                        @SL["ExportCsv"]
                    </MudButton>
                </div>
            </div>

            <MudDivider Class="my-3" />

            @if (_loading)
            {
                <MudSkeleton Height="42px" />
                <MudSkeleton Height="42px" Class="mt-2" />
                <MudSkeleton Height="42px" Class="mt-2" />
            }
            else if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
            }
            else if (_items.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@SL["NoUsers"]</MudAlert>
            }
            else
            {
                <MudTable T="AdminUserRow" Items="_items" Dense="true" Hover="true" Bordered="true" Striped="true">
                    <HeaderContent>
                        <MudTh>@SL["User"]</MudTh>
                        <MudTh>@SL["Role"]</MudTh>
                        <MudTh>@SL["Active"]</MudTh>
                        <MudTh Align="Align.Right">@SL["Actions"]</MudTh>
                    </HeaderContent>

                    <RowTemplate Context="u">
                        <MudTd>
                            <div style="font-weight:800;">@((u.Email ?? "-"))</div>
                            <div class="dm-muted">ID: @u.Id.ToString().Substring(0, 8)... - @u.Phone</div>
                        </MudTd>
                        <MudTd>@u.Role</MudTd>
                        <MudTd>
                            <MudChip T="string" Variant="Variant.Filled" Color="@(u.IsActive ? Color.Success : Color.Error)" Label="true">
                                @(u.IsActive ? SL["Oui"] : SL["Non"])
                            </MudChip>
                        </MudTd>
                        <MudTd Align="Align.Right">
                            <AdminRowActionMenu Disabled="_saving" AriaLabel="@SL["Actions"]">
                                @if (Auth.IsSuperAdmin)
                                {
                                    <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                                 OnClick="@(() => OpenEditDialog(u))">
                                        @SL["Edit"]
                                    </MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                                 OnClick="@(() => DeleteUser(u))">
                                        @SL["Delete"]
                                    </MudMenuItem>
                                }
                                <MudMenuItem Icon="@Icons.Material.Filled.ContentCopy"
                                             OnClick="@(() => CopyAsync(u.Email ?? ""))">
                                    @SL["CopyEmail"]
                                </MudMenuItem>
                            </AdminRowActionMenu>
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                    <div class="dm-muted">@SL["PageLabel"] @_page / @TotalPages()</div>
                    <DmPager CurrentPage="_page" TotalPages="TotalPages()" OnPageChanged="OnPageChanged" />
                </div>
            }
        </MudPaper>
    }
</AuthGuard>

@code {
    private bool _ready;
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private int _page = 1;
    private int _pageSize = 20;
    private int _total;
    private string _q = string.Empty;
    private List<AdminUserRow> _items = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var t0 = DateTime.UtcNow;
        while (!Auth.IsReady && (DateTime.UtcNow - t0).TotalSeconds < 5)
            await Task.Delay(30);

        _ready = true;
        if (!Auth.IsAuthenticated || !Auth.IsAdmin)
        {
            StateHasChanged();
            return;
        }

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var url = $"api/admin/users?page={_page}&pageSize={_pageSize}&q={Uri.EscapeDataString(_q ?? "")}";
            var res = await Http.GetFromJsonAsync<AdminUsersPaged>(url);
            _items = res?.Items ?? new();
            _total = res?.Total ?? 0;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _items = new();
            _total = 0;
        }
        finally
        {
            _loading = false;
        }
    }

    private int TotalPages() => Math.Max(1, (int)Math.Ceiling(_total / (double)_pageSize));

    private async Task OnSearchChanged(string value)
    {
        _q = value ?? "";
        _page = 1;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task Reload()
    {
        _page = 1;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task OnPageChanged(int page)
    {
        _page = Math.Clamp(page, 1, TotalPages());
        await LoadAsync();
        StateHasChanged();
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await Dialog.ShowAsync<DoorMarket.Web.Components.AdminUserCreateDialog>(SL["Creer un utilisateur"], options);
        var result = await dialog.Result;
        if (result is { Canceled: true } || result?.Data is not DoorMarket.Web.Components.AdminUserCreateDialog.CreateUserModel model)
            return;

        _saving = true;
        try
        {
            var req = new CreateUserRequest(model.Email.Trim(), model.Password, string.IsNullOrWhiteSpace(model.Phone) ? null : model.Phone.Trim(), model.Role);
            var res = await Http.PostAsJsonAsync("api/admin/users", req);
            if (!res.IsSuccessStatusCode)
                throw await BuildApiError(res);

            Snackbar.Add(string.Format(SL["Utilisateur cree ({0})."], model.Role), Severity.Success);
            await Reload();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task OpenEditDialog(AdminUserRow user)
    {
        var parameters = new DialogParameters<DoorMarket.Web.Components.AdminUserEditDialog>
        {
            { x => x.Model, new DoorMarket.Web.Components.AdminUserEditDialog.EditUserModel
                {
                    Id = user.Id,
                    Email = user.Email ?? string.Empty,
                    Phone = user.Phone,
                    Role = user.Role,
                    IsActive = user.IsActive
                }
            }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await Dialog.ShowAsync<DoorMarket.Web.Components.AdminUserEditDialog>(SL["Modifier utilisateur"], parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: true } || result?.Data is not DoorMarket.Web.Components.AdminUserEditDialog.EditUserModel model)
            return;

        _saving = true;
        try
        {
            var req = new UpdateUserRequest(model.Phone, model.Role, model.IsActive);
            var updateRes = await Http.PutAsJsonAsync($"api/admin/users/{model.Id}", req);
            if (!updateRes.IsSuccessStatusCode)
                throw await BuildApiError(updateRes);

            if (!string.IsNullOrWhiteSpace(model.NewPassword))
            {
                var passMsg = new HttpRequestMessage(HttpMethod.Patch, $"api/admin/users/{model.Id}/password")
                {
                    Content = JsonContent.Create(new ChangeUserPasswordRequest(model.NewPassword.Trim()))
                };
                var passRes = await Http.SendAsync(passMsg);
                if (!passRes.IsSuccessStatusCode)
                    throw await BuildApiError(passRes);
            }

            Snackbar.Add(SL["Utilisateur mis a jour."], Severity.Success);
            await Reload();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteUser(AdminUserRow user)
    {
        var confirm = await Dialog.ShowMessageBox(
            title: SL["Supprimer utilisateur"],
            markupMessage: (MarkupString)$"{SL["Supprimer"]} <b>{WebUtility.HtmlEncode(user.Email)}</b> ?",
            yesText: SL["Supprimer"],
            cancelText: SL["Annuler"]);

        if (confirm != true)
            return;

        _saving = true;
        try
        {
            var res = await Http.DeleteAsync($"api/admin/users/{user.Id}");
            if (!res.IsSuccessStatusCode)
                throw await BuildApiError(res);

            Snackbar.Add(SL["Utilisateur supprime."], Severity.Success);
            await Reload();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ExportCsv()
    {
        try
        {
            var url = $"api/admin/users/export.csv?q={Uri.EscapeDataString(_q ?? "")}&_={DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}";
            var res = await Http.GetAsync(url);
            if (!res.IsSuccessStatusCode)
                throw await BuildApiError(res);

            var csv = await res.Content.ReadAsStringAsync();
            var fileName = $"users-{DateTime.UtcNow:yyyyMMdd-HHmmss}.csv";
            await JS.InvokeVoidAsync("doorMarket.downloadText", fileName, "text/csv; charset=utf-8", csv);
            Snackbar.Add(SL["Export CSV genere."], Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task CopyAsync(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            Snackbar.Add(SL["Rien a copier."], Severity.Info);
            return;
        }

        try
        {
            var copied = await JS.InvokeAsync<bool>("doorMarket.copyText", text);
            Snackbar.Add(copied ? SL["Email copie."] : SL["Copie impossible."], copied ? Severity.Success : Severity.Warning);
        }
        catch
        {
            Snackbar.Add($"{SL["Email"]} : {text}", Severity.Info);
        }
    }

    private async Task<Exception> BuildApiError(HttpResponseMessage res)
    {
        var body = await res.Content.ReadAsStringAsync();
        return res.StatusCode switch
        {
            HttpStatusCode.Unauthorized => new InvalidOperationException(SL["Non autorise (401)."]),
            HttpStatusCode.Forbidden => new InvalidOperationException(SL["Acces refuse (403). Admin requis."]),
            HttpStatusCode.NotFound => new InvalidOperationException(SL["Route introuvable (404)."]),
            HttpStatusCode.Conflict => new InvalidOperationException(string.IsNullOrWhiteSpace(body) ? SL["Conflit (409)."] : body),
            _ => new InvalidOperationException($"{SL["Erreur API"]} ({(int)res.StatusCode}) : {body}")
        };
    }

    private sealed record CreateUserRequest(string Email, string Password, string? Phone, string Role);
    private sealed record UpdateUserRequest(string? Phone, string Role, bool IsActive);
    private sealed record ChangeUserPasswordRequest(string NewPassword);

    public record AdminUserRow(Guid Id, string? Email, string? Phone, string Role, bool IsActive, DateTime CreatedAtUtc);
    public record AdminUsersPaged(List<AdminUserRow> Items, int Total, int Page, int PageSize);
}

