@page "/admin/shops"
@using System.Net
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using DoorMarket.Web.Models
@inject HttpClient Http
@inject DoorMarket.Web.Auth.AuthState Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<h1 class="dm-page-h1">@SL["Shops"]</h1>
<div class="dm-page-sub">@SL["AdminShopsSubtitle"]</div>

<AuthGuard>
    @if (!_ready)
    {
        <MudPaper Class="pa-4 mt-3">
            <MudSkeleton Height="32px" Width="220px" Class="mb-2" />
            <MudSkeleton Height="18px" Width="380px" />
            <MudSkeleton Height="18px" Width="300px" />
        </MudPaper>
    }
    else if (!Auth.IsAdmin)
    {
        <MudPaper Class="pa-4 mt-3">
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@SL["AdminOnlyAccess"]</MudAlert>
            <MudButton Variant="Variant.Outlined" Class="mt-3" OnClick="@(() => Nav.NavigateTo("/"))">
                @SL["Back"]
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4 mt-3 dm-content-card">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <MudText Typo="Typo.h6" Class="mb-1">@SL["ShopsList"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@SL["TotalLabel"] @_total</MudText>
                </div>

                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <MudTextField T="string"
                                  Variant="Variant.Outlined"
                                  Placeholder="@SL["SearchShopPlaceholder"]"
                                  Dense="true"
                                  Immediate="true"
                                  DebounceInterval="350"
                                  Value="_q"
                                  ValueChanged="OnSearchChanged" />

                    <MudTextField T="string"
                                  Variant="Variant.Outlined"
                                  Placeholder="@SL["CountryFilterPlaceholder"]"
                                  Dense="true"
                                  Immediate="true"
                                  DebounceInterval="350"
                                  Value="_countryTag"
                                  ValueChanged="OnCountryChanged" />

                    <MudCheckBox T="bool"
                                 Checked="@_verifiedOnly"
                                 CheckedChanged="OnVerifiedOnlyChanged"
                                 Label="@SL["VerifiedOnly"]" />

                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Default"
                                   OnClick="Reload"
                                   Disabled="_loading" />
                </div>
            </div>

            <MudDivider Class="my-3" />

            @if (_loading)
            {
                <MudSkeleton Height="46px" />
                <MudSkeleton Height="46px" Class="mt-2" />
                <MudSkeleton Height="46px" Class="mt-2" />
            }
            else if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
            }
            else if (_items.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    @SL["NoShops"]
                </MudAlert>
            }
            else
            {
                <MudTable T="ShopRow"
                          Items="_items"
                          Dense="true"
                          Hover="true"
                          Bordered="true"
                          Striped="true">
                    <HeaderContent>
                        <MudTh>@SL["Shop"]</MudTh>
                        <MudTh>@SL["Location"]</MudTh>
                        <MudTh>@SL["Status"]</MudTh>
                        <MudTh>@SL["CreatedAt"]</MudTh>
                        <MudTh Align="right">@SL["Actions"]</MudTh>
                    </HeaderContent>

                    <RowTemplate Context="shop">
                        <MudTd>
                            <div class="dm-table-avatar">
                                <img src="@MediaCatalog.Shop(shop.ImageUrl, shop.Name, shop.Id)" alt="@shop.Name" class="dm-product-thumb-sm" />
                                <div>
                                    <div style="font-weight:800;">@shop.Name</div>
                                    <div class="dm-muted">ID: @shop.Id.ToString("N")[..8]...</div>
                                </div>
                            </div>
                        </MudTd>
                        <MudTd>@shop.City, @shop.CountryTag</MudTd>
                        <MudTd>
                            <MudChip T="string"
                                     Variant="Variant.Filled"
                                     Color="@(shop.IsVerified ? Color.Success : Color.Warning)"
                                     Label="true">
                                @(shop.IsVerified ? SL["Verifiee"] : SL["A verifier"])
                            </MudChip>
                        </MudTd>
                        <MudTd>@shop.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
                        <MudTd Align="Align.Right">
                            <AdminRowActionMenu Disabled="_saving" AriaLabel="@SL["Actions"]">
                                <MudMenuItem Icon="@Icons.Material.Filled.Verified"
                                             Disabled="@(_saving || shop.IsVerified)"
                                             OnClick="@(() => VerifyShop(shop))">
                                    @(shop.IsVerified ? SL["Verifiee"] : SL["Valider"])
                                </MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                             OnClick="@(() => EditShop(shop))">
                                    @SL["Edit"]
                                </MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Filled.Delete"
                                             OnClick="@(() => DeleteShop(shop))">
                                    @SL["Delete"]
                                </MudMenuItem>
                            </AdminRowActionMenu>
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                    <div class="dm-muted">@SL["PageLabel"] @_page / @TotalPages()</div>
                    <DmPager CurrentPage="_page" TotalPages="TotalPages()" OnPageChanged="OnPageChanged" />
                </div>
            }
        </MudPaper>
    }
</AuthGuard>

@code {
    private bool _ready;
    private bool _loading = true;
    private bool _saving;
    private string? _error;

    private int _page = 1;
    private int _pageSize = 20;
    private int _total;
    private string _q = string.Empty;
    private string _countryTag = string.Empty;
    private bool _verifiedOnly;

    private List<ShopRow> _items = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var t0 = DateTime.UtcNow;
        while (!Auth.IsReady && (DateTime.UtcNow - t0).TotalSeconds < 5)
        {
            await Task.Delay(30);
        }

        _ready = true;

        if (!Auth.IsAuthenticated || !Auth.IsAdmin)
        {
            StateHasChanged();
            return;
        }

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var query = new List<string>
            {
                $"page={_page}",
                $"pageSize={_pageSize}"
            };

            if (!string.IsNullOrWhiteSpace(_q))
            {
                query.Add($"q={Uri.EscapeDataString(_q.Trim())}");
            }

            if (!string.IsNullOrWhiteSpace(_countryTag))
            {
                query.Add($"countryTag={Uri.EscapeDataString(_countryTag.Trim())}");
            }

            if (_verifiedOnly)
            {
                query.Add("verifiedOnly=true");
            }

            var url = $"api/shops/admin?{string.Join("&", query)}";
            var result = await Http.GetFromJsonAsync<PagedResult<ShopRow>>(url);

            _items = result?.Items ?? new();
            _total = result?.Total ?? 0;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _items = new();
            _total = 0;
        }
        finally
        {
            _loading = false;
        }
    }

    private int TotalPages()
        => Math.Max(1, (int)Math.Ceiling(_total / (double)_pageSize));

    private async Task Reload()
    {
        _page = 1;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task OnSearchChanged(string value)
    {
        _q = value ?? string.Empty;
        _page = 1;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task OnCountryChanged(string value)
    {
        _countryTag = value ?? string.Empty;
        _page = 1;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task OnVerifiedOnlyChanged(bool value)
    {
        _verifiedOnly = value;
        _page = 1;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task OnPageChanged(int page)
    {
        _page = Math.Clamp(page, 1, TotalPages());
        await LoadAsync();
        StateHasChanged();
    }

    private async Task VerifyShop(ShopRow shop)
    {
        var confirm = await Dialog.ShowMessageBox(
            title: SL["ValidateShopTitle"],
            markupMessage: (MarkupString)string.Format(SL["ConfirmValidateShop"], WebUtility.HtmlEncode(shop.Name)),
            yesText: SL["Validate"],
            cancelText: SL["Annuler"]);

        if (confirm != true)
        {
            return;
        }

        _saving = true;
        try
        {
            var res = await Http.PostAsync($"api/shops/{shop.Id}/verify", null);
            if (!res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadAsStringAsync();
                throw new InvalidOperationException($"{SL["Erreur API"]} ({(int)res.StatusCode}) : {body}");
            }

            Snackbar.Add(SL["ShopValidated"], Severity.Success);
            await LoadAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task EditShop(ShopRow shop)
    {
        var parameters = new DialogParameters<DoorMarket.Web.Components.AdminShopEditDialog>
        {
            { x => x.Model, new AdminShopEditModel
                {
                    Id = shop.Id,
                    Name = shop.Name,
                    CountryTag = shop.CountryTag,
                    City = shop.City,
                    ImageUrl = shop.ImageUrl
                }
            }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            FullWidth = true,
            MaxWidth = MaxWidth.Small
        };

        var dialog = await Dialog.ShowAsync<DoorMarket.Web.Components.AdminShopEditDialog>(SL["EditShopTitle"], parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: true } || result?.Data is not AdminShopEditModel model)
        {
            return;
        }

        _saving = true;
        try
        {
            var req = new ShopUpdateRequest(model.Name.Trim(), model.CountryTag.Trim().ToUpperInvariant(), model.City.Trim(), model.ImageUrl);
            var res = await Http.PutAsJsonAsync($"api/shops/admin/{shop.Id}", req);
            if (!res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadAsStringAsync();
                throw new InvalidOperationException($"{SL["Erreur API"]} ({(int)res.StatusCode}) : {body}");
            }

            Snackbar.Add(SL["ShopUpdated"], Severity.Success);
            await LoadAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteShop(ShopRow shop)
    {
        var confirm = await Dialog.ShowMessageBox(
            title: SL["Supprimer boutique"],
            markupMessage: (MarkupString)$"{SL["Supprimer"]} <b>{WebUtility.HtmlEncode(shop.Name)}</b> ?",
            yesText: SL["Supprimer"],
            cancelText: SL["Annuler"]);

        if (confirm != true)
        {
            return;
        }

        _saving = true;
        try
        {
            var res = await Http.DeleteAsync($"api/shops/admin/{shop.Id}");
            if (!res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadAsStringAsync();
                throw new InvalidOperationException($"{SL["Erreur API"]} ({(int)res.StatusCode}) : {body}");
            }

            Snackbar.Add(SL["ShopDeleted"], Severity.Success);
            await LoadAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed record ShopUpdateRequest(string Name, string CountryTag, string City, string? ImageUrl = null);
    public record ShopRow(Guid Id, string Name, string? ImageUrl, string CountryTag, string City, bool IsVerified, DateTime CreatedAtUtc);
    public record PagedResult<T>(List<T> Items, int Total, int Page, int PageSize);
}

