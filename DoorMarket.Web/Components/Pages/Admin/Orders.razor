@page "/admin/orders"
@page "/admin/orders/{OrderId:guid}"
@using System.Net
@using System.Net.Http.Json
@using MudBlazor
@inject HttpClient Http
@inject DoorMarket.Web.Auth.AuthState Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject IStringLocalizer<SharedResource> SL

<h1 class="dm-page-h1">@SL["AdminOrders"]</h1>
<div class="dm-page-sub">@SL["AdminOrdersSubtitle"]</div>

<AuthGuard>
    @if (!_ready)
    {
        <MudPaper Class="pa-4 mt-3">
            <MudSkeleton Height="32px" Width="220px" Class="mb-2" />
            <MudSkeleton Height="18px" Width="380px" />
        </MudPaper>
    }
    else if (!Auth.IsAdmin)
    {
        <MudPaper Class="pa-4 mt-3">
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@SL["AdminOnlyAccess"]</MudAlert>
            <MudButton Variant="Variant.Outlined" Class="mt-3" OnClick="@(() => Nav.NavigateTo("/"))">@SL["Back"]</MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4 mt-3 dm-content-card">
            <div class="d-flex flex-wrap gap-2 align-items-end">
                <MudSelect T="string" Label="@SL["Status"]" Variant="Variant.Outlined" @bind-Value="_status">
                    <MudSelectItem Value="@string.Empty">@SL["All"]</MudSelectItem>
                    <MudSelectItem Value="@("Paid")">@StatusLabel("Paid")</MudSelectItem>
                    <MudSelectItem Value="@("PaidPending")">@StatusLabel("PaidPending")</MudSelectItem>
                    <MudSelectItem Value="@("Processing")">@StatusLabel("Processing")</MudSelectItem>
                    <MudSelectItem Value="@("Delivered")">@StatusLabel("Delivered")</MudSelectItem>
                    <MudSelectItem Value="@("Cancelled")">@StatusLabel("Cancelled")</MudSelectItem>
                </MudSelect>
                <MudDatePicker Label="@SL["DateFrom"]" @bind-Date="_from" Variant="Variant.Outlined" />
                <MudDatePicker Label="@SL["DateTo"]" @bind-Date="_to" Variant="Variant.Outlined" />
                <MudTextField T="string" Variant="Variant.Outlined" Placeholder="@SL["Search"]" @bind-Value="_q" Immediate="true" DebounceInterval="350" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Reload">@SL["Apply"]</MudButton>
            </div>

            <MudDivider Class="my-3" />

            @if (_loading)
            {
                <MudSkeleton Height="42px" />
                <MudSkeleton Height="42px" Class="mt-2" />
            }
            else if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
            }
            else if (_items.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@SL["NoOrders"]</MudAlert>
            }
            else
            {
                <MudTable T="AdminOrderRow" Items="_items" Dense="true" Hover="true" Bordered="true" Striped="true">
                    <HeaderContent>
                        <MudTh>@SL["OrderNumber"]</MudTh>
                        <MudTh>@SL["Customer"]</MudTh>
                        <MudTh>@SL["Status"]</MudTh>
                        <MudTh>@SL["PaidAt"]</MudTh>
                        <MudTh Align="Align.Right">@SL["GrandTotal"]</MudTh>
                        <MudTh Align="Align.Right">@SL["PlatformFeeTotal"]</MudTh>
                        <MudTh Align="Align.Right">@SL["Actions"]</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="o">
                        <MudTd>@o.OrderNumber</MudTd>
                        <MudTd>
                            <div>@o.CustomerName</div>
                            <div class="dm-muted">@o.CustomerEmail</div>
                        </MudTd>
                        <MudTd>@StatusLabel(o.FulfillmentStatus)</MudTd>
                        <MudTd>@(o.PaidAtUtc?.ToLocalTime().ToString("dd/MM HH:mm") ?? "-")</MudTd>
                        <MudTd Align="Align.Right">@Fmt(o.GrandTotal) @o.Currency</MudTd>
                        <MudTd Align="Align.Right">@Fmt(o.PlatformFeeTotal)</MudTd>
                        <MudTd Align="Align.Right">
                            <AdminRowActionMenu AriaLabel="@SL["Actions"]">
                                <MudMenuItem Icon="@Icons.Material.Filled.OpenInNew"
                                             OnClick="@(() => OpenDetail(o))">
                                    @SL["Details"]
                                </MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Filled.DoneAll"
                                             Disabled="@(!CanMarkDelivered(o))"
                                             OnClick="@(() => MarkDelivered(o))">
                                    @SL["MarkDelivered"]
                                </MudMenuItem>
                            </AdminRowActionMenu>
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                    <div class="dm-muted">@SL["PageLabel"] @_page / @TotalPages()</div>
                    <DmPager CurrentPage="_page" TotalPages="TotalPages()" OnPageChanged="OnPageChanged" />
                </div>
            }
        </MudPaper>
    }
</AuthGuard>

@code {
    [Parameter] public Guid? OrderId { get; set; }

    private bool _ready;
    private bool _loading = true;
    private string? _error;
    private string _status = string.Empty;
    private DateTime? _from = DateTime.UtcNow.AddDays(-30);
    private DateTime? _to = DateTime.UtcNow;
    private string _q = string.Empty;
    private int _page = 1;
    private int _pageSize = 20;
    private int _total;
    private List<AdminOrderRow> _items = new();
    private bool _detailOpened;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var t0 = DateTime.UtcNow;
        while (!Auth.IsReady && (DateTime.UtcNow - t0).TotalSeconds < 5)
            await Task.Delay(30);

        _ready = true;
        if (!Auth.IsAuthenticated || !Auth.IsAdmin)
        {
            StateHasChanged();
            return;
        }

        await LoadAsync();
        await OpenDetailFromRouteAsync();
        StateHasChanged();
    }

    private async Task Reload()
    {
        _page = 1;
        await LoadAsync();
        await OpenDetailFromRouteAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var url = $"api/admin/orders?page={_page}&pageSize={_pageSize}{BuildQuery()}";
            var res = await Http.GetFromJsonAsync<AdminOrdersPaged>(url);
            _items = res?.Items ?? new();
            _total = res?.Total ?? 0;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _items = new();
            _total = 0;
        }
        finally
        {
            _loading = false;
        }
    }

    private string BuildQuery()
    {
        var list = new List<string>();
        if (!string.IsNullOrWhiteSpace(_status)) list.Add($"status={Uri.EscapeDataString(_status)}");
        if (_from.HasValue) list.Add($"from={Uri.EscapeDataString(_from.Value.ToString("yyyy-MM-dd"))}");
        if (_to.HasValue) list.Add($"to={Uri.EscapeDataString(_to.Value.ToString("yyyy-MM-dd"))}");
        if (!string.IsNullOrWhiteSpace(_q)) list.Add($"q={Uri.EscapeDataString(_q)}");
        return list.Count == 0 ? string.Empty : "&" + string.Join("&", list);
    }

    private int TotalPages() => Math.Max(1, (int)Math.Ceiling(_total / (double)_pageSize));

    private async Task OnPageChanged(int page)
    {
        _page = Math.Clamp(page, 1, TotalPages());
        await LoadAsync();
        StateHasChanged();
    }

    private bool CanMarkDelivered(AdminOrderRow row)
        => string.Equals(row.PaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase)
           && !string.Equals(row.FulfillmentStatus, "Delivered", StringComparison.OrdinalIgnoreCase);

    private async Task MarkDelivered(AdminOrderRow row)
    {
        try
        {
            var res = await Http.PatchAsJsonAsync($"api/admin/orders/{row.OrderId}/status", new { status = "Delivered" });
            if (!res.IsSuccessStatusCode)
                throw await BuildApiError(res);

            Snackbar.Add(SL["OrderDelivered"], Severity.Success);
            await LoadAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task OpenDetail(AdminOrderRow row)
        => await OpenDetail(row.OrderId);

    private async Task OpenDetail(Guid orderId)
    {
        var parameters = new DialogParameters<DoorMarket.Web.Components.AdminOrderDetailDialog>
        {
            { x => x.OrderId, orderId }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        await Dialog.ShowAsync<DoorMarket.Web.Components.AdminOrderDetailDialog>(SL["Details"], parameters, options);
    }

    private async Task OpenDetailFromRouteAsync()
    {
        if (!OrderId.HasValue || _detailOpened)
        {
            return;
        }

        _detailOpened = true;
        await OpenDetail(OrderId.Value);
    }

    private async Task<Exception> BuildApiError(HttpResponseMessage res)
    {
        var body = await res.Content.ReadAsStringAsync();
        return res.StatusCode switch
        {
            HttpStatusCode.Unauthorized => new InvalidOperationException(SL["Non autorise (401)."]),
            HttpStatusCode.Forbidden => new InvalidOperationException(SL["Acces refuse (403). Admin requis."]),
            HttpStatusCode.NotFound => new InvalidOperationException(SL["Route introuvable (404)."]),
            HttpStatusCode.Conflict => new InvalidOperationException(string.IsNullOrWhiteSpace(body) ? SL["Conflit (409)."] : body),
            _ => new InvalidOperationException($"{SL["Erreur API"]} ({(int)res.StatusCode}) : {body}")
        };
    }

    private static bool IsEn => string.Equals(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, "en", StringComparison.OrdinalIgnoreCase);
    private static string Tr(string fr, string en) => IsEn ? en : fr;
    private static string StatusLabel(string? status) => status switch
    {
        "Paid" => Tr("Payee", "Paid"),
        "PaidPending" => Tr("Paiement en attente", "Paid pending"),
        "Processing" => Tr("En preparation", "Processing"),
        "Delivered" => Tr("Livree", "Delivered"),
        "Cancelled" => Tr("Annulee", "Cancelled"),
        _ => status ?? "-"
    };

    private static string Fmt(decimal value) => value.ToString("0.##");

    private sealed record AdminOrderRow(
        Guid OrderId,
        string OrderNumber,
        string CustomerName,
        string? CustomerEmail,
        string Status,
        string PaymentStatus,
        string FulfillmentStatus,
        DateTime? PaidAtUtc,
        decimal TotalItemsAmount,
        decimal DeliveryFee,
        decimal GrandTotal,
        string Currency,
        decimal PlatformFeeTotal,
        int ShopsCount);

    private sealed record AdminOrdersPaged(List<AdminOrderRow> Items, int Total, int Page, int PageSize);
}
