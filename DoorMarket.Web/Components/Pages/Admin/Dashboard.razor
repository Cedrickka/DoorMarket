                                <MudText Typo="Typo.subtitle1" Class="mt-4">@Tr("Incidents alertes", "Alert incidents")</MudText>
                                @if (_checkoutIncidents.Count == 0)
                                {
                                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">
                                        @Tr("Aucun incident checkout actif sur cette periode.", "No active checkout incidents in this period.")
                                    </MudAlert>
                                }
                                else
                                {
                                    <MudTable T="CheckoutAlertIncidentRow" Items="_checkoutIncidents" Dense="true" Hover="true" Bordered="true" Striped="true">
                                        <HeaderContent>
                                            <MudTh>@Tr("Severite", "Severity")</MudTh>
                                            <MudTh>Code</MudTh>
                                            <MudTh>@Tr("Provider", "Provider")</MudTh>
                                            <MudTh>@Tr("Observe/Seuil", "Observed/Threshold")</MudTh>
                                            <MudTh>@Tr("Declenchements", "Triggers")</MudTh>
                                            <MudTh>@Tr("Derniere vue (UTC)", "Last seen (UTC)")</MudTh>
                                            <MudTh>@Tr("Etat", "State")</MudTh>
                                            <MudTh>@Tr("Actions", "Actions")</MudTh>
                                        </HeaderContent>
                                        <RowTemplate Context="incident">
                                            <MudTd>
                                                <MudText Typo="Typo.caption"
                                                         Color="@(incident.Severity == "Critical" ? Color.Error : Color.Warning)">
                                                    @incident.Severity
                                                </MudText>
                                            </MudTd>
                                            <MudTd>@incident.AlertCode</MudTd>
                                            <MudTd>@(string.IsNullOrWhiteSpace(incident.Provider) ? "-" : incident.Provider)</MudTd>
                                            <MudTd>@Fmt(incident.ObservedValue) / @Fmt(incident.ThresholdValue)</MudTd>
                                            <MudTd>@incident.TriggerCount</MudTd>
                                            <MudTd>@incident.LastTriggeredAtUtc.ToString("yyyy-MM-dd HH:mm")</MudTd>
                                            <MudTd>@GetCheckoutIncidentState(incident)</MudTd>
                                            <MudTd>
                                                <AdminRowActionMenu Disabled="_checkoutIncidentBusy" AriaLabel="@Tr("Actions", "Actions")">
                                                    @if (incident.IsAcknowledged)
                                                    {
                                                        <MudMenuItem Icon="@Icons.Material.Filled.Replay"
                                                                     OnClick="@(() => ReopenCheckoutIncident(incident.Id))">
                                                            @Tr("Reouvrir", "Reopen")
                                                        </MudMenuItem>
                                                    }
                                                    else
                                                    {
                                                        <MudMenuItem Icon="@Icons.Material.Filled.Done"
                                                                     OnClick="@(() => AcknowledgeCheckoutIncident(incident.Id))">
                                                            @Tr("Acquitter", "Acknowledge")
                                                        </MudMenuItem>
                                                    }
                                                </AdminRowActionMenu>
                                            </MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                }

                                @if (_checkoutSnapshot.Providers.Count > 0)
                                {
                                    <MudText Typo="Typo.subtitle1" Class="mt-4">@Tr("Qualite provider", "Provider quality")</MudText>
                                    <MudTable T="CheckoutProviderQualityRow" Items="_checkoutSnapshot.Providers" Dense="true" Hover="true" Bordered="true" Striped="true">
                                        <HeaderContent>
                                            <MudTh>@Tr("Provider", "Provider")</MudTh>
                                            <MudTh>@Tr("Initie", "Initiated")</MudTh>
                                            <MudTh>@Tr("Confirme", "Confirmed")</MudTh>
                                            <MudTh>@Tr("Echoue", "Failed")</MudTh>
                                            <MudTh Align="Align.Right">@Tr("Succes %", "Success %")</MudTh>
                                            <MudTh Align="Align.Right">@Tr("Echec %", "Fail %")</MudTh>
                                            <MudTh Align="Align.Right">p95 ms</MudTh>
                                        </HeaderContent>
                                        <RowTemplate Context="p">
                                            <MudTd>@p.Provider</MudTd>
                                            <MudTd>@p.InitiatedCount</MudTd>
                                            <MudTd>@p.ConfirmedCount</MudTd>
                                            <MudTd>@p.FailedCount</MudTd>
                                            <MudTd Align="Align.Right">@Fmt(p.SuccessRatePercent)%</MudTd>
                                            <MudTd Align="Align.Right">@Fmt(p.FailureRatePercent)%</MudTd>
                                            <MudTd Align="Align.Right">@($"{p.LatencyP95Ms ?? 0}")</MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                }

                                @if (_checkoutAbRows.Count > 0)
                                {
                                    <MudText Typo="Typo.subtitle1" Class="mt-4">@Tr("Checkout UX A/B", "Checkout UX A/B")</MudText>
                                    <MudTable T="CheckoutAbUxRow" Items="_checkoutAbRows" Dense="true" Hover="true" Bordered="true" Striped="true">
                                        <HeaderContent>
                                            <MudTh>@Tr("Experience", "Experiment")</MudTh>
                                            <MudTh>@Tr("Groupe", "Group")</MudTh>
                                            <MudTh>@Tr("Vues", "Views")</MudTh>
                                            <MudTh>@Tr("Submit", "Submit")</MudTh>
                                            <MudTh>@Tr("Commandes", "Orders")</MudTh>
                                            <MudTh>@Tr("Payees", "Paid")</MudTh>
                                            <MudTh Align="Align.Right">@Tr("Global %", "Overall %")</MudTh>
                                            <MudTh Align="Align.Right">@Tr("Uplift vs A", "Uplift vs A")</MudTh>
                                        </HeaderContent>
                                        <RowTemplate Context="x">
                                            <MudTd>@x.ExperimentName</MudTd>
                                            <MudTd>@x.ExperimentGroup</MudTd>
                                            <MudTd>@x.CheckoutViews</MudTd>
                                            <MudTd>@x.SubmitClicks</MudTd>
                                            <MudTd>@x.OrdersCreated</MudTd>
                                            <MudTd>@x.PaymentsConfirmed</MudTd>
                                            <MudTd Align="Align.Right">@Fmt(x.OverallConversionRate)%</MudTd>
                                            <MudTd Align="Align.Right">@Fmt(x.UpliftVsControlPct)%</MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                }

                                @if (_checkoutRealtime.Count > 0)
                                {
                                    <MudText Typo="Typo.subtitle1" Class="mt-4">@Tr("Derniers buckets (15 min)", "Last buckets (15 min)")</MudText>
                                    <MudTable T="CheckoutRealtimePoint" Items="_checkoutRealtime.TakeLast(8)" Dense="true" Hover="true">
                                        <HeaderContent>
                                            <MudTh>@Tr("Bucket UTC", "Bucket UTC")</MudTh>
                                            <MudTh>@Tr("Submit", "Submit")</MudTh>
                                            <MudTh>@Tr("Commandes", "Orders")</MudTh>
                                            <MudTh>@Tr("Initie", "Initiated")</MudTh>
                                            <MudTh>@Tr("Confirme", "Confirmed")</MudTh>
                                            <MudTh>@Tr("Echoue", "Failed")</MudTh>
                                            <MudTh Align="Align.Right">@Tr("Succes %", "Success %")</MudTh>
                                        </HeaderContent>
                                        <RowTemplate Context="r">
                                            <MudTd>@r.BucketStartUtc.ToString("yyyy-MM-dd HH:mm")</MudTd>
                                            <MudTd>@r.SubmitClicks</MudTd>
                                            <MudTd>@r.OrdersCreated</MudTd>
                                            <MudTd>@r.PaymentsInitiated</MudTd>
                                            <MudTd>@r.PaymentsConfirmed</MudTd>
                                            <MudTd>@r.PaymentsFailed</MudTd>
                                            <MudTd Align="Align.Right">@Fmt(r.PaymentSuccessRate)%</MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                }
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                }
            }
        </MudPaper>
    }
</AuthGuard>

@code {
    private bool _ready;
    private bool _loading = true;
    private string? _error;
    private DateTime? _from = DateTime.UtcNow.AddDays(-30);
    private DateTime? _to = DateTime.UtcNow;

    private FinanceKpis? _kpis;
    private List<TopProductRow> _topProducts = new();
    private List<TopShopRow> _topShops = new();
    private List<TopCategoryRow> _topCategories = new();
    private OperationsSnapshot? _ops;
    private CartRecoverySummary? _cartRecovery;
    private CheckoutSnapshot? _checkoutSnapshot;
    private CheckoutProductionDashboard? _checkoutProdDashboard;
    private CheckoutSloStatus? _checkoutSloStatus;
    private List<CheckoutRealtimePoint> _checkoutRealtime = new();
    private List<CheckoutPaymentAlert> _checkoutAlerts = new();
    private List<CheckoutAlertIncidentRow> _checkoutIncidents = new();
    private List<CheckoutAbUxRow> _checkoutAbRows = new();
    private bool _checkoutIncidentBusy;
    private ConversionFunnel? _conversionFunnel;
    private List<CohortRow> _cohorts = new();
    private List<CampaignRoiRow> _campaignRoi = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var t0 = DateTime.UtcNow;
        while (!Auth.IsReady && (DateTime.UtcNow - t0).TotalSeconds < 5)
            await Task.Delay(30);

        _ready = true;
        if (!Auth.IsAuthenticated || !Auth.IsAdmin)
        {
            StateHasChanged();
            return;
        }

        await LoadAsync();
        StateHasChanged();
    }

    private async Task Reload()
    {
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var query = BuildQuery();
            _kpis = await GetJsonAsync<FinanceKpis>($"api/admin/analytics/kpis{query}");
            _topProducts = await GetJsonAsync<List<TopProductRow>>($"api/admin/analytics/top-products{query}&take=10") ?? new();
            _topShops = await GetJsonAsync<List<TopShopRow>>($"api/admin/analytics/top-shops{query}&take=10") ?? new();
            _topCategories = await GetJsonAsync<List<TopCategoryRow>>($"api/admin/analytics/top-categories{query}&take=10") ?? new();
            _ops = await GetJsonAsync<OperationsSnapshot>("api/admin/operations/snapshot?hours=24&staleCartHours=24");
            _cartRecovery = await GetJsonAsync<CartRecoverySummary>("api/admin/cart-recovery/summary?conversionWindowHours=168");
            _checkoutSnapshot = await GetJsonAsync<CheckoutSnapshot>($"api/admin/checkout-observability/snapshot{query}");
            _checkoutProdDashboard = await GetJsonAsync<CheckoutProductionDashboard>(AppendQuery("api/admin/checkout-observability/dashboard", query, "defaultHours=24"));
            _checkoutSloStatus = await GetJsonAsync<CheckoutSloStatus>(AppendQuery("api/admin/checkout-observability/slo", query, "defaultHours=4"));
            _checkoutRealtime = await GetJsonAsync<List<CheckoutRealtimePoint>>($"{AppendQuery("api/admin/checkout-observability/realtime", query, "bucketMinutes=15")}") ?? new();
            _checkoutAlerts = await GetJsonAsync<List<CheckoutPaymentAlert>>($"api/admin/checkout-observability/alerts{query}") ?? new();
            _checkoutIncidents = await GetJsonAsync<List<CheckoutAlertIncidentRow>>($"{AppendQuery("api/admin/checkout-observability/incidents", query, "includeResolved=false&includeAcknowledged=true&take=30")}") ?? new();
            _checkoutAbRows = await GetJsonAsync<List<CheckoutAbUxRow>>($"{AppendQuery("api/admin/checkout-observability/ab-ux", query, "defaultDays=30")}") ?? new();
            _conversionFunnel = await GetJsonAsync<ConversionFunnel>($"api/admin/conversion/funnel{query}");
            _cohorts = await GetJsonAsync<List<CohortRow>>($"api/admin/conversion/cohorts{query}") ?? new();
            _campaignRoi = await GetJsonAsync<List<CampaignRoiRow>>($"api/admin/conversion/campaign-roi{query}") ?? new();
        }
        catch (Exception ex)
        {
            _error = WebErrorUx.ForException(
                ex,
                SL,
                "Impossible de charger le dashboard.",
                "Unable to load dashboard.");
        }
        finally
        {
            _loading = false;
        }
    }

    private string BuildQuery()
    {
        var list = new List<string>();
        if (_from.HasValue) list.Add($"from={Uri.EscapeDataString(_from.Value.ToString("yyyy-MM-dd"))}");
        if (_to.HasValue) list.Add($"to={Uri.EscapeDataString(_to.Value.ToString("yyyy-MM-dd"))}");
        return list.Count == 0 ? string.Empty : "?" + string.Join("&", list);
    }

    private static string AppendQuery(string basePath, string query, string extra)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return $"{basePath}?{extra}";
        }

        return $"{basePath}{query}&{extra}";
    }

    private async Task<T?> GetJsonAsync<T>(string url)
    {
        using var response = await Http.GetAsync(url);
        if (!response.IsSuccessStatusCode)
        {
            var message = await WebErrorUx.ForHttpFailureAsync(
                response,
                SL,
                "Chargement des donnees impossible.",
                "Unable to load data.");
            throw new InvalidOperationException(message);
        }

        if (response.Content.Headers.ContentLength == 0)
        {
            return default;
        }

        return await response.Content.ReadFromJsonAsync<T>();
    }

    private async Task AcknowledgeCheckoutIncident(Guid incidentId)
    {
        _checkoutIncidentBusy = true;
        try
        {
            using var response = await Http.PostAsJsonAsync(
                $"api/admin/checkout-observability/incidents/{incidentId}/acknowledge",
                new CheckoutIncidentAcknowledgeRequest(null));

            if (!response.IsSuccessStatusCode)
            {
                var message = await WebErrorUx.ForHttpFailureAsync(
                    response,
                    SL,
                    "Acquittement impossible.",
                    "Unable to acknowledge incident.");
                throw new InvalidOperationException(message);
            }

            Snackbar.ShowSuccess(Tr("Incident checkout acquitte.", "Checkout incident acknowledged."));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.ShowError(WebErrorUx.ForException(
                ex,
                SL,
                "Acquittement impossible.",
                "Unable to acknowledge incident."));
        }
        finally
        {
            _checkoutIncidentBusy = false;
            StateHasChanged();
        }
    }

    private async Task ReopenCheckoutIncident(Guid incidentId)
    {
        _checkoutIncidentBusy = true;
        try
        {
            using var response = await Http.PostAsync(
                $"api/admin/checkout-observability/incidents/{incidentId}/reopen",
                content: null);

            if (!response.IsSuccessStatusCode)
            {
                var message = await WebErrorUx.ForHttpFailureAsync(
                    response,
                    SL,
                    "Reouverture impossible.",
                    "Unable to reopen incident.");
                throw new InvalidOperationException(message);
            }

            Snackbar.ShowSuccess(Tr("Incident checkout rouvert.", "Checkout incident reopened."));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.ShowError(WebErrorUx.ForException(
                ex,
                SL,
                "Reouverture impossible.",
                "Unable to reopen incident."));
        }
        finally
        {
            _checkoutIncidentBusy = false;
            StateHasChanged();
        }
    }

    private static string Fmt(decimal value) => value.ToString("0.##");

    private static string Tr(string fr, string en)
        => string.Equals(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, "en", StringComparison.OrdinalIgnoreCase) ? en : fr;

    private static string GetCheckoutIncidentState(CheckoutAlertIncidentRow incident)
    {
        if (incident.ResolvedAtUtc.HasValue)
        {
            return Tr($"Resolu le {incident.ResolvedAtUtc.Value.ToLocalTime():yyyy-MM-dd HH:mm}", $"Resolved at {incident.ResolvedAtUtc.Value.ToLocalTime():yyyy-MM-dd HH:mm}");
        }

        if (!incident.IsAcknowledged)
        {
            return Tr("Ouvert", "Open");
        }

        var at = incident.AcknowledgedAtUtc.HasValue
            ? incident.AcknowledgedAtUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            : "-";
        var by = string.IsNullOrWhiteSpace(incident.AcknowledgedBy) ? Tr("admin", "admin") : incident.AcknowledgedBy;
        return Tr($"Acquitte par {by} a {at}", $"Acknowledged by {by} at {at}");
    }

    private static Severity GetCheckoutSloSeverity(CheckoutSloStatus? status)
    {
        if (status is null || status.TriggeredAlertCodes.Count == 0)
        {
            return Severity.Success;
        }

        return status.TriggeredAlertCodes.Any(x => x.StartsWith("critical_", StringComparison.OrdinalIgnoreCase))
            ? Severity.Error
            : Severity.Warning;
    }

    private static IReadOnlyList<CheckoutJobPipeline> GetCheckoutJobRows(CheckoutProductionDashboard dashboard)
        => new[]
        {
            dashboard.Jobs.CartRecovery,
            dashboard.Jobs.Reconciliation,
            dashboard.Jobs.MarketingAutomation
        };

    private void OpenNotificationCenter()
        => Nav.NavigateTo("/admin/notifications");

    private void OpenSearchAnalytics()
    {
        if (!Auth.IsSuperAdmin)
        {
            return;
        }

        Nav.NavigateTo("/admin/search-analytics");
    }

    private void OpenCartRecovery()
        => Nav.NavigateTo("/admin/cart-recovery");

    private sealed record FinanceKpis(
        int OrdersCount,
        int PaidOrdersCount,
        decimal GrossSalesItems,
        decimal DeliveryRevenue,
        decimal PlatformFeeTotal,
        decimal PlatformRevenueTotal,
        decimal NetToShopsTotal,
        decimal AvgBasket,
        decimal CashInExpected);

    private sealed record TopProductRow(Guid ProductId, string Name, int QtySold, decimal RevenueItems, decimal PlatformFee);
    private sealed record TopShopRow(Guid ShopId, string Name, int OrdersCount, decimal GrossSalesItems, decimal PlatformFee);
    private sealed record TopCategoryRow(Guid CategoryId, string Name, int QtySold, decimal RevenueItems, decimal PlatformFee);
    private sealed record OperationsSnapshot(
        DateTime FromUtc,
        DateTime ToUtc,
        int OrdersCreated,
        int OrdersPaid,
        int OrdersFailed,
        int CartUsersActive,
        int CheckoutUsers,
        decimal CheckoutUserConversionRate,
        int CartsWithItems,
        int StaleCarts,
        int PayoutBacklogCount,
        decimal PayoutBacklogAmount,
        int ActiveProductsOutOfStock,
        int ActiveProductsLowStock,
        int PendingShopApplications,
        int LiveBanners,
        int NotificationAttemptsInWindow,
        int NotificationFailedInWindow,
        int NotificationFailedUnresolved);

    private sealed record CartRecoverySummary(
        DateTime FromUtc,
        DateTime ToUtc,
        int DetectedEvents,
        int RemindersSent,
        int RemindersFailed,
        int RemindersSkipped,
        int ConvertedEvents,
        decimal ConversionRatePct,
        int ResumedEvents,
        decimal ResumeRatePct,
        int GroupAEvents,
        int GroupAConverted,
        decimal GroupAConversionRatePct,
        int GroupBEvents,
        int GroupBConverted,
        decimal GroupBConversionRatePct,
        decimal UpliftPct,
        int JobRunsCount,
        int JobRunsSuccessCount,
        int JobRunsFailureCount,
        int? JobLatencyP50Ms,
        int? JobLatencyP95Ms,
        int SmtpFailures,
        int PushFailures);

    private sealed record CheckoutSnapshot(
        DateTime FromUtc,
        DateTime ToUtc,
        int CheckoutViews,
        int SubmitClicks,
        int OrdersCreated,
        int PaymentsInitiated,
        int PaymentsConfirmed,
        int PaymentsFailed,
        int RedirectsFailed,
        decimal SubmitToOrderRate,
        decimal OrderToPaidRate,
        decimal PaymentSuccessRate,
        decimal DropBeforePaymentRate,
        int? LatencyP50Ms,
        int? LatencyP95Ms,
        IReadOnlyList<CheckoutProviderQualityRow> Providers,
        int AlertsCount);

    private sealed record CheckoutProviderQualityRow(
        string Provider,
        int InitiatedCount,
        int ConfirmedCount,
        int FailedCount,
        decimal SuccessRatePercent,
        decimal FailureRatePercent,
        int? LatencyP50Ms,
        int? LatencyP95Ms);

    private sealed record CheckoutRealtimePoint(
        DateTime BucketStartUtc,
        DateTime BucketEndUtc,
        int SubmitClicks,
        int OrdersCreated,
        int PaymentsInitiated,
        int PaymentsConfirmed,
        int PaymentsFailed,
