                                    </div>

                                    @if (_checkoutProdDashboard.Errors.TopErrorCodes.Count > 0)
                                    {
                                        <MudText Typo="Typo.subtitle2" Class="mt-3">@Tr("Top codes erreurs", "Top error codes")</MudText>
                                        <MudTable T="CheckoutKeyCountRow" Items="_checkoutProdDashboard.Errors.TopErrorCodes" Dense="true" Hover="true">
                                            <HeaderContent>
                                                <MudTh>Code</MudTh>
                                                <MudTh>@Tr("Occurrences", "Occurrences")</MudTh>
                                            </HeaderContent>
                                            <RowTemplate Context="row">
                                                <MudTd>@row.Key</MudTd>
                                                <MudTd>@row.Count</MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    }

                                    <MudText Typo="Typo.subtitle2" Class="mt-3">@Tr("Sante jobs", "Jobs health")</MudText>
                                    <MudTable T="CheckoutJobPipeline" Items="GetCheckoutJobRows(_checkoutProdDashboard)" Dense="true" Hover="true" Bordered="true" Striped="true">
                                        <HeaderContent>
                                            <MudTh>@Tr("Job", "Job")</MudTh>
                                            <MudTh>@Tr("Runs", "Runs")</MudTh>
                                            <MudTh>@Tr("Succes", "Success")</MudTh>
                                            <MudTh>@Tr("Echec", "Failed")</MudTh>
                                            <MudTh>@Tr("In progress", "In progress")</MudTh>
                                            <MudTh Align="Align.Right">@Tr("Taux succes", "Success rate")</MudTh>
                                            <MudTh Align="Align.Right">p50/p95 ms</MudTh>
                                        </HeaderContent>
                                        <RowTemplate Context="job">
                                            <MudTd>@job.JobName</MudTd>
                                            <MudTd>@job.Runs</MudTd>
                                            <MudTd>@job.SuccessRuns</MudTd>
                                            <MudTd>@job.FailedRuns</MudTd>
                                            <MudTd>@job.InProgressRuns</MudTd>
                                            <MudTd Align="Align.Right">@Fmt(job.SuccessRatePercent)%</MudTd>
                                            <MudTd Align="Align.Right">@($"{job.DurationP50Ms ?? 0}/{job.DurationP95Ms ?? 0}")</MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                }

                                @if (_checkoutAlerts.Count > 0)
                                {
                                    <div class="mt-3 d-grid gap-2">
                                        @foreach (var alert in _checkoutAlerts.Take(6))
                                        {
                                            <MudAlert Severity="@(alert.Severity == "Critical" ? Severity.Error : Severity.Warning)" Variant="Variant.Outlined">
                                                <strong>@alert.Title</strong> - @alert.Description
                                                <div class="mt-1">@Tr("Observe", "Observed"): @Fmt(alert.ObservedValue) | @Tr("Seuil", "Threshold"): @Fmt(alert.ThresholdValue) @if(!string.IsNullOrWhiteSpace(alert.Provider)){<span>| @Tr("Provider", "Provider"): @alert.Provider</span>}</div>
                                            </MudAlert>
                                        }
                                    </div>
