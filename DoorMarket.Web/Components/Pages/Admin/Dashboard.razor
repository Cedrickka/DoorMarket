@page "/admin/dashboard"
@using System.Net.Http.Json
@using System.Globalization
@using MudBlazor
@inject HttpClient Http
@inject DoorMarket.Web.Auth.AuthState Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> SL

<div class="dm-page-header">
    <div class="dm-page-title-wrap">
        <h1 class="dm-page-h1">@SL["AdminDashboard"]</h1>
        <div class="dm-page-sub">@SL["AnalyticsSubtitle"]</div>
    </div>
</div>

<AuthGuard>
    @if (!_ready)
    {
        <MudPaper Class="pa-4 mt-3">
            <MudSkeleton Height="32px" Width="220px" Class="mb-2" />
            <MudSkeleton Height="18px" Width="380px" />
        </MudPaper>
    }
    else if (!Auth.IsAdmin)
    {
        <MudPaper Class="pa-4 mt-3">
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@SL["AdminOnlyAccess"]</MudAlert>
            <MudButton Variant="Variant.Outlined" Class="mt-3" OnClick="@(() => Nav.NavigateTo("/"))">@SL["Back"]</MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4 mt-3 dm-content-card dm-page-shell dm-view-enter">
            <div class="dm-toolbar-row">
                <MudDatePicker Label="@SL["DateFrom"]" @bind-Date="_from" Variant="Variant.Outlined" />
                <MudDatePicker Label="@SL["DateTo"]" @bind-Date="_to" Variant="Variant.Outlined" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Reload">@SL["Apply"]</MudButton>
                @if (Auth.IsSuperAdmin)
                {
                    <MudButton Variant="Variant.Outlined" OnClick="OpenSearchAnalytics">@Tr("Analytique recherche", "Search analytics")</MudButton>
                }
            </div>

            <MudDivider Class="my-3" />

            @if (_loading)
            {
                <MudSkeleton Height="90px" />
            }
            else if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
            }
            else if (_kpis is not null)
            {
                <MudGrid Class="mt-2 dm-equal-grid">
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-3 dm-kpi-card dm-admin-kpi-card">
                            <MudText Class="dm-kpi-label">@SL["PaidOrders"]</MudText>
                            <MudText Class="dm-kpi-value">@_kpis.PaidOrdersCount</MudText>
                            <MudText Class="dm-kpi-meta">@Tr("commandes payees sur la periode", "orders paid in selected period")</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-3 dm-kpi-card dm-admin-kpi-card">
                            <MudText Class="dm-kpi-label">@SL["GrossSalesItems"]</MudText>
                            <MudText Class="dm-kpi-value">@Fmt(_kpis.GrossSalesItems)</MudText>
                            <MudText Class="dm-kpi-meta">@Tr("revenus articles avant frais", "items revenue before fees")</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-3 dm-kpi-card dm-admin-kpi-card">
                            <MudText Class="dm-kpi-label">@SL["DeliveryRevenue"]</MudText>
                            <MudText Class="dm-kpi-value">@Fmt(_kpis.DeliveryRevenue)</MudText>
                            <MudText Class="dm-kpi-meta">@Tr("montant livraison collecte", "shipping amount collected")</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-3 dm-kpi-card dm-admin-kpi-card">
                            <MudText Class="dm-kpi-label">@SL["PlatformFeeTotal"]</MudText>
                            <MudText Class="dm-kpi-value">@Fmt(_kpis.PlatformFeeTotal)</MudText>
                            <MudText Class="dm-kpi-meta">@Tr("commission retenue par la plateforme", "commission retained by platform")</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-3 dm-kpi-card dm-admin-kpi-card dm-kpi-tone-success">
                            <MudText Class="dm-kpi-label">@SL["PlatformRevenueTotal"]</MudText>
                            <MudText Class="dm-kpi-value">@Fmt(_kpis.PlatformRevenueTotal)</MudText>
                            <MudText Class="dm-kpi-meta">@Tr("montant net pour DoorMarket", "net amount for DoorMarket")</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-3 dm-kpi-card dm-admin-kpi-card dm-kpi-tone-warning">
                            <MudText Class="dm-kpi-label">@SL["NetToShopsTotal"]</MudText>
                            <MudText Class="dm-kpi-value">@Fmt(_kpis.NetToShopsTotal)</MudText>
                            <MudText Class="dm-kpi-meta">@Tr("montant du aux boutiques", "amount owed to shops")</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-3 dm-kpi-card dm-admin-kpi-card">
                            <MudText Class="dm-kpi-label">@SL["AvgBasket"]</MudText>
                            <MudText Class="dm-kpi-value">@Fmt(_kpis.AvgBasket)</MudText>
                            <MudText Class="dm-kpi-meta">@Tr("panier moyen", "average order value")</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-3 dm-kpi-card dm-admin-kpi-card dm-kpi-tone-danger">
                            <MudText Class="dm-kpi-label">@SL["CashInExpected"]</MudText>
                            <MudText Class="dm-kpi-value">@Fmt(_kpis.CashInExpected)</MudText>
                            <MudText Class="dm-kpi-meta">@Tr("mouvement de tresorerie attendu", "expected cash movement")</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudGrid Class="mt-4 dm-equal-grid">
                    <MudItem xs="12" md="4">
                        <MudPaper Class="pa-3 dm-admin-panel dm-panel">
                            <h3 class="dm-admin-panel-title">@SL["TopProducts"]</h3>
                            <div class="dm-admin-panel-sub">@Tr("meilleures performances par quantite et revenu", "best performers by quantity and revenue")</div>
                            <MudTable T="TopProductRow" Items="_topProducts" Dense="true">
                                <HeaderContent>
                                    <MudTh>@SL["Product"]</MudTh>
                                    <MudTh>@SL["Qty"]</MudTh>
                                    <MudTh Align="Align.Right">@SL["Revenue"]</MudTh>
                                </HeaderContent>
                                <RowTemplate Context="p">
                                    <MudTd>@p.Name</MudTd>
                                    <MudTd>@p.QtySold</MudTd>
                                    <MudTd Align="Align.Right">@Fmt(p.RevenueItems)</MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudPaper Class="pa-3 dm-admin-panel dm-panel">
                            <h3 class="dm-admin-panel-title">@SL["TopShops"]</h3>
                            <div class="dm-admin-panel-sub">@Tr("classement boutiques par volume de commandes", "shop ranking by order volume")</div>
                            <MudTable T="TopShopRow" Items="_topShops" Dense="true">
                                <HeaderContent>
                                    <MudTh>@SL["Shop"]</MudTh>
                                    <MudTh>@SL["Orders"]</MudTh>
                                    <MudTh Align="Align.Right">@SL["Revenue"]</MudTh>
                                </HeaderContent>
                                <RowTemplate Context="s">
                                    <MudTd>@s.Name</MudTd>
                                    <MudTd>@s.OrdersCount</MudTd>
                                    <MudTd Align="Align.Right">@Fmt(s.GrossSalesItems)</MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudPaper Class="pa-3 dm-admin-panel dm-panel">
                            <h3 class="dm-admin-panel-title">@SL["TopCategories"]</h3>
                            <div class="dm-admin-panel-sub">@Tr("vue d'ensemble de la demande par categorie", "category demand overview")</div>
                            <MudTable T="TopCategoryRow" Items="_topCategories" Dense="true">
                                <HeaderContent>
                                    <MudTh>@SL["Category"]</MudTh>
                                    <MudTh>@SL["Qty"]</MudTh>
                                    <MudTh Align="Align.Right">@SL["Revenue"]</MudTh>
                                </HeaderContent>
                                <RowTemplate Context="c">
                                    <MudTd>@c.Name</MudTd>
                                    <MudTd>@c.QtySold</MudTd>
                                    <MudTd Align="Align.Right">@Fmt(c.RevenueItems)</MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                @if (_ops is not null)
                {
                    <MudGrid Class="mt-4" Spacing="2">
                        <MudItem xs="12">
                            <MudPaper Class="pa-3 dm-admin-panel dm-panel">
                                <h3 class="dm-admin-panel-title">@Tr("Instantane operations (24h)", "Operations Snapshot (last 24h)")</h3>
                                <div class="dm-admin-panel-sub">@Tr("conversion, risque d'execution et backlog financier", "conversion, fulfillment risk and finance backlog")</div>
                                <div class="dm-ops-grid mt-3">
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Commandes creees", "Orders created")</div>
                                        <div class="dm-ops-value">@_ops.OrdersCreated</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Commandes payees", "Orders paid")</div>
                                        <div class="dm-ops-value">@_ops.OrdersPaid</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Conversion checkout", "Checkout conversion")</div>
                                        <div class="dm-ops-value">@Fmt(_ops.CheckoutUserConversionRate)%</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Paiements echoues", "Payments failed")</div>
                                        <div class="dm-ops-value">@_ops.OrdersFailed</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Backlog des paiements boutiques", "Payout backlog")</div>
                                        <div class="dm-ops-value">@_ops.PayoutBacklogCount</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Montant backlog", "Backlog amount")</div>
                                        <div class="dm-ops-value">@Fmt(_ops.PayoutBacklogAmount)</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Paniers inactifs", "Stale carts")</div>
                                        <div class="dm-ops-value">@_ops.StaleCarts</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Stock bas/rupture", "Low/out of stock")</div>
                                        <div class="dm-ops-value">@(_ops.ActiveProductsLowStock + _ops.ActiveProductsOutOfStock)</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Echecs notifications (24h)", "Notification failures (24h)")</div>
                                        <div class="dm-ops-value">@_ops.NotificationFailedInWindow</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Echecs notifications non resolus", "Unresolved notification failures")</div>
                                        <div class="dm-ops-value">@_ops.NotificationFailedUnresolved</div>
                                    </div>
                                </div>
                                @if (_ops.NotificationFailedUnresolved > 0)
                                {
                                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
                                        <div class="d-flex flex-wrap justify-space-between align-center gap-2">
                                            <span>@($"{_ops.NotificationFailedUnresolved} {Tr("echecs de notifications transactionnelles non resolus necessitent une action.", "unresolved transactional notification failures need attention.")}")</span>
                                            <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="OpenNotificationCenter">
                                                @Tr("Ouvrir les notifications", "Open notifications")
                                            </MudButton>
                                        </div>
                                    </MudAlert>
                                }
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                }

                @if (_cartRecovery is not null)
                {
                    <MudGrid Class="mt-4" Spacing="2">
                        <MudItem xs="12">
                            <MudPaper Class="pa-3 dm-admin-panel dm-panel">
                                <h3 class="dm-admin-panel-title">@Tr("Resume relance panier", "Cart Recovery Snapshot")</h3>
                                <div class="dm-admin-panel-sub">@Tr("relances paniers abandonnes, uplift conversion et fiabilite", "abandoned cart reminders, conversion uplift and reliability")</div>
                                <div class="dm-ops-grid mt-3">
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Detectes", "Detected")</div>
                                        <div class="dm-ops-value">@_cartRecovery.DetectedEvents</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Envoyes", "Sent")</div>
                                        <div class="dm-ops-value">@_cartRecovery.RemindersSent</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Taux conversion", "Conversion rate")</div>
                                        <div class="dm-ops-value">@Fmt(_cartRecovery.ConversionRatePct)%</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Uplift A/B", "A/B uplift")</div>
                                        <div class="dm-ops-value">@Fmt(_cartRecovery.UpliftPct)%</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">Job p95</div>
                                        <div class="dm-ops-value">@($"{_cartRecovery.JobLatencyP95Ms ?? 0} ms")</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Echecs SMTP/Push", "SMTP/Push failures")</div>
                                        <div class="dm-ops-value">@($"{_cartRecovery.SmtpFailures}/{_cartRecovery.PushFailures}")</div>
                                    </div>
                                </div>
                                <MudButton Variant="Variant.Outlined" Class="mt-3" OnClick="OpenCartRecovery">
                                    @Tr("Ouvrir le dashboard relance panier", "Open cart recovery dashboard")
                                </MudButton>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                }

                @if (_conversionFunnel is not null)
                {
                    <MudGrid Class="mt-4" Spacing="2">
                        <MudItem xs="12">
                            <MudPaper Class="pa-3 dm-admin-panel dm-panel">
                                <h3 class="dm-admin-panel-title">@Tr("Tunnel de conversion", "Conversion Funnel")</h3>
                                <div class="dm-admin-panel-sub">@Tr("visiteurs -> recherche -> clic -> panier -> checkout -> paye", "visitors -> search -> click -> cart -> checkout -> paid")</div>
                                <div class="dm-ops-grid mt-3">
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Visiteurs", "Visitors")</div>
                                        <div class="dm-ops-value">@_conversionFunnel.Visitors</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Recherches", "Searches")</div>
                                        <div class="dm-ops-value">@_conversionFunnel.Searches</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Clics produits", "Product clicks")</div>
                                        <div class="dm-ops-value">@_conversionFunnel.ProductClicks</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Utilisateurs panier", "Cart users")</div>
                                        <div class="dm-ops-value">@_conversionFunnel.CartUsers</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Checkouts", "Checkouts")</div>
                                        <div class="dm-ops-value">@_conversionFunnel.Checkouts</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Commandes payees", "Paid orders")</div>
                                        <div class="dm-ops-value">@_conversionFunnel.PaidOrders</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Taux recherche", "Search rate")</div>
                                        <div class="dm-ops-value">@Fmt(_conversionFunnel.VisitorToSearchRate)%</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Taux clic", "Click rate")</div>
                                        <div class="dm-ops-value">@Fmt(_conversionFunnel.SearchToClickRate)%</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Taux checkout", "Checkout rate")</div>
                                        <div class="dm-ops-value">@Fmt(_conversionFunnel.CartToCheckoutRate)%</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Taux paye", "Paid rate")</div>
                                        <div class="dm-ops-value">@Fmt(_conversionFunnel.CheckoutToPaidRate)%</div>
                                    </div>
                                </div>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                }

                @if (_campaignRoi.Count > 0)
                {
                    <MudGrid Class="mt-4" Spacing="2">
                        <MudItem xs="12">
                            <MudPaper Class="pa-3 dm-admin-panel dm-panel">
                                <h3 class="dm-admin-panel-title">@Tr("ROI campagnes", "Campaign ROI")</h3>
                                <div class="dm-admin-panel-sub">@Tr("revenu attribue vs cout remise par campagne", "attributed revenue vs discount cost by run")</div>
                                <MudTable T="CampaignRoiRow" Items="_campaignRoi.Take(10)" Dense="true" Hover="true" Bordered="true" Striped="true">
                                    <HeaderContent>
                                        <MudTh>@Tr("Campagne", "Campaign")</MudTh>
                                        <MudTh>@Tr("Cible", "Target")</MudTh>
                                        <MudTh>@Tr("Envoyes", "Sent")</MudTh>
                                        <MudTh Align="Align.Right">@Tr("Revenu", "Revenue")</MudTh>
                                        <MudTh Align="Align.Right">@Tr("Cout", "Cost")</MudTh>
                                        <MudTh Align="Align.Right">ROI</MudTh>
                                    </HeaderContent>
                                    <RowTemplate Context="r">
                                        <MudTd>@r.CampaignName</MudTd>
                                        <MudTd>@r.TargetUsers</MudTd>
                                        <MudTd>@r.SentCount</MudTd>
                                        <MudTd Align="Align.Right">@Fmt(r.RevenueAttributed)</MudTd>
                                        <MudTd Align="Align.Right">@Fmt(r.DiscountCost)</MudTd>
                                        <MudTd Align="Align.Right">@Fmt(r.RoiPercent)%</MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                }

                @if (_checkoutSnapshot is not null)
                {
                    <MudGrid Class="mt-4" Spacing="2">
                        <MudItem xs="12">
                            <MudPaper Class="pa-3 dm-admin-panel dm-panel">
                                <h3 class="dm-admin-panel-title">@Tr("Observabilite checkout temps reel", "Checkout Real-Time Observability")</h3>
                                <div class="dm-admin-panel-sub">@Tr("qualite paiement, abandons checkout et sante UX A/B", "payment quality, checkout drop-offs and A/B UX health")</div>
                                <div class="dm-ops-grid mt-3">
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Vues checkout", "Checkout views")</div>
                                        <div class="dm-ops-value">@_checkoutSnapshot.CheckoutViews</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Clics soumettre", "Submit clicks")</div>
                                        <div class="dm-ops-value">@_checkoutSnapshot.SubmitClicks</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Commandes creees", "Orders created")</div>
                                        <div class="dm-ops-value">@_checkoutSnapshot.OrdersCreated</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Paiements inities", "Payments initiated")</div>
                                        <div class="dm-ops-value">@_checkoutSnapshot.PaymentsInitiated</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Paiements confirmes", "Payments confirmed")</div>
                                        <div class="dm-ops-value">@_checkoutSnapshot.PaymentsConfirmed</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Paiements echoues", "Payments failed")</div>
                                        <div class="dm-ops-value">@_checkoutSnapshot.PaymentsFailed</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Taux succes paiement", "Payment success rate")</div>
                                        <div class="dm-ops-value">@Fmt(_checkoutSnapshot.PaymentSuccessRate)%</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Taux soumettre vers commande", "Submit to order rate")</div>
                                        <div class="dm-ops-value">@Fmt(_checkoutSnapshot.SubmitToOrderRate)%</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Latence p50/p95", "Latency p50/p95")</div>
                                        <div class="dm-ops-value">@($"{_checkoutSnapshot.LatencyP50Ms ?? 0} / {_checkoutSnapshot.LatencyP95Ms ?? 0} ms")</div>
                                    </div>
                                    <div class="dm-ops-card">
                                        <div class="dm-ops-label">@Tr("Alertes actives", "Active alerts")</div>
                                        <div class="dm-ops-value">@_checkoutSnapshot.AlertsCount</div>
                                    </div>
                                </div>

                                @if (_checkoutSloStatus is not null)
                                {
                                    <MudAlert Severity="@GetCheckoutSloSeverity(_checkoutSloStatus)" Variant="Variant.Outlined" Class="mt-3">
                                        <strong>@Tr("Etat SLO paiement", "Payment SLO status"):</strong>
                                        @($" {Fmt(_checkoutSloStatus.CurrentPaymentSuccessRatePct)}% / seuil warning {Fmt(_checkoutSloStatus.PaymentSuccessWarningThresholdPct)}% | p95 {(_checkoutSloStatus.CurrentPaymentLatencyP95Ms ?? 0)}ms / seuil {_checkoutSloStatus.PaymentLatencyP95WarningMs}ms")
                                        @if (_checkoutSloStatus.TriggeredAlertCodes.Count > 0)
                                        {
                                            <div class="mt-1">
                                                @Tr("Alertes declenchees", "Triggered alerts"): @string.Join(", ", _checkoutSloStatus.TriggeredAlertCodes.Take(6))
                                            </div>
                                        }
                                    </MudAlert>
                                }

                                @if (_checkoutProdDashboard is not null)
                                {
                                    <MudText Typo="Typo.subtitle1" Class="mt-4">@Tr("Observabilite production", "Production observability")</MudText>
                                    <div class="dm-ops-grid mt-2">
                                        <div class="dm-ops-card">
                                            <div class="dm-ops-label">@Tr("Echecs checkout", "Checkout failures")</div>
                                            <div class="dm-ops-value">@_checkoutProdDashboard.Errors.FailureEvents</div>
                                        </div>
                                        <div class="dm-ops-card">
                                            <div class="dm-ops-label">@Tr("Taux echec checkout", "Checkout failure rate")</div>
                                            <div class="dm-ops-value">@Fmt(_checkoutProdDashboard.Errors.FailureRatePercent)%</div>
                                        </div>
                                        <div class="dm-ops-card">
                                            <div class="dm-ops-label">@Tr("Proxy erreurs 5xx", "5xx error proxy")</div>
                                            <div class="dm-ops-value">@_checkoutProdDashboard.Errors.ServerErrorProxyCount</div>
                                        </div>
                                        <div class="dm-ops-card">
                                            <div class="dm-ops-label">@Tr("Taux proxy 5xx", "5xx proxy rate")</div>
                                            <div class="dm-ops-value">@Fmt(_checkoutProdDashboard.Errors.ServerErrorProxyRatePercent)%</div>
                                        </div>
                                        <div class="dm-ops-card">
                                            <div class="dm-ops-label">@Tr("Backlog queue (approx)", "Queue backlog (approx)")</div>
                                            <div class="dm-ops-value">@_checkoutProdDashboard.Queue.QueueBacklogApprox</div>
                                        </div>
                                        <div class="dm-ops-card">
                                            <div class="dm-ops-label">@Tr("Incidents checkout ouverts", "Open checkout incidents")</div>
                                            <div class="dm-ops-value">@_checkoutProdDashboard.Queue.OpenCheckoutIncidents</div>
                                        </div>
                                        <div class="dm-ops-card">
                                            <div class="dm-ops-label">@Tr("Paniers abandonnes pending", "Pending abandoned carts")</div>
                                            <div class="dm-ops-value">@_checkoutProdDashboard.Queue.PendingAbandonedCarts</div>
                                        </div>
                                        <div class="dm-ops-card">
                                            <div class="dm-ops-label">@Tr("Notifications failed", "Failed notifications")</div>
