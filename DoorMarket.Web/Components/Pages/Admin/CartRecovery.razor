@page "/admin/cart-recovery"
@using System.Net.Http.Json
@using MudBlazor
@inject HttpClient Http
@inject DoorMarket.Web.Auth.AuthState Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<h1 class="dm-page-h1">@Tr("Relance panier", "Cart Recovery")</h1>
<div class="dm-page-sub">@Tr("Detection, relances, uplift de conversion et performance du job", "Detection, reminders, conversion uplift and job performance")</div>

<AuthGuard>
    @if (!_ready)
    {
        <MudPaper Class="pa-4 mt-3 dm-content-card">
            <MudSkeleton Height="24px" Width="220px" />
            <MudSkeleton Height="120px" Class="mt-2" />
        </MudPaper>
    }
    else if (!Auth.IsAdmin)
    {
        <MudPaper Class="pa-4 mt-3 dm-content-card">
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@Tr("Acces admin uniquement.", "Admin only access.")</MudAlert>
            <MudButton Variant="Variant.Outlined" Class="mt-3" OnClick="@(() => Nav.NavigateTo("/"))">@Tr("Retour", "Back")</MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4 mt-3 dm-content-card">
            <div class="d-flex flex-wrap gap-2 align-items-end">
                <MudDatePicker Label="@Tr("Du", "From")" @bind-Date="_from" Variant="Variant.Outlined" />
                <MudDatePicker Label="@Tr("Au", "To")" @bind-Date="_to" Variant="Variant.Outlined" />
                <MudSelect T="int" Label="@Tr("Fenetre conversion (h)", "Conversion window (h)")" @bind-Value="_conversionWindowHours" Variant="Variant.Outlined">
                    <MudSelectItem T="int" Value="24">24</MudSelectItem>
                    <MudSelectItem T="int" Value="72">72</MudSelectItem>
                    <MudSelectItem T="int" Value="168">168</MudSelectItem>
                    <MudSelectItem T="int" Value="336">336</MudSelectItem>
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Reload">@Tr("Appliquer", "Apply")</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="_runningNow" OnClick="RunNowAsync">
                    @(_runningNow ? Tr("Execution...", "Running...") : Tr("Executer", "Run now"))
                </MudButton>
            </div>

            <MudDivider Class="my-3" />

            @if (_loading)
            {
                <MudSkeleton Height="120px" />
            }
            else if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
            }
            else if (_summary is not null)
            {
                <MudGrid>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-3 dm-kpi-card dm-admin-kpi-card">
                            <MudText Class="dm-kpi-label">@Tr("Evenements detectes", "Detected events")</MudText>
                            <MudText Class="dm-kpi-value">@_summary.DetectedEvents</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-3 dm-kpi-card dm-admin-kpi-card dm-kpi-tone-success">
                            <MudText Class="dm-kpi-label">@Tr("Relances envoyees", "Reminders sent")</MudText>
                            <MudText Class="dm-kpi-value">@_summary.RemindersSent</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-3 dm-kpi-card dm-admin-kpi-card dm-kpi-tone-danger">
                            <MudText Class="dm-kpi-label">@Tr("Relances en echec", "Reminders failed")</MudText>
                            <MudText Class="dm-kpi-value">@_summary.RemindersFailed</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-3 dm-kpi-card dm-admin-kpi-card">
                            <MudText Class="dm-kpi-label">@Tr("Relances ignorees", "Reminders skipped")</MudText>
                            <MudText Class="dm-kpi-value">@_summary.RemindersSkipped</MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-3 dm-kpi-card dm-admin-kpi-card">
                            <MudText Class="dm-kpi-label">@Tr("Taux conversion", "Conversion rate")</MudText>
                            <MudText Class="dm-kpi-value">@Fmt(_summary.ConversionRatePct)%</MudText>
                            <MudText Class="dm-kpi-meta">@Tr($"{_summary.ConvertedEvents} convertis", $"{_summary.ConvertedEvents} converted")</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-3 dm-kpi-card dm-admin-kpi-card">
                            <MudText Class="dm-kpi-label">@Tr("Taux reprise", "Resume rate")</MudText>
                            <MudText Class="dm-kpi-value">@Fmt(_summary.ResumeRatePct)%</MudText>
                            <MudText Class="dm-kpi-meta">@Tr($"{_summary.ResumedEvents} repris", $"{_summary.ResumedEvents} resumed")</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-3 dm-kpi-card dm-admin-kpi-card dm-kpi-tone-success">
                            <MudText Class="dm-kpi-label">@Tr("Uplift A/B", "A/B uplift")</MudText>
                            <MudText Class="dm-kpi-value">@Fmt(_summary.UpliftPct)%</MudText>
                            <MudText Class="dm-kpi-meta">@($"A={Fmt(_summary.GroupAConversionRatePct)}% / B={Fmt(_summary.GroupBConversionRatePct)}%")</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-3 dm-kpi-card dm-admin-kpi-card">
                            <MudText Class="dm-kpi-label">@Tr("Latence job p50/p95", "Job latency p50/p95")</MudText>
                            <MudText Class="dm-kpi-value">@($"{_summary.JobLatencyP50Ms ?? 0} / {_summary.JobLatencyP95Ms ?? 0} ms")</MudText>
                            <MudText Class="dm-kpi-meta">@Tr($"exec={_summary.JobRunsCount}, echec={_summary.JobRunsFailureCount}", $"runs={_summary.JobRunsCount}, fail={_summary.JobRunsFailureCount}")</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-3 dm-kpi-card dm-admin-kpi-card dm-kpi-tone-danger">
                            <MudText Class="dm-kpi-label">@Tr("Echecs SMTP", "SMTP failures")</MudText>
                            <MudText Class="dm-kpi-value">@_summary.SmtpFailures</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-3 dm-kpi-card dm-admin-kpi-card dm-kpi-tone-danger">
                            <MudText Class="dm-kpi-label">@Tr("Echecs push", "Push failures")</MudText>
                            <MudText Class="dm-kpi-value">@_summary.PushFailures</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-4" />
                <MudText Typo="Typo.h6">@Tr("Evenements recents", "Recent events")</MudText>
                <MudTable T="CartRecoveryEventRow" Items="_events" Dense="true" Hover="true" Class="mt-2">
                    <HeaderContent>
                        <MudTh>@Tr("Detecte le", "Detected")</MudTh>
                        <MudTh>@Tr("Groupe", "Group")</MudTh>
                        <MudTh>@Tr("Statut", "Status")</MudTh>
                        <MudTh>@Tr("Articles", "Items")</MudTh>
                        <MudTh>@Tr("Sous-total", "Subtotal")</MudTh>
                        <MudTh>@Tr("Repris", "Resumed")</MudTh>
                        <MudTh>@Tr("Converti", "Converted")</MudTh>
                        <MudTh>@Tr("Canaux", "Channels")</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="row">
                        <MudTd>@row.DetectedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                        <MudTd>@row.ExperimentGroup</MudTd>
                        <MudTd>@row.ReminderStatus</MudTd>
                        <MudTd>@row.ItemCount</MudTd>
                        <MudTd>@($"{Fmt(row.Subtotal)} {row.Currency}")</MudTd>
                        <MudTd>@(row.Resumed ? Tr("Oui", "Yes") : Tr("Non", "No"))</MudTd>
                        <MudTd>@(row.Converted ? Tr("Oui", "Yes") : Tr("Non", "No"))</MudTd>
                        <MudTd>@(string.IsNullOrWhiteSpace(row.SentChannels) ? "-" : row.SentChannels)</MudTd>
                    </RowTemplate>
                </MudTable>

                <div class="d-flex justify-space-between mt-3">
                    <MudText Typo="Typo.caption">@($"{Tr("Total", "Total")}: {_total}")</MudText>
                    <div class="d-flex gap-2">
                        <MudButton Variant="Variant.Outlined" Disabled="@(_page <= 1 || _loading)" OnClick="PrevPage">@Tr("Prec", "Prev")</MudButton>
                        <MudButton Variant="Variant.Outlined" Disabled="@((_page * _pageSize) >= _total || _loading)" OnClick="NextPage">@Tr("Suiv", "Next")</MudButton>
                    </div>
                </div>
            }
        </MudPaper>
    }
</AuthGuard>

@code {
    private bool _ready;
    private bool _loading = true;
    private bool _runningNow;
    private string? _error;
    private DateTime? _from = DateTime.UtcNow.AddDays(-30);
    private DateTime? _to = DateTime.UtcNow;
    private int _conversionWindowHours = 168;

    private int _page = 1;
    private int _pageSize = 20;
    private int _total = 0;
    private CartRecoverySummary? _summary;
    private List<CartRecoveryEventRow> _events = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var t0 = DateTime.UtcNow;
        while (!Auth.IsReady && (DateTime.UtcNow - t0).TotalSeconds < 5)
            await Task.Delay(30);

        _ready = true;
        if (!Auth.IsAuthenticated || !Auth.IsAdmin)
        {
            StateHasChanged();
            return;
        }

        await LoadAsync();
        StateHasChanged();
    }

    private async Task Reload()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task PrevPage()
    {
        if (_page <= 1) return;
        _page--;
        await LoadAsync();
    }

    private async Task NextPage()
    {
        if ((_page * _pageSize) >= _total) return;
        _page++;
        await LoadAsync();
    }

    private async Task RunNowAsync()
    {
        _runningNow = true;
        try
        {
            var res = await Http.PostAsync("api/admin/cart-recovery/run-now", null);
            if (!res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadAsStringAsync();
                throw new InvalidOperationException(Tr($"Execution echouee ({(int)res.StatusCode}): {body}", $"Run failed ({(int)res.StatusCode}): {body}"));
            }

            Snackbar.Add(Tr("Job de relance panier execute.", "Cart recovery job executed."), Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _runningNow = false;
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var summaryUrl = $"api/admin/cart-recovery/summary?{BuildCommonQuery()}";
            var eventsUrl = $"api/admin/cart-recovery/events?{BuildCommonQuery()}&page={_page}&pageSize={_pageSize}";

            _summary = await GetJsonAsync<CartRecoverySummary>(summaryUrl);
            var eventsPage = await GetJsonAsync<CartRecoveryEventsPage>(eventsUrl);
            _events = eventsPage?.Items ?? new();
            _total = eventsPage?.Total ?? 0;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _summary = null;
            _events = new();
            _total = 0;
        }
        finally
        {
            _loading = false;
        }
    }

    private string BuildCommonQuery()
    {
        var items = new List<string>
        {
            $"conversionWindowHours={_conversionWindowHours}"
        };
        if (_from.HasValue)
        {
            items.Add($"fromUtc={Uri.EscapeDataString(_from.Value.ToUniversalTime().ToString("O"))}");
        }
        if (_to.HasValue)
        {
            items.Add($"toUtc={Uri.EscapeDataString(_to.Value.ToUniversalTime().ToString("O"))}");
        }

        return string.Join("&", items);
    }

    private async Task<T?> GetJsonAsync<T>(string url)
    {
        using var response = await Http.GetAsync(url);
        if (!response.IsSuccessStatusCode)
        {
            var body = await response.Content.ReadAsStringAsync();
            throw new InvalidOperationException($"API {(int)response.StatusCode}: {body}");
        }
        return await response.Content.ReadFromJsonAsync<T>();
    }

    private static string Fmt(decimal value) => value.ToString("0.##");

    private static string Tr(string fr, string en)
        => string.Equals(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, "en", StringComparison.OrdinalIgnoreCase) ? en : fr;

    private sealed record CartRecoverySummary(
        DateTime FromUtc,
        DateTime ToUtc,
        int DetectedEvents,
        int RemindersSent,
        int RemindersFailed,
        int RemindersSkipped,
        int ConvertedEvents,
        decimal ConversionRatePct,
        int ResumedEvents,
        decimal ResumeRatePct,
        int GroupAEvents,
        int GroupAConverted,
        decimal GroupAConversionRatePct,
        int GroupBEvents,
        int GroupBConverted,
        decimal GroupBConversionRatePct,
        decimal UpliftPct,
        int JobRunsCount,
        int JobRunsSuccessCount,
        int JobRunsFailureCount,
        int? JobLatencyP50Ms,
        int? JobLatencyP95Ms,
        int SmtpFailures,
        int PushFailures);

    private sealed record CartRecoveryEventsPage(
        int Page,
        int PageSize,
        int Total,
        List<CartRecoveryEventRow> Items);

    private sealed record CartRecoveryEventRow(
        Guid Id,
        Guid UserId,
        Guid CartId,
        string ExperimentGroup,
        string ReminderStatus,
        int ItemCount,
        decimal Subtotal,
        string Currency,
        DateTime DetectedAtUtc,
        DateTime LastCartActivityAtUtc,
        DateTime? ReminderSentAtUtc,
        string? SentChannels,
        int ReminderAttemptCount,
        string? Error,
        bool Resumed,
        bool Converted);
}
