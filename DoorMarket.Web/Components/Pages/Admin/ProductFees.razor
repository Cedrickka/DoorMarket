@page "/admin/product-fees"
@using System.Net
@using System.Net.Http.Json
@using MudBlazor
@inject HttpClient Http
@inject DoorMarket.Web.Auth.AuthState Auth
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> SL

<h1 class="dm-page-h1">@SL["AdminProductFees"]</h1>
<div class="dm-page-sub">@SL["AdminProductFeesSubtitle"]</div>

<AuthGuard>
    @if (!_ready)
    {
        <MudPaper Class="pa-4 mt-3">
            <MudSkeleton Height="32px" Width="220px" Class="mb-2" />
            <MudSkeleton Height="18px" Width="380px" />
        </MudPaper>
    }
    else if (!Auth.IsAdmin)
    {
        <MudPaper Class="pa-4 mt-3">
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@SL["AdminOnlyAccess"]</MudAlert>
            <MudButton Variant="Variant.Outlined" Class="mt-3" OnClick="@(() => Nav.NavigateTo("/"))">@SL["Back"]</MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-4 mt-3 dm-content-card">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <MudText Typo="Typo.h6">@SL["ProductFeesList"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@SL["TotalLabel"] @_total</MudText>
                </div>
                <MudTextField T="string"
                              Variant="Variant.Outlined"
                              Placeholder="@SL["Search"]"
                              Dense="true"
                              Immediate="true"
                              DebounceInterval="350"
                              Value="@_q"
                              ValueChanged="@(async (string v) => await OnSearchChanged(v))" />
            </div>

            <MudDivider Class="my-3" />
            <MudPaper Class="pa-3 mb-3 dm-content-card-soft">
                <MudText Typo="Typo.subtitle1" Class="mb-2">@Tr("Mise a jour commission en lot (page courante)", "Bulk commission update (current page)")</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="3">
                        <MudSelect T="string" Label="@Tr("Mode", "Mode")" Variant="Variant.Outlined" Dense="true" @bind-Value="_bulkMode">
                            <MudSelectItem T="string" Value="@("Flat")">@Tr("Fixe", "Flat")</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Percent")">@Tr("Pourcentage", "Percent")</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        @if (string.Equals(_bulkMode, "Percent", StringComparison.OrdinalIgnoreCase))
                        {
                            <MudNumericField T="decimal" Label="@Tr("Pourcentage", "Percent")" Variant="Variant.Outlined" Dense="true" @bind-Value="_bulkFeePercent" Min="@(0.01m)" Max="@(100m)" />
                        }
                        else
                        {
                            <MudNumericField T="decimal" Label="@Tr("Montant fixe", "Flat amount")" Variant="Variant.Outlined" Dense="true" @bind-Value="_bulkFeeAmount" Min="0m" />
                        }
                    </MudItem>
                    <MudItem xs="12" md="3" Class="d-flex align-items-center">
                        <MudSwitch T="bool" Color="Color.Primary" @bind-Checked="_bulkOnlyActive">@Tr("Produits actifs seulement", "Only active products")</MudSwitch>
                    </MudItem>
                    <MudItem xs="12" md="3" Class="d-flex align-items-center justify-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving || _items.Count == 0" OnClick="ApplyBulkFeeAsync">
                            @Tr($"Appliquer a {_items.Count} produit(s)", $"Apply to {_items.Count} product(s)")
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            @if (_loading)
            {
                <MudSkeleton Height="42px" />
                <MudSkeleton Height="42px" Class="mt-2" />
            }
            else if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
            }
            else if (_items.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@SL["NoProducts"]</MudAlert>
            }
            else
            {
                <MudTable T="AdminProductFeeRow" Items="_items" Dense="true" Hover="true" Bordered="true" Striped="true">
                    <HeaderContent>
                        <MudTh>@SL["Product"]</MudTh>
                        <MudTh>@SL["Shop"]</MudTh>
                        <MudTh>@SL["Price"]</MudTh>
                        <MudTh>@Tr("Mode frais", "Fee mode")</MudTh>
                        <MudTh>@Tr("Valeur frais", "Fee value")</MudTh>
                        <MudTh>@Tr("Frais effectif", "Effective fee")</MudTh>
                        <MudTh Align="Align.Right">@SL["Actions"]</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="p">
                        <MudTd>@p.Name</MudTd>
                        <MudTd>@p.ShopName</MudTd>
                        <MudTd>@Fmt(p.Price) @p.Currency</MudTd>
                        <MudTd>
                                <MudSelect T="string"
                                       Variant="Variant.Outlined"
                                       Dense="true"
                                       Value="@p.PlatformFeeMode"
                                       ValueChanged="@(v => OnFeeModeChanged(p, v))">
                                <MudSelectItem T="string" Value="@("Flat")">@Tr("Fixe", "Flat")</MudSelectItem>
                                <MudSelectItem T="string" Value="@("Percent")">@Tr("Pourcentage", "Percent")</MudSelectItem>
                            </MudSelect>
                        </MudTd>
                        <MudTd style="max-width: 180px;">
                            @if (string.Equals(p.PlatformFeeMode, "Percent", StringComparison.OrdinalIgnoreCase))
                            {
                                <MudNumericField T="decimal"
                                                 Variant="Variant.Outlined"
                                                 Dense="true"
                                                 Value="@(p.PlatformFeePercent ?? 0m)"
                                                 ValueChanged="@(v => { p.PlatformFeePercent = v; })"
                                                 Min="@(0.01m)"
                                                 Max="@(100m)" />
                            }
                            else
                            {
                                <MudNumericField T="decimal"
                                                 Variant="Variant.Outlined"
                                                 Dense="true"
                                                 Value="@p.PlatformFeeAmount"
                                                 ValueChanged="@(v => { p.PlatformFeeAmount = v; })"
                                                 Min="0m" />
                            }
                        </MudTd>
                        <MudTd>@Fmt(EffectiveFee(p)) @p.Currency</MudTd>
                        <MudTd Align="Align.Right">
                            <AdminRowActionMenu Disabled="_saving" AriaLabel="@SL["Actions"]">
                                <MudMenuItem Icon="@Icons.Material.Filled.Save"
                                             OnClick="@(() => SaveFee(p))">
                                    @SL["Save"]
                                </MudMenuItem>
                            </AdminRowActionMenu>
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                    <div class="dm-muted">@SL["PageLabel"] @_page / @TotalPages()</div>
                    <DmPager CurrentPage="_page" TotalPages="TotalPages()" OnPageChanged="OnPageChanged" />
                </div>
            }
        </MudPaper>
    }
</AuthGuard>

@code {
    private bool _ready;
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private int _page = 1;
    private int _pageSize = 20;
    private int _total;
    private string _q = string.Empty;
    private string _bulkMode = "Flat";
    private decimal _bulkFeeAmount;
    private decimal _bulkFeePercent = 1m;
    private bool _bulkOnlyActive = true;
    private List<AdminProductFeeRow> _items = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var t0 = DateTime.UtcNow;
        while (!Auth.IsReady && (DateTime.UtcNow - t0).TotalSeconds < 5)
            await Task.Delay(30);

        _ready = true;
        if (!Auth.IsAuthenticated || !Auth.IsAdmin)
        {
            StateHasChanged();
            return;
        }

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var url = $"api/admin/products/fees?page={_page}&pageSize={_pageSize}&q={Uri.EscapeDataString(_q ?? "")}";
            var res = await Http.GetFromJsonAsync<AdminProductFeesPaged>(url);
            _items = (res?.Items ?? new())
                .Select(CanonicalizeFeeRow)
                .ToList();
            _total = res?.Total ?? 0;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _items = new();
            _total = 0;
        }
        finally
        {
            _loading = false;
        }
    }

    private int TotalPages() => Math.Max(1, (int)Math.Ceiling(_total / (double)_pageSize));

    private async Task OnSearchChanged(string value)
    {
        _q = value ?? "";
        _page = 1;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task OnPageChanged(int page)
    {
        _page = Math.Clamp(page, 1, TotalPages());
        await LoadAsync();
        StateHasChanged();
    }

    private async Task SaveFee(AdminProductFeeRow row)
    {
        if (string.Equals(row.PlatformFeeMode, "Percent", StringComparison.OrdinalIgnoreCase))
        {
            if (!row.PlatformFeePercent.HasValue || row.PlatformFeePercent.Value <= 0m || row.PlatformFeePercent.Value > 100m)
            {
                Snackbar.Add(Tr("Valeur de pourcentage invalide.", "Invalid percent value."), Severity.Warning);
                return;
            }
        }
        else if (row.PlatformFeeAmount < 0m)
        {
            Snackbar.Add(SL["InvalidValue"], Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var res = await Http.PutAsJsonAsync(
                $"api/admin/products/{row.Id}/fee",
                new
                {
                    platformFeeMode = row.PlatformFeeMode,
                    platformFeeAmount = row.PlatformFeeAmount,
                    platformFeePercent = row.PlatformFeePercent
                });
            if (!res.IsSuccessStatusCode)
                throw await BuildApiError(res);

            Snackbar.Add(SL["Saved"], Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ApplyBulkFeeAsync()
    {
        if (_items.Count == 0)
        {
            Snackbar.Add(Tr("Aucun produit a mettre a jour sur cette page.", "No products to update on this page."), Severity.Warning);
            return;
        }

        if (string.Equals(_bulkMode, "Percent", StringComparison.OrdinalIgnoreCase))
        {
            if (_bulkFeePercent <= 0m || _bulkFeePercent > 100m)
            {
                Snackbar.Add(Tr("Valeur de pourcentage invalide pour la mise a jour en lot.", "Invalid percent value for bulk update."), Severity.Warning);
                return;
            }
        }
        else if (_bulkFeeAmount < 0m)
        {
            Snackbar.Add(Tr("Valeur fixe invalide pour la mise a jour en lot.", "Invalid flat value for bulk update."), Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            var payload = new
            {
                productIds = _items.Select(x => x.Id).ToList(),
                platformFeeMode = _bulkMode,
                platformFeeAmount = _bulkFeeAmount,
                platformFeePercent = _bulkFeePercent,
                onlyActive = _bulkOnlyActive
            };

            var res = await Http.PostAsJsonAsync("api/admin/products/fees/bulk-by-ids", payload);
            if (!res.IsSuccessStatusCode)
                throw await BuildApiError(res);

            Snackbar.Add(Tr("Mise a jour de commission en lot appliquee.", "Bulk commission update applied."), Severity.Success);
            await LoadAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task<Exception> BuildApiError(HttpResponseMessage res)
    {
        var body = await res.Content.ReadAsStringAsync();
        return res.StatusCode switch
        {
            HttpStatusCode.Unauthorized => new InvalidOperationException(SL["Non autorise (401)."]),
            HttpStatusCode.Forbidden => new InvalidOperationException(SL["Acces refuse (403). Admin requis."]),
            HttpStatusCode.NotFound => new InvalidOperationException(SL["Route introuvable (404)."]),
            HttpStatusCode.Conflict => new InvalidOperationException(string.IsNullOrWhiteSpace(body) ? SL["Conflit (409)."] : body),
            _ => new InvalidOperationException($"{SL["Erreur API"]} ({(int)res.StatusCode}) : {body}")
        };
    }

    private static string Fmt(decimal value) => value.ToString("0.##");

    private static string Tr(string fr, string en)
        => string.Equals(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, "en", StringComparison.OrdinalIgnoreCase) ? en : fr;

    private static decimal EffectiveFee(AdminProductFeeRow row)
    {
        if (string.Equals(row.PlatformFeeMode, "Percent", StringComparison.OrdinalIgnoreCase))
        {
            var percent = row.PlatformFeePercent ?? 0m;
            if (percent <= 0m)
            {
                return 0m;
            }

            return decimal.Round(row.Price * (percent / 100m), 2, MidpointRounding.AwayFromZero);
        }

        return decimal.Max(0m, row.PlatformFeeAmount);
    }

    private static void OnFeeModeChanged(AdminProductFeeRow row, string mode)
    {
        row.PlatformFeeMode = mode;
        if (string.Equals(mode, "Percent", StringComparison.OrdinalIgnoreCase))
        {
            row.PlatformFeePercent ??= 1m;
            row.PlatformFeeAmount = 0m;
        }
        else
        {
            row.PlatformFeePercent = null;
        }
    }

    private static AdminProductFeeRow CanonicalizeFeeRow(AdminProductFeeRow row)
    {
        var mode = string.Equals(row.PlatformFeeMode, "Percent", StringComparison.OrdinalIgnoreCase)
            ? "Percent"
            : "Flat";

        row.PlatformFeeMode = mode;
        if (mode == "Percent")
        {
            row.PlatformFeePercent ??= 1m;
            row.PlatformFeeAmount = 0m;
        }
        else
        {
            row.PlatformFeeAmount = decimal.Max(0m, row.PlatformFeeAmount);
            row.PlatformFeePercent = null;
        }

        return row;
    }

    private sealed class AdminProductFeeRow
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public Guid ShopId { get; set; }
        public string ShopName { get; set; } = "";
        public Guid CategoryId { get; set; }
        public string CategoryName { get; set; } = "";
        public decimal Price { get; set; }
        public string PlatformFeeMode { get; set; } = "Flat";
        public decimal PlatformFeeAmount { get; set; }
        public decimal? PlatformFeePercent { get; set; }
        public string Currency { get; set; } = "";
        public bool IsActive { get; set; }
    }

    private sealed record AdminProductFeesPaged(List<AdminProductFeeRow> Items, int Total, int Page, int PageSize);
}
