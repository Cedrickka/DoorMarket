@inject DoorMarket.Web.UI.SnackbarService Snack

@if (_visible)
{
    <div class="dm-snackbar dm-snackbar-@_type">
        @_message
    </div>
}

@code {
    private bool _visible;
    private string _message = "";
    private string _type = "info";

    protected override void OnInitialized()
    {
        Snack.OnShow += Show;
    }

    private async void Show(string msg, string type)
    {
        _message = msg;
        _type = type;
        _visible = true;
        await InvokeAsync(StateHasChanged);

        await Task.Delay(2500);

        _visible = false;
        await InvokeAsync(StateHasChanged);
    }
}

