    private async Task StartMobileMoneyAsync(Guid orderId)
    {
        var provider = string.IsNullOrWhiteSpace(_model.MobileMoneyProvider)
            ? "AIRTEL"
            : _model.MobileMoneyProvider.Trim().ToUpperInvariant();
        var phone = NormalizePhone(_model.MobileMoneyPhone);

        var initRes = await Http.PostAsJsonAsync(
            "api/payments/mobile-money/initiate",
            new MobileMoneyInitiateRequest(orderId, provider, phone, null));
        if (!initRes.IsSuccessStatusCode)
        {
            var body = await initRes.Content.ReadAsStringAsync();
            await TrackCheckoutEventSafeAsync(
                eventName: "checkout_payment_initiation_failed",
                orderId: orderId,
                paymentProvider: provider,
                paymentChannel: "MobileMoney",
                success: false,
                errorCode: $"http_{(int)initRes.StatusCode}",
                errorMessage: body);
            throw new InvalidOperationException(WebErrorUx.FromApiBody(
                initRes.StatusCode,
                body,
                SL,
                "Initiation Mobile Money impossible.",
                "Unable to initiate Mobile Money payment."));
        }

        var init = await initRes.Content.ReadFromJsonAsync<MobileMoneyInitiateResponse>();
        if (init is null)
        {
            throw new InvalidOperationException("Reponse Mobile Money invalide.");
        }

        if (!string.IsNullOrWhiteSpace(init.CheckoutUrl))
        {
            await TrackCheckoutEventSafeAsync(
                eventName: "checkout_payment_redirect_opened",
                orderId: orderId,
                paymentProvider: provider,
                paymentChannel: "MobileMoney",
                success: true,
                metadata: new { init.TransactionId });
            Nav.NavigateTo(init.CheckoutUrl, forceLoad: true);
            return;
        }

        if (string.IsNullOrWhiteSpace(init.TransactionId))
        {
            Snackbar.ShowWarning("Paiement Mobile Money initie. Confirmez dans le detail commande.");
            return;
        }

        var confirmRes = await Http.PostAsJsonAsync(
            "api/payments/mobile-money/confirm",
            new MobileMoneyConfirmRequest(orderId, provider, init.TransactionId));
        if (!confirmRes.IsSuccessStatusCode)
        {
            var body = await confirmRes.Content.ReadAsStringAsync();
            await TrackCheckoutEventSafeAsync(
                eventName: "checkout_payment_failed",
                orderId: orderId,
                paymentProvider: provider,
                paymentChannel: "MobileMoney",
                success: false,
                errorCode: $"http_{(int)confirmRes.StatusCode}",
                errorMessage: body);
            throw new InvalidOperationException(WebErrorUx.FromApiBody(
                confirmRes.StatusCode,
                body,
                SL,
                "Confirmation Mobile Money impossible.",
                "Unable to confirm Mobile Money payment."));
        }

        var confirm = await confirmRes.Content.ReadFromJsonAsync<MobileMoneyConfirmResponse>();
        if (confirm is not null)
        {
            await TrackCheckoutEventSafeAsync(
                eventName: confirm.Paid ? "checkout_payment_confirmed" : "checkout_payment_failed",
                orderId: orderId,
                paymentProvider: provider,
                paymentChannel: "MobileMoney",
                success: confirm.Paid,
                errorCode: confirm.Paid ? null : confirm.PaymentStatus,
                errorMessage: confirm.Paid ? null : confirm.Message);
        }
        if (confirm is not null && !string.IsNullOrWhiteSpace(confirm.Message))
        {
            if (confirm.Paid)
            {
                Snackbar.ShowSuccess(confirm.Message);
            }
            else
            {
                Snackbar.ShowWarning(confirm.Message);
            }
        }
    }

    private async Task PayWithPrepaidAsync(Guid orderId)
    {
        var payload = new PrepaidPayRequest(orderId, NormalizePrepaidPayload(_model.PrepaidCardCode));
        var payRes = await Http.PostAsJsonAsync("api/payments/prepaid/pay", payload);
        if (!payRes.IsSuccessStatusCode)
        {
            var body = await payRes.Content.ReadAsStringAsync();
            throw new InvalidOperationException(WebErrorUx.FromApiBody(
                payRes.StatusCode,
                body,
                SL,
                SL["PrepaidPaymentFailed"],
                SL["PrepaidPaymentFailed"]));
        }

        var result = await payRes.Content.ReadFromJsonAsync<PrepaidPayResponse>();
        if (result is not null && !string.IsNullOrWhiteSpace(result.Message))
        {
            Snackbar.ShowSuccess(result.Message);
        }
    }

    private static string NormalizePrepaidPayload(string? value)
    {
        return (value ?? string.Empty).Trim().ToUpperInvariant().Replace(" ", string.Empty, StringComparison.Ordinal);
    }

    private static string NormalizePhone(string? value)
    {
        return (value ?? string.Empty)
            .Trim()
            .Replace(" ", string.Empty, StringComparison.Ordinal)
            .Replace("-", string.Empty, StringComparison.Ordinal)
            .Replace("(", string.Empty, StringComparison.Ordinal)
            .Replace(")", string.Empty, StringComparison.Ordinal);
    }

    private static bool IsValidPrepaidInput(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var normalized = value.Trim().ToUpperInvariant();
        if (!normalized.StartsWith("DM-", StringComparison.Ordinal))
        {
            return false;
        }

        if (normalized.Length < 8 || normalized.Length > 40)
        {
            return false;
        }

        return normalized.All(c => char.IsLetterOrDigit(c) || c == '-');
    }

    private async Task RefreshDeliveryQuoteAsync()
    {
        if (_cart is null || _cart.Items.Count == 0)
        {
            _deliveryFee = 0m;
            return;
        }

        if (!_selectedZoneId.HasValue)
        {
            _deliveryFee = 0m;
            StateHasChanged();
            return;
        }

        try
        {
            var quote = await Http.GetFromJsonAsync<DeliveryQuoteDto>(
                $"api/delivery/quote?subtotal={_cart.Subtotal}&currency={_cart.Currency}&zoneId={_selectedZoneId.Value}");

            if (quote is not null)
            {
                _deliveryFee = quote.DeliveryFee;
                _deliveryCurrency = string.IsNullOrWhiteSpace(quote.Currency) ? _cart.Currency : quote.Currency;
                StateHasChanged();
            }
        }
        catch
        {
            _deliveryFee = 0m;
        }
    }

    private async Task RefreshCouponValidationAsync(bool force = false)
    {
        if (_cart is null || _cart.Items.Count == 0)
        {
            _couponValidation = null;
            return;
        }

        var code = (_model.PromoCode ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(code))
        {
            _couponValidation = null;
            StateHasChanged();
            return;
        }

        if (!force &&
            _couponValidation is not null &&
            string.Equals(
                NormalizeCouponCode(_couponValidation.PromoCode),
                NormalizeCouponCode(code),
                StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _validatingCoupon = true;
        try
        {
            _couponValidation = await CartApi.ValidateCouponAsync(
                new CouponValidationRequest(
                    Code: code,
                    DeliveryZoneId: _selectedZoneId,
                    RequireDeliveryZone: false));
        }
        catch (Exception ex)
        {
            _couponValidation = new CouponValidationDto(
                IsReady: false,
                PromoCode: null,
                Applied: false,
                Message: WebErrorUx.ForException(
                    ex,
                    SL,
                    "Validation du coupon impossible.",
                    "Unable to validate coupon."),
                Currency: _deliveryCurrency,
                ItemCount: _cart.Items.Count,
                Subtotal: _cart.Subtotal,
                Discount: 0m,
                DeliveryFee: _deliveryFee,
                TotalEstimate: ComputeEstimatedTotal(),
                BlockingIssues: Array.Empty<CheckoutIssueDto>(),
                Warnings: Array.Empty<CheckoutIssueDto>());
        }
        finally
        {
            _validatingCoupon = false;
        }

        StateHasChanged();
    }

    private Color PromoFeedbackColor()
    {
        if (_couponValidation is null)
        {
            return Color.Secondary;
        }

        if (_couponValidation.Applied)
        {
            return Color.Success;
        }

        if (_couponValidation.Warnings.Count > 0)
        {
            return Color.Warning;
        }

        return Color.Error;
    }

    private static string NormalizeCouponCode(string? value)
        => (value ?? string.Empty).Trim().ToUpperInvariant();

    private static string ResolvePaymentChannel(string? provider)
    {
        var normalized = (provider ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return "Unknown";
        }

        if (string.Equals(normalized, "Stripe", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(normalized, "PayPal", StringComparison.OrdinalIgnoreCase))
        {
            return "External";
        }

        if (string.Equals(normalized, "MobileMoney", StringComparison.OrdinalIgnoreCase))
        {
            return "MobileMoney";
        }

        if (string.Equals(normalized, "PrepaidCard", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(normalized, "PrepaidInternal", StringComparison.OrdinalIgnoreCase))
        {
            return "Prepaid";
        }

        return normalized;
    }

    private async Task EnsureCheckoutTrackingContextAsync()
    {
        if (_checkoutTrackingReady)
        {
            _checkoutSessionId ??= Guid.NewGuid().ToString("N");
            _checkoutExperimentGroup ??= "A";
            return;
        }

        _checkoutTrackingReady = true;
        try
        {
            var existingSession = await SessionStorage.GetItemAsync<string>(CheckoutAnalyticsSessionStorageKey);
            if (string.IsNullOrWhiteSpace(existingSession))
            {
                existingSession = Guid.NewGuid().ToString("N");
                await SessionStorage.SetItemAsync(CheckoutAnalyticsSessionStorageKey, existingSession);
            }
            _checkoutSessionId = existingSession;

            var existingGroup = await SessionStorage.GetItemAsync<string>(CheckoutExperimentGroupStorageKey);
            if (string.IsNullOrWhiteSpace(existingGroup) ||
                (!string.Equals(existingGroup, "A", StringComparison.OrdinalIgnoreCase) &&
                 !string.Equals(existingGroup, "B", StringComparison.OrdinalIgnoreCase)))
            {
                existingGroup = (Random.Shared.Next(0, 2) == 0) ? "A" : "B";
                await SessionStorage.SetItemAsync(CheckoutExperimentGroupStorageKey, existingGroup);
            }

            _checkoutExperimentGroup = existingGroup.ToUpperInvariant();
        }
        catch
        {
            _checkoutSessionId ??= Guid.NewGuid().ToString("N");
            _checkoutExperimentGroup ??= (Random.Shared.Next(0, 2) == 0) ? "A" : "B";
        }
    }

    private async Task TrackCheckoutEventSafeAsync(
        string eventName,
        Guid? orderId = null,
        string? paymentProvider = null,
        string? paymentChannel = null,
        bool? success = null,
        int? durationMs = null,
        string? errorCode = null,
        string? errorMessage = null,
        object? metadata = null)
    {
        try
        {
            await EnsureCheckoutTrackingContextAsync();
            await Http.PostAsJsonAsync(
                "api/checkout/analytics/track",
                new CheckoutAnalyticsEventRequest(
                    EventName: eventName,
                    OrderId: orderId,
                    SessionId: _checkoutSessionId,
                    PaymentProvider: paymentProvider,
                    PaymentChannel: paymentChannel,
                    ExperimentName: CheckoutExperimentName,
                    ExperimentGroup: _checkoutExperimentGroup,
                    Success: success,
                    DurationMs: durationMs,
                    ErrorCode: errorCode,
                    ErrorMessage: errorMessage,
                    Source: "Web",
                    CountryTag: null,
                    Metadata: metadata));
        }
        catch
        {
            // Tracking must not break checkout flow.
        }
    }

