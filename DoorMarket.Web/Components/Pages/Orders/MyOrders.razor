@page "/orders"

@using System.Net.Http.Json
@using MudBlazor
@inject HttpClient Http
@inject NavigationManager Nav
@inject DoorMarket.Web.Auth.AuthState Auth
@inject ISnackbar Snackbar

<PageTitle>@SL["MyOrders"]</PageTitle>

<h1 class="dm-page-h1">@SL["MyOrders"]</h1>
<div class="dm-page-sub">@SL["MyOrdersSubtitle"]</div>

<AuthGuard>
    @if (!_bootstrapped)
    {
        <MudPaper Class="pa-4 mt-3 dm-content-card">
            <MudSkeleton Height="26px" Width="220px" Class="mb-2" />
            <MudSkeleton Height="18px" Width="420px" Class="mb-4" />
            <MudSkeleton Height="44px" />
            <MudSkeleton Height="44px" Class="mt-2" />
            <MudSkeleton Height="44px" Class="mt-2" />
        </MudPaper>}
    else if (_loading)
    {<MudPaper Class="pa-4 mt-3">
            <MudSkeleton Height="44px" />
            <MudSkeleton Height="44px" Class="mt-2" />
            <MudSkeleton Height="44px" Class="mt-2" />
            <MudSkeleton Height="44px" Class="mt-2" />
        </MudPaper>}
    else if (_error is not null)
    {<MudPaper Class="pa-4 mt-3">
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
            <div class="d-flex gap-2 mt-3 flex-wrap">
                <MudButton Variant="Variant.Outlined" OnClick="Reload">@SL["Retry"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GoHome">@SL["Home"]</MudButton>
            </div>
        </MudPaper>}
    else if (_result is null || _result.Items.Count == 0)
    {<MudPaper Class="pa-4 mt-3">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@SL["NoOrderYet"]</MudAlert>
            <MudButton Variant="Variant.Outlined" Class="mt-3" OnClick="GoHome">@SL["ContinueShopping"]</MudButton>
        </MudPaper>}
    else
    {<MudPaper Class="pa-4 mt-3">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <MudText Typo="Typo.h6" Class="mb-1">@SL["History"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@SL["Total"] : @_result.Total</MudText>
                </div>

                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <MudTextField T="string"
                                  Variant="Variant.Outlined"
                                  Dense="true"
                                  Placeholder="@SL["SearchById"]"
                                  Immediate="true"
                                  DebounceInterval="250"
                                  Value="_q"
                                  ValueChanged="OnSearchChanged" />


                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Disabled="_loading"
                                   OnClick="Reload" />

                </div>
            </div>

            <MudDivider Class="my-3" />

            <MudTable Items="_filtered" Dense="true" Hover="true" Bordered="true" Striped="true">
                <HeaderContent>
                    <MudTh>@SL["Date"]</MudTh>
                    <MudTh>@SL["Order"]</MudTh>
                    <MudTh>@SL["Payment"]</MudTh>
                    <MudTh>@SL["Status"]</MudTh>
                    <MudTh Align="right">@SL["Total"]</MudTh>
                    <MudTh Align="right">@SL["Action"]</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd>@context.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>

                    <MudTd>
                        <div style="font-weight:800;">#@ShortId(context.Id)</div>
                        <div class="dm-muted">@SL["IdLabel"]: @context.Id</div>
                    </MudTd>

                    <MudTd>
                        <MudChip T="string"
                                 Variant="Variant.Filled"
                                 Color="@PaymentColor(context.PaymentStatus)"
                                 Label="true">
                            @context.PaymentStatus
                        </MudChip>
                    </MudTd>

                    <MudTd>
                        <MudChip T="string"
                                 Variant="Variant.Outlined"
                                 Color="@StatusColor(context.Status)"
                                 Label="true">
                            @context.Status
                        </MudChip>
                    </MudTd>

                    <MudTd Align="Align.Right">@context.TotalAmount.ToString("0.00") @context.Currency</MudTd>

                    <MudTd Align="Align.Right">
                        <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                       OnClick="@(() => Open(context.Id))">
                                @SL["Details"]
                            </MudButton>
                            @if (IsReturnEligible(context))
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info"
                                           OnClick="@(() => OpenReturns(context.Id))">
                                    @T("Retour", "Return")
                                </MudButton>
                            }
                        </MudStack>
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                <div class="dm-muted">@SL["Page"] @_page / @TotalPages()</div>
                <DmPager CurrentPage="_page" TotalPages="TotalPages()" OnPageChanged="OnPageChanged" />
            </div>
        </MudPaper>
    }
</AuthGuard>

@code {
    private bool _bootstrapped;
    private bool _loading = true;
    private string? _error;

    private int _page = 1;
    private int _pageSize = 20;

    private string _q = "";
    private PagedResult<OrderRow>? _result;
    private List<OrderRow>_filtered = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        while (!Auth.IsReady)
            await Task.Delay(30);

        if (!Auth.IsAuthenticated)
        {
            _bootstrapped = true;
            StateHasChanged();
            return;
        }

        // Ici: Client + Admin autorisés (un Shop peut aussi consulter ses commandes client si tu veux)
        _bootstrapped = true;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _result = await Http.GetFromJsonAsync<PagedResult<OrderRow>>(
                $"api/orders/mine?page={_page}&pageSize={_pageSize}");

            _filtered = ApplyFilter(_result?.Items ?? []);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _result = null;
            _filtered = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Reload()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task OnPageChanged(int page)
    {
        _page = Math.Clamp(page, 1, TotalPages());
        await LoadAsync();
    }

    private int TotalPages()
        => _result is null ? 1 : Math.Max(1, (int)Math.Ceiling(_result.Total / (double)_pageSize));

    private void Open(Guid id) => Nav.NavigateTo($"/orders/{id}");
    private void OpenReturns(Guid id) => Nav.NavigateTo($"/returns?orderId={id}");

    private void GoHome() => Nav.NavigateTo("/");

    private Task OnSearchChanged(string value)
    {
        _q = value ?? "";
        _filtered = ApplyFilter(_result?.Items ?? []);
        return Task.CompletedTask;
    }

    private List<OrderRow>ApplyFilter(IReadOnlyList<OrderRow> items)
    {
        if (string.IsNullOrWhiteSpace(_q)) return items.ToList();

        return items.Where(x => x.Id.ToString().Contains(_q, StringComparison.OrdinalIgnoreCase))
                    .ToList();
    }

    private static string ShortId(Guid id) => id.ToString("N")[..8];

    private static bool IsReturnEligible(OrderRow row)
        => string.Equals(row.PaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase)
           && (string.Equals(row.Status, "Delivered", StringComparison.OrdinalIgnoreCase)
               || string.Equals(row.Status, "Completed", StringComparison.OrdinalIgnoreCase));

    private static Color PaymentColor(string paymentStatus) => paymentStatus switch
    {
        "Paid" => Color.Success,
        "Pending" => Color.Warning,
        "Failed" => Color.Error,
        _ => Color.Default
    };

    private static Color StatusColor(string status) => status switch
    {
        "Created" => Color.Info,
        "Paid" => Color.Success,
        "Preparing" => Color.Warning,
        "Ready" => Color.Success,
        "Completed" => Color.Success,
        "Cancelled" => Color.Error,
        _ => Color.Default
    };

    private static string T(string fr, string en)
        => string.Equals(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, "en", StringComparison.OrdinalIgnoreCase)
            ? en
            : fr;

    // Types minimaux pour éviter des using lourds
    private sealed record PagedResult<T>(List<T> Items, int Total, int Page, int PageSize);

    private sealed record OrderRow(
        Guid Id,
        string Status,
        string PaymentStatus,
        decimal TotalAmount,
        string Currency,
        DateTime CreatedAtUtc
    );
}





