@page "/shop/orders"

@using System.Net.Http.Json
@using MudBlazor
@using DoorMarket.Application.DTOs.Orders
@using PagedOrders = DoorMarket.Application.Common.PagedResult<DoorMarket.Application.DTOs.Orders.OrderDto>

@inject DoorMarket.Web.Auth.AuthState Auth
@inject NavigationManager Nav
@inject HttpClient Http
@inject ISnackbar Snackbar

<h1 class="dm-page-h1">@SL["Orders"]</h1>
<div class="dm-page-sub">@SL["ShopOrdersSubtitle"]</div>

<AuthGuard>
    @if (!_bootstrapped)
    {
        <MudPaper Class="pa-4 mt-3 dm-content-card">
            <MudSkeleton Height="28px" Width="240px" Class="mb-2" />
            <MudSkeleton Height="18px" Width="420px" Class="mb-4" />
            <MudSkeleton Height="46px" />
            <MudSkeleton Height="46px" Class="mt-2" />
            <MudSkeleton Height="46px" Class="mt-2" />
        </MudPaper>}
    else
    {<MudPaper Class="pa-4 mt-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <MudText Typo="Typo.h6" Class="mb-1">@SL["OrdersList"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@SL["Total"] : @(_result?.Total ?? 0)</MudText>
                </div>

                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <MudSelect T="string"
                               Label="@SL["Fulfillment"]"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Value="_statusFilter"
                               ValueChanged="OnStatusChanged"
                               Style="min-width:220px;">
                        <MudSelectItem Value="@string.Empty">@SL["All"]</MudSelectItem>
                        <MudSelectItem Value="@("PaidPending")">@SL["PaidPending"]</MudSelectItem>
                        <MudSelectItem Value="@("Processing")">@SL["Processing"]</MudSelectItem>
                        <MudSelectItem Value="@("Delivered")">@SL["Delivered"]</MudSelectItem>
                        <MudSelectItem Value="@("Cancelled")">@SL["Cancelled"]</MudSelectItem>
                    </MudSelect>

                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   OnClick="Reload"
                                   Disabled="_loading"
                                   Color="Color.Default" />
                </div>
            </div>

            <MudDivider Class="my-3" />

            @if (_loading)
            {
                <MudSkeleton Height="46px" />
                <MudSkeleton Height="46px" Class="mt-2" />
                <MudSkeleton Height="46px" Class="mt-2" />
                <MudSkeleton Height="46px" Class="mt-2" />}
            else if (_error is not null)
            {<MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                    @_error
                </MudAlert>

                <MudButton Variant="Variant.Outlined" Class="mt-3" OnClick="@(() => Nav.NavigateTo("/shop/dashboard"))">
                    @SL["BackToDashboard"]
                </MudButton>}
            else if (_result is null || _result.Items is null || _result.Items.Count == 0)
            {<MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@SL["NoOrderYet"]</MudAlert>}
            else
            {<MudTable Items="_result.Items" Dense="true" Hover="true" Bordered="true" Striped="true">
                    <HeaderContent>
                        <MudTh>@SL["Date"]</MudTh>
                        <MudTh>@SL["Order"]</MudTh>
                        <MudTh>@SL["Payment"]</MudTh>
                        <MudTh>@SL["Fulfillment"]</MudTh>
                        <MudTh Align="right">@SL["Total"]</MudTh>
                        <MudTh Align="right">@SL["Action"]</MudTh>
                    </HeaderContent>

                    <RowTemplate>
                        <MudTd>@context.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>

                        <MudTd>
                            <div style="font-weight:800;">#@ShortId(context.Id)</div>
                            <div class="dm-muted">@SL["IdLabel"]: @context.Id</div>
                        </MudTd>

                        <MudTd>
                            <MudChip T="string"
                                     Variant="Variant.Filled"
                                     Color="@(context.PaymentStatus == "Paid" ? Color.Success : Color.Warning)"
                                     Label="true">
                                @context.PaymentStatus
                            </MudChip>
                        </MudTd>

                        <MudTd>
                            <MudChip T="string"
                                     Variant="Variant.Outlined"
                                     Color="@StatusColor(context.FulfillmentStatus)"
                                     Label="true">
                                @context.FulfillmentStatus
                            </MudChip>
                        </MudTd>

                        <MudTd Align="Align.Right">
                            @context.TotalAmount.ToString("0.00") @context.Currency
                        </MudTd>

                        <MudTd Align="Align.Right">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                       OnClick="@(() => OpenDetail(context.Id))">
                                @SL["Details"]
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>

                <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                    <div class="dm-muted">@SL["Page"] @_page / @TotalPages()</div>
                    <DmPager CurrentPage="_page" TotalPages="TotalPages()" OnPageChanged="OnPageChanged" />
                </div>
            }
        </MudPaper>
    }
</AuthGuard>

@code {
    private bool _loading = true;
    private string? _error;

    private int _page = 1;
    private int _pageSize = 20;
    private string _statusFilter = "PaidPending";

    private PagedOrders? _result;

    private bool _bootstrapped;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // attendre AuthBootstrap
        while (!Auth.IsReady)
            await Task.Delay(30);

        // si pas connecté => AuthGuard gère
        if (!Auth.IsAuthenticated)
        {
            _bootstrapped = true;
            StateHasChanged();
            return;
        }

        // si pas Shop/Admin => redirect
        if (!Auth.IsShop && !Auth.IsAdmin)
        {
            Nav.NavigateTo("/", forceLoad: false);
            return;
        }

        _bootstrapped = true;
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _result = await Http.GetFromJsonAsync<PagedOrders>(
                $"api/orders/shop/mine?status={Uri.EscapeDataString(_statusFilter)}&page={_page}&pageSize={_pageSize}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private int TotalPages()
        => _result is null ? 1 : Math.Max(1, (int)Math.Ceiling(_result.Total / (double)_pageSize));

    private async Task OnPageChanged(int page)
    {
        _page = Math.Clamp(page, 1, TotalPages());
        await LoadAsync();
    }

    private async Task Reload() => await LoadAsync();

    private async Task OnStatusChanged(string value)
    {
        _statusFilter = value ?? string.Empty;
        _page = 1;
        await LoadAsync();
    }

    private void OpenDetail(Guid id) => Nav.NavigateTo($"/shop/orders/{id}");

    private static string ShortId(Guid id) => id.ToString("N")[..8];

    private static Color StatusColor(string status) => status switch
    {
        "PaidPending" => Color.Warning,
        "Processing" => Color.Info,
        "Delivered" => Color.Success,
        "Cancelled" => Color.Error,
        _ => Color.Default
    };
}





