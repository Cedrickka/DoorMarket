@page "/profile/addresses"
@using System.Net.Http.Json
@using DoorMarket.Application.DTOs.Me
@using DoorMarket.Application.DTOs.Delivery
@using MudBlazor
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>@SL["MyAddresses"]</PageTitle>

<h1 class="dm-page-h1">@SL["MyAddresses"]</h1>
<div class="dm-page-sub">@SL["AddressesSubtitle"]</div>

<AuthGuard>
    @if (_loading)
    {
        <MudPaper Class="pa-4 mt-3">
            <MudSkeleton Height="22px" Width="260px" Class="mb-2" />
            <MudSkeleton Height="16px" Width="360px" Class="mb-4" />
            <MudSkeleton Height="160px" />
        </MudPaper>
    }
    else if (_error is not null)
    {
        <MudPaper Class="pa-4 mt-3">
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
            <MudButton Variant="Variant.Outlined" Class="mt-3" OnClick="Reload">@SL["Retry"]</MudButton>
        </MudPaper>
    }
    else
    {
        <MudGrid Class="mt-3" Spacing="3">
            <MudItem xs="12" md="5">
                <MudPaper Class="pa-4 dm-content-card">
                    <MudText Typo="Typo.h6" Class="mb-2">@(_editingId.HasValue ? SL["EditAddress"] : SL["NewAddress"])</MudText>
                    <MudTextField T="string" Label="@SL["AddressLabel"]" Variant="Variant.Outlined" @bind-Value="_form.Label" />
                    <MudTextField T="string" Label="@SL["FullName"]" Variant="Variant.Outlined" Class="mt-2" @bind-Value="_form.FullName" />
                    <MudTextField T="string" Label="@SL["Phone"]" Variant="Variant.Outlined" Class="mt-2" @bind-Value="_form.Phone" />
                    <MudTextField T="string" Label="@SL["Country"]" Variant="Variant.Outlined" Class="mt-2" @bind-Value="_form.Country" />
                    <MudTextField T="string" Label="@SL["City"]" Variant="Variant.Outlined" Class="mt-2" @bind-Value="_form.City" />
                    <MudTextField T="string" Label="@SL["District"]" Variant="Variant.Outlined" Class="mt-2" @bind-Value="_form.District" />
                    <MudTextField T="string" Label="@SL["Street"]" Variant="Variant.Outlined" Class="mt-2" @bind-Value="_form.Street" />
                    <MudTextField T="string" Label="@SL["Landmark"]" Variant="Variant.Outlined" Class="mt-2" @bind-Value="_form.Landmark" />

                    <MudSelect T="Guid?" Label="@SL["DeliveryZone"]" Variant="Variant.Outlined" Class="mt-2" @bind-Value="_form.DeliveryZoneId">
                        <MudSelectItem T="Guid?" Value="null">@SL["NoZone"]</MudSelectItem>
                        @foreach (var zone in _zones)
                        {
                            <MudSelectItem T="Guid?" Value="@zone.Id">@($"{zone.Name} ({zone.Code})")</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSwitch T="bool" Class="mt-2" @bind-Value="_form.IsDefault">@SL["DefaultAddress"]</MudSwitch>

                    <div class="d-flex gap-2 mt-3 flex-wrap">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="SaveAsync">
                            @(_saving ? SL["Saving"] : SL["Save"])
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Disabled="_saving" OnClick="ResetForm">@SL["Clear"]</MudButton>
                    </div>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="7">
                <MudPaper Class="pa-4 dm-content-card">
                    <MudText Typo="Typo.h6" Class="mb-2">@SL["AddressesList"]</MudText>

                    @if (_items.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@SL["NoAddresses"]</MudAlert>
                    }
                    else
                    {
                        <MudTable Items="_items" Dense="true" Hover="true" Bordered="true">
                            <HeaderContent>
                                <MudTh>@SL["AddressLabel"]</MudTh>
                                <MudTh>@SL["City"]</MudTh>
                                <MudTh>@SL["DeliveryZone"]</MudTh>
                                <MudTh>@SL["Default"]</MudTh>
                                <MudTh Align="Align.Right">@SL["Actions"]</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <div style="font-weight:700">@context.Label</div>
                                    <div class="dm-muted">@context.Street, @context.District</div>
                                </MudTd>
                                <MudTd>@context.City</MudTd>
                                <MudTd>@(string.IsNullOrWhiteSpace(context.DeliveryZoneName) ? "-" : context.DeliveryZoneName)</MudTd>
                                <MudTd>
                                    <MudChip T="string" Label="true" Variant="Variant.Outlined" Color="@(context.IsDefault ? Color.Success : Color.Default)">
                                        @(context.IsDefault ? SL["Oui"] : SL["Non"])
                                    </MudChip>
                                </MudTd>
                                <MudTd Align="Align.Right">
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="_saving" OnClick="@(() => StartEdit(context))">
                                        @SL["Edit"]
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Class="ms-2" Disabled="_saving" OnClick="@(() => DeleteAsync(context))">
                                        @SL["Delete"]
                                    </MudButton>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</AuthGuard>

@code {
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private Guid? _editingId;
    private List<AddressDto> _items = new();
    private List<DeliveryZoneDto> _zones = new();
    private AddressFormModel _form = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task Reload() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _items = await Http.GetFromJsonAsync<List<AddressDto>>("api/me/addresses") ?? new();
            var zones = await Http.GetFromJsonAsync<List<DeliveryZoneDto>>("api/delivery/zones") ?? new();
            _zones = zones.Where(z => z.IsActive).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _items = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetForm()
    {
        _editingId = null;
        _form = new AddressFormModel();
    }

    private void StartEdit(AddressDto address)
    {
        _editingId = address.Id;
        _form = new AddressFormModel
        {
            Label = address.Label,
            FullName = address.FullName,
            Phone = address.Phone,
            Country = address.Country,
            City = address.City,
            District = address.District,
            DeliveryZoneId = address.DeliveryZoneId,
            Street = address.Street,
            Landmark = address.Landmark,
            IsDefault = address.IsDefault
        };
    }

    private bool ValidateForm()
    {
        if (string.IsNullOrWhiteSpace(_form.Label)
            || string.IsNullOrWhiteSpace(_form.FullName)
            || string.IsNullOrWhiteSpace(_form.Phone)
            || string.IsNullOrWhiteSpace(_form.Country)
            || string.IsNullOrWhiteSpace(_form.City)
            || string.IsNullOrWhiteSpace(_form.District)
            || string.IsNullOrWhiteSpace(_form.Street))
        {
            Snackbar.Add(SL["FillRequiredFieldsHint"], Severity.Warning);
            return false;
        }

        return true;
    }

    private async Task SaveAsync()
    {
        if (_saving) return;
        if (!ValidateForm()) return;

        _saving = true;
        try
        {
            if (_editingId is null)
            {
                var req = new CreateAddressRequest(
                    _form.Label.Trim(),
                    _form.FullName.Trim(),
                    _form.Phone.Trim(),
                    _form.Country.Trim(),
                    _form.City.Trim(),
                    _form.District.Trim(),
                    _form.DeliveryZoneId,
                    _form.Street.Trim(),
                    string.IsNullOrWhiteSpace(_form.Landmark) ? null : _form.Landmark.Trim(),
                    _form.IsDefault);

                var res = await Http.PostAsJsonAsync("api/me/addresses", req);
                if (!res.IsSuccessStatusCode)
                    throw new InvalidOperationException(await res.Content.ReadAsStringAsync());
            }
            else
            {
                var req = new UpdateAddressRequest(
                    _form.Label.Trim(),
                    _form.FullName.Trim(),
                    _form.Phone.Trim(),
                    _form.Country.Trim(),
                    _form.City.Trim(),
                    _form.District.Trim(),
                    _form.DeliveryZoneId,
                    _form.Street.Trim(),
                    string.IsNullOrWhiteSpace(_form.Landmark) ? null : _form.Landmark.Trim(),
                    _form.IsDefault);

                var res = await Http.PutAsJsonAsync($"api/me/addresses/{_editingId.Value}", req);
                if (!res.IsSuccessStatusCode)
                    throw new InvalidOperationException(await res.Content.ReadAsStringAsync());
            }

            Snackbar.Add(SL["AddressSaved"], Severity.Success);
            ResetForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync(AddressDto address)
    {
        var confirm = await Dialog.ShowMessageBox(
            title: SL["Delete"],
            markupMessage: (MarkupString)$"{SL["Delete"]} <b>{address.Label}</b> ?",
            yesText: SL["Delete"],
            cancelText: SL["Annuler"]);

        if (confirm != true)
            return;

        _saving = true;
        try
        {
            var res = await Http.DeleteAsync($"api/me/addresses/{address.Id}");
            if (!res.IsSuccessStatusCode)
                throw new InvalidOperationException(await res.Content.ReadAsStringAsync());

            Snackbar.Add(SL["AddressDeleted"], Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class AddressFormModel
    {
        public string Label { get; set; } = "";
        public string FullName { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Country { get; set; } = "";
        public string City { get; set; } = "";
        public string District { get; set; } = "";
        public Guid? DeliveryZoneId { get; set; }
        public string Street { get; set; } = "";
        public string? Landmark { get; set; }
        public bool IsDefault { get; set; }
    }
}
