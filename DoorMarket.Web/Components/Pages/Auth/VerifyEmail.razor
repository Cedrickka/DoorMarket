@page "/verify-email"
@implements IDisposable
@using System.Net.Http.Json
@using MudBlazor
@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@SL["VerifyEmailPageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6">
    <MudPaper Class="pa-5" Elevation="2">
        <MudText Typo="Typo.h5" Style="font-weight:900">@SL["VerifyEmailTitle"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">@SL["VerifyEmailSubtitle"]</MudText>
        <MudText Typo="Typo.caption" Color="@(_otpExpired ? Color.Error : Color.Info)" Class="mb-3">
            @(_otpExpired
                ? SL["OtpExpiredMessage"]
                : string.Format(SL["OtpExpiresIn"], _otpCountdown))
        </MudText>
        @if (_otpSending)
        {
            <MudStack Direction="Row" Spacing="1" AlignItems="AlignItems.Center" Class="mb-3">
                <MudProgressCircular Indeterminate="true" Style="width:16px;height:16px" />
                <MudText Typo="Typo.caption">@SL["OtpSending"]</MudText>
            </MudStack>
        }

        <MudForm @ref="_form">
            <MudTextField T="string" Label="@SL["Email"]" Variant="Variant.Outlined" Required="true" @bind-Value="_email" />
            <MudTextField T="string" Label="@SL["VerificationCode"]" Variant="Variant.Outlined" Required="true" Class="mt-3" @bind-Value="_code" />

            <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth="true" Class="mt-4" OnClick="VerifyAsync" Disabled="_loading">
                @if (_loading)
                {
                    <MudProgressCircular Indeterminate="true" Style="width:16px;height:16px" Class="me-2" />
                    <span>@SL["Verify"]</span>
                }
                else
                {
                    <span>@SL["Verify"]</span>
                }
            </MudButton>
            <MudButton Variant="Variant.Outlined" FullWidth="true" Class="mt-2" OnClick="ResendAsync" Disabled="_loading">
                @if (_loading)
                {
                    <MudProgressCircular Indeterminate="true" Style="width:16px;height:16px" Class="me-2" />
                    <span>@SL["ResendCode"]</span>
                }
                else
                {
                    <span>@SL["ResendCode"]</span>
                }
            </MudButton>
            <MudButton Variant="Variant.Text" FullWidth="true" Class="mt-1" OnClick="GoToLogin" Disabled="_loading">@SL["GoToLogin"]</MudButton>
        </MudForm>
    </MudPaper>
</MudContainer>

@code {
    private MudForm? _form;
    private bool _loading;
    private string _email = string.Empty;
    private string _code = string.Empty;
    private string? _returnUrl;
    private DateTime _otpExpiresAtUtc;
    private string _otpCountdown = "03:00";
    private bool _otpExpired;
    private CancellationTokenSource? _timerCts;
    private bool _otpSending;
    private DateTime _otpSentAtUtc;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("email", out var email))
        {
            _email = email.ToString();
        }
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("returnUrl", out var returnUrl))
        {
            var candidate = returnUrl.ToString();
            if (IsSafeReturnUrl(candidate))
            {
                _returnUrl = NormalizeReturnUrl(candidate);
            }
        }

        ResetOtpTimer();
    }

    private async Task VerifyAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        try
        {
            var res = await Http.PostAsJsonAsync("api/auth/verify-email", new VerifyEmailRequest(_email.Trim(), _code.Trim()));
            if (!res.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await res.Content.ReadAsStringAsync());
            }

            Snackbar.Add(SL["Email verifie. Vous pouvez vous connecter."], Severity.Success);
            GoToLogin();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoToLogin()
    {
        var target = "/login";
        if (!string.IsNullOrWhiteSpace(_returnUrl))
        {
            target += $"?returnUrl={Uri.EscapeDataString(_returnUrl)}";
        }

        Nav.NavigateTo(target);
    }

    private async Task ResendAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        try
        {
            var res = await Http.PostAsJsonAsync("api/auth/resend-verification", new ResendVerificationRequest(_email.Trim()));
            if (!res.IsSuccessStatusCode)
            {
                throw new InvalidOperationException(await res.Content.ReadAsStringAsync());
            }

            Snackbar.Add(SL["Code renvoye."], Severity.Info);
            ResetOtpTimer();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetOtpTimer()
    {
        _otpSentAtUtc = DateTime.UtcNow;
        _otpSending = true;
        _otpExpiresAtUtc = DateTime.UtcNow.AddMinutes(3);
        _otpExpired = false;
        _timerCts?.Cancel();
        _timerCts = new CancellationTokenSource();
        _ = RunOtpTimerAsync(_timerCts.Token);
    }

    private async Task RunOtpTimerAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            var remaining = _otpExpiresAtUtc - DateTime.UtcNow;
            if (remaining <= TimeSpan.Zero)
            {
                _otpExpired = true;
                _otpCountdown = "00:00";
                await InvokeAsync(StateHasChanged);
                break;
            }

            _otpCountdown = $"{remaining.Minutes:00}:{remaining.Seconds:00}";
            if (_otpSending && DateTime.UtcNow - _otpSentAtUtc > TimeSpan.FromSeconds(6))
            {
                _otpSending = false;
            }
            await InvokeAsync(StateHasChanged);

            try
            {
                await Task.Delay(1000, ct);
            }
            catch (OperationCanceledException)
            {
                break;
            }
        }
    }

    public void Dispose()
    {
        _timerCts?.Cancel();
        _timerCts?.Dispose();
    }

    private sealed record VerifyEmailRequest(string Email, string Code);
    private sealed record ResendVerificationRequest(string Email);

    private static bool IsSafeReturnUrl(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        if (Uri.TryCreate(value, UriKind.Relative, out _))
        {
            return value.StartsWith("/");
        }

        return false;
    }

    private static string NormalizeReturnUrl(string value)
        => value.StartsWith("/") ? value : "/" + value;
}





