@page "/login/otp"
@implements IDisposable
@using System.IdentityModel.Tokens.Jwt
@using System.Net
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.WebUtilities
@using MudBlazor
@inject HttpClient Http
@inject NavigationManager Nav
@inject DoorMarket.Web.Auth.TokenStore Tokens
@inject DoorMarket.Web.Auth.AuthState Auth
@inject ISnackbar Snackbar
@inject DoorMarket.Web.Services.CartApiClient CartApi
@inject DoorMarket.Web.Services.GuestCartService GuestCart

<PageTitle>@SL["LoginPageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6">
    <MudPaper Class="pa-5" Elevation="2">
        <MudText Typo="Typo.h5" Style="font-weight:900">@SL["LoginPageTitle"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @SL["OtpLoginMessage"]
        </MudText>
        @if (string.IsNullOrWhiteSpace(_error))
        {
            <MudText Typo="Typo.caption" Color="@(_otpExpired ? Color.Error : Color.Info)" Class="mb-3">
                @(_otpExpired
                    ? SL["OtpExpiredMessage"]
                    : string.Format(SL["OtpExpiresIn"], _otpCountdown))
            </MudText>
            @if (_otpSending)
            {
                <MudStack Direction="Row" Spacing="1" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudProgressCircular Indeterminate="true" Style="width:16px;height:16px" />
                    <MudText Typo="Typo.caption">@SL["OtpSending"]</MudText>
                </MudStack>
            }
        }

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">
                @_error
            </MudAlert>
            <MudButton Variant="Variant.Outlined" OnClick="@(() => Nav.NavigateTo("/login"))">
                @SL["BackToLogin"]
            </MudButton>
        }
        else
        {
            <MudForm @ref="_form">
                <MudTextField T="string"
                              Label="@SL["OtpCodeLabel"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              Immediate="true"
                              @bind-Value="_code" />

                <MudCheckBox T="bool" @bind-Checked="_rememberMe" Color="Color.Primary" Class="mt-3">
                    @SL["KeepSession"]
                </MudCheckBox>

                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           Class="mt-4"
                           FullWidth="true"
                           Disabled="_loading"
                           OnClick="VerifyOtpAsync">
                    @if (_loading)
                    {
                        <MudProgressCircular Indeterminate="true" Style="width:16px;height:16px" Class="me-2" />
                        <span>@SL["SigningIn"]</span>
                    }
                    else
                    {
                        <span>@SL["OtpVerifyAction"]</span>
                    }
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           FullWidth="true"
                           Class="mt-2"
                           Disabled="_loading"
                           OnClick="ResendOtpAsync">
                    @if (_loading)
                    {
                        <MudProgressCircular Indeterminate="true" Style="width:16px;height:16px" Class="me-2" />
                        <span>@SL["ResendCode"]</span>
                    }
                    else
                    {
                        <span>@SL["ResendCode"]</span>
                    }
                </MudButton>

                <MudButton Variant="Variant.Text"
                           FullWidth="true"
                           Class="mt-2"
                           Disabled="_loading"
                           OnClick="@(() => Nav.NavigateTo("/login"))">
                    @SL["BackToLogin"]
                </MudButton>
            </MudForm>
        }
    </MudPaper>
</MudContainer>

@code {
    private MudForm? _form;
    private string _login = string.Empty;
    private string _code = string.Empty;
    private bool _rememberMe = true;
    private bool _loading;
    private string? _returnUrl;
    private string? _error;
    private DateTime _otpExpiresAtUtc;
    private string _otpCountdown = "03:00";
    private bool _otpExpired;
    private CancellationTokenSource? _timerCts;
    private bool _otpSending;
    private DateTime _otpSentAtUtc;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("login", out var login))
        {
            _login = login.ToString().Trim();
        }

        if (query.TryGetValue("remember", out var remember))
        {
            var raw = remember.ToString();
            if (bool.TryParse(raw, out var parsed))
            {
                _rememberMe = parsed;
            }
            else
            {
                _rememberMe = raw == "1";
            }
        }

        if (query.TryGetValue("returnUrl", out var returnUrl))
        {
            var candidate = returnUrl.ToString();
            if (IsSafeReturnUrl(candidate))
            {
                _returnUrl = NormalizeReturnUrl(candidate);
            }
        }

        if (string.IsNullOrWhiteSpace(_login))
        {
            _error = SL["FillCredentials"];
        }
        else
        {
            ResetOtpTimer();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (Auth.IsReady && Auth.IsAuthenticated)
        {
            Nav.NavigateTo(GetDashboardUrl(), forceLoad: false);
            return;
        }
    }

    private async Task VerifyOtpAsync()
    {
        if (_loading)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_code))
        {
            Snackbar.Add(SL["OtpRequired"], Severity.Warning);
            return;
        }

        _loading = true;
        try
        {
            var req = new LoginOtpRequest(_login.Trim(), _code.Trim());
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(60));
            var res = await Http.PostAsJsonAsync("api/auth/login-otp", req, cts.Token);
            if (!res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadAsStringAsync();
                var apiError = ExtractApiError(body);
                if (res.StatusCode is HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden)
                {
                    throw new InvalidOperationException(SL["InvalidCredentials"]);
                }

                var message = string.IsNullOrWhiteSpace(apiError)
                    ? $"{SL["ApiError"]} ({(int)res.StatusCode})"
                    : apiError;
                throw new InvalidOperationException(message);
            }

            var auth = await res.Content.ReadFromJsonAsync<LoginResult>();
            if (auth is null || string.IsNullOrWhiteSpace(auth.AccessToken))
            {
                throw new InvalidOperationException(SL["InvalidToken"]);
            }

            await HandleAuthSuccess(auth.AccessToken);
        }
        catch (TaskCanceledException)
        {
            Auth.SetUnauthenticated();
            Snackbar.Add(SL["ApiTimeout"], Severity.Error);
        }
        catch (HttpRequestException ex)
        {
            Auth.SetUnauthenticated();
            Snackbar.Add($"{SL["ApiError"]}: {ex.Message}", Severity.Error);
        }
        catch (Exception ex)
        {
            Auth.SetUnauthenticated();
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task ResendOtpAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        try
        {
            var req = new ResendLoginOtpRequest(_login.Trim());
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(60));
            var res = await Http.PostAsJsonAsync("api/auth/resend-login-otp", req, cts.Token);
            if (!res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadAsStringAsync();
                var apiError = ExtractApiError(body);
                var message = string.IsNullOrWhiteSpace(apiError)
                    ? $"{SL["ApiError"]} ({(int)res.StatusCode})"
                    : apiError;
                throw new InvalidOperationException(message);
            }

            Snackbar.Add(SL["OtpResent"], Severity.Success);
            ResetOtpTimer();
        }
        catch (TaskCanceledException)
        {
            Snackbar.Add(SL["ApiTimeout"], Severity.Error);
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add($"{SL["ApiError"]}: {ex.Message}", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void ResetOtpTimer()
    {
        _otpSentAtUtc = DateTime.UtcNow;
        _otpSending = true;
        _otpExpiresAtUtc = DateTime.UtcNow.AddMinutes(3);
        _otpExpired = false;
        _timerCts?.Cancel();
        _timerCts = new CancellationTokenSource();
        _ = RunOtpTimerAsync(_timerCts.Token);
    }

    private async Task RunOtpTimerAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            var remaining = _otpExpiresAtUtc - DateTime.UtcNow;
            if (remaining <= TimeSpan.Zero)
            {
                _otpExpired = true;
                _otpCountdown = "00:00";
                await InvokeAsync(StateHasChanged);
                break;
            }

            _otpCountdown = $"{remaining.Minutes:00}:{remaining.Seconds:00}";
            if (_otpSending && DateTime.UtcNow - _otpSentAtUtc > TimeSpan.FromSeconds(6))
            {
                _otpSending = false;
            }
            await InvokeAsync(StateHasChanged);

            try
            {
                await Task.Delay(1000, ct);
            }
            catch (OperationCanceledException)
            {
                break;
            }
        }
    }

    public void Dispose()
    {
        _timerCts?.Cancel();
        _timerCts?.Dispose();
    }

    private async Task HandleAuthSuccess(string accessToken)
    {
        await Tokens.SetAsync(accessToken, _rememberMe);
        Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", accessToken);

        try
        {
            await GuestCart.MergeIntoUserCartAsync(CartApi);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }

        var jwt = new JwtSecurityTokenHandler().ReadJwtToken(accessToken);
        var role =
            jwt.Claims.FirstOrDefault(c => c.Type == "role")?.Value ??
            jwt.Claims.FirstOrDefault(c => c.Type.EndsWith("/role"))?.Value;
        var email =
            jwt.Claims.FirstOrDefault(c => c.Type == "email")?.Value ??
            jwt.Claims.FirstOrDefault(c => c.Type.EndsWith("/emailaddress"))?.Value;

        Auth.SetAuthenticated(role, email);
        Snackbar.Add(SL["LoginSuccess"], Severity.Success);
        if (!string.IsNullOrWhiteSpace(_returnUrl))
        {
            Nav.NavigateTo(_returnUrl!, forceLoad: false);
            return;
        }

        Nav.NavigateTo(GetDashboardUrl(role), forceLoad: false);
    }

    private string GetDashboardUrl(string? role = null)
    {
        role ??= Auth.Role;

        if (string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(role, "SuperAdmin", StringComparison.OrdinalIgnoreCase))
        {
            return "/admin/users";
        }

        if (string.Equals(role, "Shop", StringComparison.OrdinalIgnoreCase))
        {
            return "/shop/dashboard";
        }

        return "/";
    }

    private static bool IsSafeReturnUrl(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        if (Uri.TryCreate(value, UriKind.Relative, out _))
        {
            return value.StartsWith("/");
        }

        return false;
    }

    private static string NormalizeReturnUrl(string value)
        => value.StartsWith("/") ? value : "/" + value;

    private sealed record LoginOtpRequest(string Login, string Code);
    private sealed record ResendLoginOtpRequest(string Login);
    private sealed record LoginResult(string AccessToken, bool OtpRequired);

    private static string ExtractApiError(string body)
    {
        if (string.IsNullOrWhiteSpace(body))
        {
            return string.Empty;
        }

        try
        {
            using var doc = JsonDocument.Parse(body);
            var root = doc.RootElement;
            if (root.ValueKind == JsonValueKind.Object)
            {
                if (root.TryGetProperty("error", out var errorProp))
                {
                    return errorProp.GetString() ?? body;
                }

                if (root.TryGetProperty("title", out var titleProp))
                {
                    return titleProp.GetString() ?? body;
                }
            }
        }
        catch
        {
            // ignore parse errors
        }

        return body;
    }
}
