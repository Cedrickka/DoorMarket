@page "/forgot-password"
@inject NavigationManager Nav

<h1>@SL["ForgotPasswordTitle"]</h1>

<div class="dm-card" style="max-width:520px;">
    <div class="dm-muted mb-2">@SL["ForgotPasswordInfo"]</div>

    <p style="margin:0 0 14px;">@SL["ForgotPasswordHint"]</p>

    <button class="dm-btn dm-btn-outline" @onclick="() => Nav.NavigateTo(_urlLogin)">@SL["BackToLogin"]</button>
</div>
@code {
    private string _urlLogin = "/login";
}


