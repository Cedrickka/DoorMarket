@implements IDisposable
@using System.Globalization
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject DoorMarket.Web.Auth.AuthState Auth
@inject DoorMarket.Web.Auth.TokenStore Tokens
@inject NavigationManager Nav
@inject HttpClient Http
@inject MudBlazor.ISnackbar Snack
@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime JS

<header class="dm-topbar">
    <div class="dm-topbar-left">
        <button class="dm-icon-btn dm-topbar-toggle-desktop"
                @onclick="ToggleMenu"
                title="@L["Menu"]"
                aria-label="@L["Menu"]">
            <span class="dm-topbar-toggle-icon-mobile">&#9776;</span>
            <span class="dm-topbar-toggle-icon-desktop">@(DesktopSidebarCollapsed ? "\u2630" : "\u25C0")</span>
        </button>

        <div class="dm-topbar-title">
            <div class="dm-topbar-app">@L["AppName"]</div>
            <div class="dm-topbar-sub">@Subtitle</div>
        </div>
    </div>

    <div class="dm-topbar-right">
        <div class="dm-search d-none d-md-flex">
            <span class="dm-search-ico">&#128269;</span>
            <input class="dm-input dm-input-sm dm-search-input"
                   type="search"
                   placeholder="@L["SearchPlaceholder"]"
                   value="@_search"
                   autocomplete="off"
                   aria-label="@L["Search"]"
                   aria-controls="dm-topbar-search-suggestions"
                   aria-autocomplete="list"
                   aria-haspopup="listbox"
                   aria-expanded="@((_showSearchSuggestions && _searchSuggestions.Count > 0) ? "true" : "false")"
                   @oninput="OnSearchInput"
                   @onkeydown="OnSearchKeyDown" />
            <button type="button"
                    class="dm-btn dm-btn-outline dm-search-go"
                    @onclick="SubmitSearch">
                @L["Search"]
            </button>

            @if (_showSearchSuggestions && _searchSuggestions.Count > 0)
            {
                <div id="dm-topbar-search-suggestions"
                     class="dm-topbar-search-suggestions"
                     role="listbox"
                     aria-label="@SearchSuggestionsAriaLabel">
                    @for (var i = 0; i < _searchSuggestions.Count; i++)
                    {
                        var item = _searchSuggestions[i];
                        <button type="button"
                                class="dm-topbar-search-suggestion-item"
                                role="option"
                                @onclick="() => SelectSuggestion(item)">
                            <span class="dm-topbar-search-suggestion-type">@SuggestionTypeLabel(item.Type)</span>
                            <span class="dm-topbar-search-suggestion-label">@item.Label</span>
                        </button>
                    }
                </div>
            }
        </div>

        <button type="button"
                class="dm-icon-btn d-md-none"
                title="@L["Search"]"
                aria-label="@L["Search"]"
                @onclick="OpenSearchPage">
            &#128269;
        </button>

        <MudBlazor.MudMenu AnchorOrigin="MudBlazor.Origin.BottomRight"
                           TransformOrigin="MudBlazor.Origin.TopRight">
            <ActivatorContent>
                <button type="button" class="dm-btn dm-btn-outline" title="@L["Language"]" aria-label="@L["Language"]">
                    <img src="@CurrentFlagUrl" alt="@CurrentLanguageCode" style="width:18px;height:12px;border-radius:2px;object-fit:cover" />
                    <span class="dm-caret">&#9662;</span>
                </button>
            </ActivatorContent>
            <ChildContent>
                <MudBlazor.MudMenuItem OnClick='@(() => SetCulture("fr-FR"))'>
                    <img src="https://flagcdn.com/w20/fr.png" alt="FR" style="width:18px;height:12px;border-radius:2px;object-fit:cover;margin-right:8px" /> @L["French"]
                </MudBlazor.MudMenuItem>
                <MudBlazor.MudMenuItem OnClick='@(() => SetCulture("en-US"))'>
                    <img src="https://flagcdn.com/w20/us.png" alt="US" style="width:18px;height:12px;border-radius:2px;object-fit:cover;margin-right:8px" /> @L["English"]
                </MudBlazor.MudMenuItem>
            </ChildContent>
        </MudBlazor.MudMenu>

        <button type="button"
                class="dm-icon-btn"
                title="@L["Notifications"]"
                aria-label="@L["Notifications"]"
                @onclick="OpenNotifications">
            &#128276;
        </button>

        @if (!Auth.IsReady)
        {
            <div class="dm-muted">...</div>
        }
        else if (!Auth.IsAuthenticated)
        {
            <button type="button" class="dm-btn dm-btn-primary" @onclick="GoLogin">@L["SignIn"]</button>
        }
        else
        {
            <MudBlazor.MudMenu AnchorOrigin="MudBlazor.Origin.BottomRight"
                               TransformOrigin="MudBlazor.Origin.TopRight">
                <ActivatorContent>
                    <button type="button" class="dm-userbtn" aria-label="@L["UserMenu"]">
                        <span class="dm-avatar">@Initials</span>
                        <span class="d-none d-md-inline dm-userbtn-text">
                            <span class="dm-user-name">@DisplayName</span>
                            <span class="dm-user-role">@DisplayRole</span>
                        </span>
                        <span class="dm-caret">&#9662;</span>
                    </button>
                </ActivatorContent>

                <ChildContent>
                    <MudBlazor.MudMenuItem OnClick="GoProfile">@L["Profile"]</MudBlazor.MudMenuItem>
                    <MudBlazor.MudDivider />
                    <MudBlazor.MudMenuItem OnClick="DoLogout">@L["Logout"]</MudBlazor.MudMenuItem>
                </ChildContent>
            </MudBlazor.MudMenu>
        }
    </div>
</header>

@code {
    private string _search = "";
    private List<TopbarSearchSuggestionDto> _searchSuggestions = new();
    private CancellationTokenSource? _suggestionCts;
    private bool _showSearchSuggestions;

    [Parameter] public EventCallback OnToggleSidebar { get; set; }
    [Parameter] public EventCallback OnToggleDesktopSidebar { get; set; }
    [Parameter] public bool DesktopSidebarCollapsed { get; set; }

    protected override void OnInitialized()
    {
        Auth.OnChange += StateHasChanged;
        Nav.LocationChanged += HandleLocationChanged;
        SyncSearchFromUrl();
    }

    public void Dispose()
    {
        Auth.OnChange -= StateHasChanged;
        Nav.LocationChanged -= HandleLocationChanged;
        _suggestionCts?.Cancel();
        _suggestionCts?.Dispose();
    }

    private string Subtitle =>
        Auth.IsAdmin ? L["AdministrationSubtitle"] :
        Auth.IsShop ? L["ShopDashboardSubtitle"] :
        L["WelcomeSubtitle"];

    private string DisplayName => Auth.Email ?? L["UserFallback"];
    private string DisplayRole => Auth.Role ?? "";
    private string Initials => GetInitials(DisplayName);
    private string SearchSuggestionsAriaLabel => IsEnglish ? "Search suggestions" : "Suggestions de recherche";

    private bool IsEnglish => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.Equals("en", StringComparison.OrdinalIgnoreCase);

    private string CurrentLanguageCode =>
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.Equals("en", StringComparison.OrdinalIgnoreCase)
            ? "en-US"
            : "fr-FR";

    private string CurrentFlagUrl => CurrentLanguageCode.StartsWith("en", StringComparison.OrdinalIgnoreCase)
        ? "https://flagcdn.com/w20/us.png"
        : "https://flagcdn.com/w20/fr.png";

    private async Task ToggleMenu()
    {
        var isMobile = false;
        try
        {
            isMobile = await JS.InvokeAsync<bool>("doorMarket.isMobileViewport");
        }
        catch
        {
            // JS not available (startup/prerender): fall back to desktop behavior.
        }

        if (isMobile)
        {
            if (OnToggleSidebar.HasDelegate)
            {
                await OnToggleSidebar.InvokeAsync();
            }

            return;
        }

        if (OnToggleDesktopSidebar.HasDelegate)
        {
            await OnToggleDesktopSidebar.InvokeAsync();
        }
    }

    private void GoLogin() => Nav.NavigateTo("/login", forceLoad: false);

    private void GoProfile()
    {
        if (Auth.IsAdmin)
        {
            Nav.NavigateTo("/admin/users", forceLoad: false);
            return;
        }

        if (Auth.IsShop)
        {
            Nav.NavigateTo("/shop/dashboard", forceLoad: false);
            return;
        }

        Nav.NavigateTo("/profile", forceLoad: false);
    }

    private async Task DoLogout()
    {
        await Tokens.ClearAsync();
        Http.DefaultRequestHeaders.Authorization = null;
        Auth.SetUnauthenticated();

        Snack.Add(L["LoggedOut"], MudBlazor.Severity.Info);
        Nav.NavigateTo("/login", forceLoad: false);
    }

    private void OpenSearchPage()
    {
        _showSearchSuggestions = false;
        if (string.IsNullOrWhiteSpace(_search))
        {
            Nav.NavigateTo("/search", forceLoad: false);
            return;
        }

        SubmitSearch();
    }

    private void OpenNotifications()
    {
        _showSearchSuggestions = false;

        if (!Auth.IsReady || !Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login", forceLoad: false);
            return;
        }

        if (Auth.IsAdmin)
        {
            Nav.NavigateTo("/admin/notifications", forceLoad: false);
            return;
        }

        if (Auth.IsShop)
        {
            Nav.NavigateTo("/shop/orders", forceLoad: false);
            return;
        }

        Nav.NavigateTo("/notifications", forceLoad: false);
    }

    private void SubmitSearch()
    {
        _showSearchSuggestions = false;
        var normalized = NormalizeQuery(_search);
        var url = string.IsNullOrWhiteSpace(normalized)
            ? "/search"
            : $"/search?q={Uri.EscapeDataString(normalized)}";

        Nav.NavigateTo(url, forceLoad: false);
    }

    private void OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Enter", StringComparison.OrdinalIgnoreCase))
        {
            SubmitSearch();
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SyncSearchFromUrl();
        _ = InvokeAsync(StateHasChanged);
    }

    private void SyncSearchFromUrl()
    {
        var q = GetQueryValue(Nav.ToAbsoluteUri(Nav.Uri), "q");
        _search = q ?? string.Empty;
        _showSearchSuggestions = false;
        _searchSuggestions = new();
    }

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        _search = args.Value?.ToString() ?? string.Empty;
        var normalized = NormalizeQuery(_search);
        if (string.IsNullOrWhiteSpace(normalized) || normalized.Length < 2)
        {
            _showSearchSuggestions = false;
            _searchSuggestions = new();
            return;
        }

        _suggestionCts?.Cancel();
        _suggestionCts?.Dispose();
        _suggestionCts = new CancellationTokenSource();
        var ct = _suggestionCts.Token;

        try
        {
            await Task.Delay(170, ct);
            var rows = await Http.GetFromJsonAsync<List<TopbarSearchSuggestionDto>>(
                $"api/search/suggestions?q={Uri.EscapeDataString(normalized)}&limit=6",
                ct);
            if (ct.IsCancellationRequested)
            {
                return;
            }

            _searchSuggestions = rows ?? new();
            _showSearchSuggestions = _searchSuggestions.Count > 0;
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
            _searchSuggestions = new();
            _showSearchSuggestions = false;
        }
    }

    private void SelectSuggestion(TopbarSearchSuggestionDto item)
    {
        _search = item.Value;
        _showSearchSuggestions = false;
        SubmitSearch();
    }

    private string SuggestionTypeLabel(string? type)
        => (type ?? string.Empty).ToLowerInvariant() switch
        {
            "product" => L["Products"],
            "shop" => L["Shops"],
            "category" => L["Categories"],
            "query" => "Popular",
            _ => type ?? string.Empty
        };

    private sealed record TopbarSearchSuggestionDto(
        string Type,
        Guid? EntityId,
        string Value,
        string Label,
        string? Subtitle);

    private void SetCulture(string culture)
    {
        var redirect = RelativeUri;
        var url = $"/set-culture?culture={Uri.EscapeDataString(culture)}&redirectUri={Uri.EscapeDataString(redirect)}";
        Nav.NavigateTo(url, forceLoad: true);
    }

    private string RelativeUri
    {
        get
        {
            var relative = Nav.ToBaseRelativePath(Nav.Uri);
            if (string.IsNullOrWhiteSpace(relative))
            {
                return "/";
            }

            return relative.StartsWith('/') ? relative : "/" + relative;
        }
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "DM";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();
        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpperInvariant();
    }

    private static string? NormalizeQuery(string? value)
    {
        var normalized = (value ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(normalized))
        {
            return null;
        }

        return normalized.Length <= 100 ? normalized : normalized[..100];
    }

    private static string? GetQueryValue(Uri uri, string key)
    {
        var query = uri.Query;
        if (string.IsNullOrWhiteSpace(query))
        {
            return null;
        }

        var trimmed = query.StartsWith('?') ? query[1..] : query;
        foreach (var part in trimmed.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var idx = part.IndexOf('=');
            if (idx < 0)
            {
                var candidate = Uri.UnescapeDataString(part);
                if (string.Equals(candidate, key, StringComparison.OrdinalIgnoreCase))
                {
                    return string.Empty;
                }

                continue;
            }

            var candidateKey = Uri.UnescapeDataString(part[..idx]);
            if (!string.Equals(candidateKey, key, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            var rawValue = part[(idx + 1)..];
            return Uri.UnescapeDataString(rawValue.Replace('+', ' '));
        }

        return null;
    }
}
