<?xml version="1.0" encoding="utf-8" ?>
<local:LocalizedContentPage xmlns:local="clr-namespace:DoorMarket.Mobile.Localization"     x:Class="DoorMarket.Mobile.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:DoorMarket.Mobile.Components"
    xmlns:markup="clr-namespace:DoorMarket.Mobile.Markup"
    xmlns:models="clr-namespace:DoorMarket.Mobile.Models"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">
        <components:DmHeader
            Subtitle="{markup:Translate ProfileSubtitle}"
            Title="{markup:Translate ProfileTitle}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,16,24,24" Spacing="16">
                <components:DmCard Margin="0">
                    <Grid ColumnDefinitions="72,*" ColumnSpacing="16">
                        <Frame
                            BackgroundColor="{StaticResource DoorOrange12}"
                            CornerRadius="36"
                            HasShadow="False"
                            HeightRequest="72"
                            Padding="0"
                            WidthRequest="72">
                            <Image
                                x:Name="ProfilePhoto"
                                Aspect="AspectFill"
                                Source="doormarket_icon_64.png" />
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChangePhotoClicked" />
                            </Frame.GestureRecognizers>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <Label FontFamily="Inter-SemiBold" FontSize="20" Text="{markup:Translate AccountTitle}" />
                            <Label x:Name="EmailLabel" Style="{StaticResource MutedLabelStyle}" Text="-" />
                            <components:DmSecondaryButton Clicked="OnChangePhotoClicked" Text="{markup:Translate ChangePhotoAction}" />
                        </VerticalStackLayout>
                    </Grid>
                </components:DmCard>

                <components:DmCard Margin="0">
                    <VerticalStackLayout Spacing="16">
                        <Label Style="{StaticResource SectionTitleLabelStyle}" Text="{markup:Translate InformationSection}" />
                        <components:DmInput
                            x:Name="PhoneEntry"
                            Keyboard="Telephone"
                            Label="{markup:Translate PhoneLabel}"
                            Placeholder="{markup:Translate PhonePlaceholder}" />

                        <components:DmInput
                            x:Name="NewPasswordEntry"
                            Label="{markup:Translate NewPasswordLabel}"
                            IsPassword="True"
                            Placeholder="{markup:Translate NewPasswordPlaceholder}" />

                        <components:DmInput
                            x:Name="ConfirmPasswordEntry"
                            Label="{markup:Translate ConfirmPasswordLabel}"
                            IsPassword="True"
                            Placeholder="{markup:Translate ConfirmPasswordPlaceholder}" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label
                                FontFamily="Inter-Medium"
                                FontSize="13"
                                Text="{markup:Translate RoleLabel}"
                                TextColor="{StaticResource DarkGray}" />
                            <Label x:Name="RoleLabel" Grid.Column="1" FontFamily="Inter-SemiBold" Text="-" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label
                                FontFamily="Inter-Medium"
                                FontSize="13"
                                Text="{markup:Translate StatusLabel}"
                                TextColor="{StaticResource DarkGray}" />
                            <Label x:Name="StatusLabel" Grid.Column="1" FontFamily="Inter-SemiBold" Text="-" />
                        </Grid>

                        <components:DmPrimaryButton Clicked="OnSaveClicked" Text="{markup:Translate Save}" />
                        <components:DmSecondaryButton Clicked="OnChangePasswordClicked" Text="{markup:Translate ChangePasswordAction}" />
                    </VerticalStackLayout>
                </components:DmCard>

                <components:DmCard Margin="0">
                    <VerticalStackLayout Spacing="16">
                        <Label Style="{StaticResource SectionTitleLabelStyle}" Text="{markup:Translate Menu}" />

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Image Source="{FontImageSource FontFamily=fa-solid-900, Glyph={x:Static models:IconGlyphs.Location}, Color={StaticResource DoorBlue}, Size=14}" VerticalOptions="Center" />
                            <Label Grid.Column="1" FontFamily="Inter-SemiBold" Text="{markup:Translate AddressesTitle}" VerticalOptions="Center" />
                            <Image Grid.Column="2" Source="{FontImageSource FontFamily=fa-solid-900, Glyph={x:Static models:IconGlyphs.ChevronRight}, Color={StaticResource DoorBlue}, Size=12}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAddressesClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView BackgroundColor="{StaticResource SoftGray}" HeightRequest="1" />

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Image Source="{FontImageSource FontFamily=fa-solid-900, Glyph={x:Static models:IconGlyphs.Cart}, Color={StaticResource DoorBlue}, Size=14}" VerticalOptions="Center" />
                            <Label Grid.Column="1" FontFamily="Inter-SemiBold" Text="{markup:Translate PaymentsTitle}" VerticalOptions="Center" />
                            <Image Grid.Column="2" Source="{FontImageSource FontFamily=fa-solid-900, Glyph={x:Static models:IconGlyphs.ChevronRight}, Color={StaticResource DoorBlue}, Size=12}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPaymentsClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView BackgroundColor="{StaticResource SoftGray}" HeightRequest="1" />

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Image Source="{FontImageSource FontFamily=fa-solid-900, Glyph={x:Static models:IconGlyphs.Bell}, Color={StaticResource DoorBlue}, Size=14}" VerticalOptions="Center" />
                            <Label Grid.Column="1" FontFamily="Inter-SemiBold" Text="{markup:Translate HelpTitle}" VerticalOptions="Center" />
                            <Image Grid.Column="2" Source="{FontImageSource FontFamily=fa-solid-900, Glyph={x:Static models:IconGlyphs.ChevronRight}, Color={StaticResource DoorBlue}, Size=12}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSupportClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <BoxView BackgroundColor="{StaticResource SoftGray}" HeightRequest="1" />

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Image Source="{FontImageSource FontFamily=fa-solid-900, Glyph={x:Static models:IconGlyphs.Filter}, Color={StaticResource DoorBlue}, Size=14}" VerticalOptions="Center" />
                            <Label Grid.Column="1" FontFamily="Inter-SemiBold" Text="{markup:Translate SettingsTitle}" VerticalOptions="Center" />
                            <Image Grid.Column="2" Source="{FontImageSource FontFamily=fa-solid-900, Glyph={x:Static models:IconGlyphs.ChevronRight}, Color={StaticResource DoorBlue}, Size=12}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSettingsClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </components:DmCard>

                <components:DmSecondaryButton Clicked="OnLogoutClicked" Text="{markup:Translate Logout}" />

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</local:LocalizedContentPage>



