<?xml version="1.0" encoding="utf-8" ?>
<local:LocalizedContentPage xmlns:local="clr-namespace:DoorMarket.Mobile.Localization"
    x:Class="DoorMarket.Mobile.Pages.PaymentReturnPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:DoorMarket.Mobile.Components"
    xmlns:markup="clr-namespace:DoorMarket.Mobile.Markup"
    xmlns:models="clr-namespace:DoorMarket.Mobile.Models"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">
        <Grid
            BackgroundColor="{StaticResource White}"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="16"
            Padding="{OnPlatform iOS='24,56,24,20', Default='24,50,24,20'}">
            <ImageButton Clicked="OnBackClicked">
                <ImageButton.Source>
                    <FontImageSource FontFamily="fa-solid-900" Glyph="{x:Static models:IconGlyphs.Back}" Color="{StaticResource DoorBlue}" Size="16" />
                </ImageButton.Source>
            </ImageButton>
            <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                <Label FontFamily="Inter-Bold" FontSize="22" Text="{markup:Translate PaymentReturnTitle}" TextColor="{StaticResource DoorBlue}" />
                <Label FontFamily="Inter-Regular" FontSize="13" Text="{markup:Translate PaymentReturnSubtitle}" TextColor="{StaticResource DarkGray}" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollView>
                <VerticalStackLayout Padding="24,16,24,24" Spacing="16">
                    <components:DmCard Margin="0">
                        <VerticalStackLayout Spacing="8">
                            <Label FontFamily="Inter-Bold" FontSize="18" Text="{Binding OrderCode}" />
                            <Label Style="{StaticResource CaptionLabelStyle}" Text="{Binding ProviderLabel}" />
                            <Label Style="{StaticResource CaptionLabelStyle}" Text="{Binding LastCheckLabel}" />
                        </VerticalStackLayout>
                    </components:DmCard>

                    <components:DmCard Margin="0">
                        <VerticalStackLayout Spacing="10">
                            <Label FontFamily="Inter-Bold" FontSize="17" Text="{Binding StatusTitle}" TextColor="{Binding StatusColor}" />
                            <Label Style="{StaticResource MutedLabelStyle}" Text="{Binding StatusHint}" />
                            <Label IsVisible="{Binding HasNotice}" Style="{StaticResource CaptionLabelStyle}" Text="{Binding Notice}" TextColor="{StaticResource DoorOrange}" />
                        </VerticalStackLayout>
                    </components:DmCard>

                    <components:DmCard Margin="0">
                        <VerticalStackLayout Spacing="10">
                            <components:DmPrimaryButton
                                Clicked="OnPrimaryActionClicked"
                                HeightRequest="46"
                                Text="{Binding PrimaryActionLabel}" />
                            <components:DmSecondaryButton
                                Clicked="OnReopenProviderClicked"
                                HeightRequest="44"
                                IsVisible="{Binding ShowProviderAction}"
                                Text="{Binding ReopenProviderLabel}" />
                            <components:DmSecondaryButton
                                Clicked="OnOpenSupportClicked"
                                HeightRequest="44"
                                Text="{markup:Translate NeedSupportAction}" />
                            <components:DmSecondaryButton
                                Clicked="OnOpenOrderDetailsClicked"
                                HeightRequest="44"
                                Text="{markup:Translate PaymentReturnOpenOrderAction}" />
                            <components:DmSecondaryButton
                                Clicked="OnBackToOrdersClicked"
                                HeightRequest="44"
                                Text="{markup:Translate PaymentReturnBackToOrdersAction}" />
                        </VerticalStackLayout>
                    </components:DmCard>
                </VerticalStackLayout>
            </ScrollView>

            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Center" />
        </Grid>
    </Grid>
</local:LocalizedContentPage>
