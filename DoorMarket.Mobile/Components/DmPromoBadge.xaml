<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DoorMarket.Mobile.Components.DmPromoBadge"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Border
        BackgroundColor="{StaticResource DoorOrange}"
        Padding="8,2"
        StrokeThickness="0">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="8" />
        </Border.StrokeShape>
        <Label
            FontFamily="Inter-Bold"
            FontSize="11"
            Text="{Binding Text, Source={x:Reference Root}}"
            TextColor="White" />
    </Border>
</ContentView>
