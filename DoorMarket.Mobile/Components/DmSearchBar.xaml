<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DoorMarket.Mobile.Components.DmSearchBar"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:DoorMarket.Mobile.Controls"
    xmlns:models="clr-namespace:DoorMarket.Mobile.Models"
    x:Name="Root">

    <Border
        BackgroundColor="{AppThemeBinding Light={StaticResource DmInputBgLight}, Dark={StaticResource DmInputBgDark}}"
        Padding="12,0"
        Stroke="{AppThemeBinding Light={StaticResource DmBorderLight}, Dark={StaticResource DmBorderDark}}"
        StrokeThickness="1"
        HeightRequest="48">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
            <Label
                FontFamily="MaterialIcons"
                FontSize="20"
                Text="{x:Static models:MaterialIcons.Search}"
                TextColor="{AppThemeBinding Light={StaticResource DmTextSecondaryLight}, Dark={StaticResource DmTextSecondaryDark}}"
                VerticalOptions="Center" />

            <controls:BorderlessEntry
                Grid.Column="1"
                Style="{StaticResource InputEntryStyle}"
                Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
                ReturnType="{Binding ReturnType, Source={x:Reference Root}}"
                Text="{Binding Text, Source={x:Reference Root}, Mode=TwoWay}"
                Completed="OnEntryCompleted"
                TextChanged="OnEntryTextChanged" />
        </Grid>
    </Border>
</ContentView>

