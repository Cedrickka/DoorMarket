<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DoorMarket.Mobile.Components.DmChip"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Border
        Padding="12,8"
        BackgroundColor="{AppThemeBinding Light={StaticResource DmChipBgLight}, Dark={StaticResource DmChipBgDark}}"
        Stroke="{AppThemeBinding Light={StaticResource DmBorderLight}, Dark={StaticResource DmBorderDark}}"
        StrokeThickness="1">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>

        <Label
            FontFamily="Inter-Medium"
            FontSize="13"
            HorizontalTextAlignment="Center"
            Text="{Binding Text, Source={x:Reference Root}}"
            TextColor="{AppThemeBinding Light={StaticResource DmTextPrimaryLight}, Dark={StaticResource DmTextPrimaryDark}}"
            VerticalTextAlignment="Center" />
    </Border>
</ContentView>

