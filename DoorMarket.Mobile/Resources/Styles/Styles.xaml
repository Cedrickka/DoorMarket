<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:DoorMarket.Mobile.Components">

    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DmBgLight}, Dark={StaticResource DmBgDark}}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource DoorOrange}" />
    </Style>

    <Style x:Key="TopSurfaceGridStyle" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DmTopBarBgLight}, Dark={StaticResource DmTopBarBgDark}}" />
    </Style>

    <Style x:Key="BottomSurfaceGridStyle" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DmBottomBarBgLight}, Dark={StaticResource DmBottomBarBgDark}}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Inter-Regular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DmTextPrimaryLight}, Dark={StaticResource DmTextPrimaryDark}}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="Inter-Medium" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="H1LabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter-Bold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DmTextPrimaryLight}, Dark={StaticResource DmTextPrimaryDark}}" />
    </Style>

    <Style x:Key="H2LabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter-SemiBold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DmTextPrimaryLight}, Dark={StaticResource DmTextPrimaryDark}}" />
    </Style>

    <Style x:Key="H3LabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter-SemiBold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DmTextPrimaryLight}, Dark={StaticResource DmTextPrimaryDark}}" />
    </Style>

    <Style x:Key="SectionTitleLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter-SemiBold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DmTextPrimaryLight}, Dark={StaticResource DmTextPrimaryDark}}" />
    </Style>

    <Style x:Key="CaptionLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter-Medium" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DmTextMutedLight}, Dark={StaticResource DmTextMutedDark}}" />
    </Style>

    <Style x:Key="MetricValueLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter-Bold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DmTextPrimaryLight}, Dark={StaticResource DmTextPrimaryDark}}" />
    </Style>

    <Style x:Key="MetricLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter-Medium" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DmTextSecondaryLight}, Dark={StaticResource DmTextSecondaryDark}}" />
    </Style>

    <Style x:Key="MutedLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter-Regular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DmTextMutedLight}, Dark={StaticResource DmTextMutedDark}}" />
    </Style>

    <Style x:Key="InputEntryStyle" TargetType="Entry">
        <Setter Property="FontFamily" Value="Inter-Regular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DmTextPrimaryLight}, Dark={StaticResource DmTextPrimaryDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource DmTextMutedLight}, Dark={StaticResource DmTextMutedDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="Inter-Regular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DmTextPrimaryLight}, Dark={StaticResource DmTextPrimaryDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DmInputBgLight}, Dark={StaticResource DmInputBgDark}}" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource DoorOrange}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontFamily" Value="Inter-SemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="52" />
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DoorBlue}, Dark={StaticResource DmTextPrimaryDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource DoorBlue}, Dark={StaticResource DmBorderDark}}" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="FontFamily" Value="Inter-SemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="52" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource DmBorderLight}, Dark={StaticResource DmBorderDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource DmSurfaceLight}, Dark={StaticResource DmSurfaceDark}}" />
    </Style>

    <Style TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DmSurfaceLight}, Dark={StaticResource DmSurfaceDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource DmBorderLight}, Dark={StaticResource DmBorderDark}}" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <Style TargetType="ImageButton">
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DmSurfaceAltLight}, Dark={StaticResource DmSurfaceAltDark}}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Shell">
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource DmSurfaceLight}, Dark={StaticResource DmSurfaceDark}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource DoorOrange}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light={StaticResource DmTextMutedLight}, Dark={StaticResource DmTextMutedDark}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource DmTextSecondaryLight}, Dark={StaticResource DmTextSecondaryDark}}" />
        <Setter Property="Shell.TabBarDisabledColor" Value="{AppThemeBinding Light={StaticResource DmBorderLight}, Dark={StaticResource DmBorderDark}}" />
    </Style>

    <Style TargetType="components:DmPrimaryButton" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.55" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="components:DmSecondaryButton" BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.55" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="components:DmGhostButton" BasedOn="{StaticResource GhostButtonStyle}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.55" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="components:DmCard">
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="{AppThemeBinding Light={StaticResource DmShadowLight}, Dark={StaticResource DmShadowDark}}" Offset="0,8" Radius="18" Opacity="1" />
            </Setter.Value>
        </Setter>
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="ChipFrameStyle" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DmChipBgLight}, Dark={StaticResource DmChipBgDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource DmBorderLight}, Dark={StaticResource DmBorderDark}}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style x:Key="SummaryRowLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter-Medium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DmTextSecondaryLight}, Dark={StaticResource DmTextSecondaryDark}}" />
    </Style>

    <Style x:Key="SummaryValueLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter-SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DmTextPrimaryLight}, Dark={StaticResource DmTextPrimaryDark}}" />
    </Style>
</ResourceDictionary>

